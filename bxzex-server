#
# Starts the local model server that `bxzex-ai` talks to (127.0.0.1:8080).
# `bxzex-ai` runs this for you when the server isn't up; run it by hand to watch the log.
#
# Tuned on a 24GB M4 MacBook Air, where the model is GPU-bound: about 2 tok/s plain and
# 3.6-4.3 with MTP drafting, so drafting stays on. One slot and the cache caps keep a
# long chat from pushing the Mac into swap.
set -euo pipefail

BXZEX_HOME="${BXZEX_HOME:-$HOME/.bxzex-ai}"

# our own engine folder (Linux) comes first, then whatever is on the PATH (Homebrew on a Mac)
BIN="${BXZEX_SERVER_BIN:-$(find "$BXZEX_HOME/engine" -name llama-server -type f 2>/dev/null | head -1 || true)}"
[ -n "$BIN" ] || BIN="$(command -v llama-server || true)"
[ -n "$BIN" ] && [ -x "$BIN" ] || { echo "The chat engine is missing. Run the installer again." >&2; exit 1; }
export LD_LIBRARY_PATH="$(dirname "$BIN"):$BXZEX_HOME/engine:${LD_LIBRARY_PATH:-}"

MODEL="${BXZEX_MODEL:-$BXZEX_HOME/models/bxzex-model.gguf}"
[ -f "$MODEL" ] || { echo "model not found at $MODEL. Run install.sh, or set BXZEX_MODEL to a .gguf file." >&2; exit 1; }

# four fast cores on the Mac it was tuned on; elsewhere, the real cores (half of what the system counts)
THREADS=4
if [ "$(uname -s)" != Darwin ]; then THREADS=$(( $(nproc 2>/dev/null || echo 8) / 2 )); [ "$THREADS" -ge 4 ] || THREADS=4; fi
THREADS="${BXZEX_THREADS:-$THREADS}"

# graphics card by default; "cpu" (set with /device in the app, or BXZEX_DEVICE=cpu) keeps everything on the processor
DEVICE="${BXZEX_DEVICE:-$(sed -n 's/.*"device": *"\([a-z]*\)".*/\1/p' "$BXZEX_HOME/config.json" 2>/dev/null || true)}"
LAYERS=99
if [ "$DEVICE" = cpu ]; then LAYERS=0; fi

ARGS=(
  --model "$MODEL"
  --alias bxzex-uncensored
  --host 127.0.0.1 --port "${BXZEX_PORT:-8080}"
  --ctx-size "${BXZEX_CTX:-32768}"
  --n-gpu-layers "$LAYERS"
  --flash-attn on
  --cache-type-k q8_0 --cache-type-v q4_0
  --batch-size 2048 --ubatch-size 512
  --threads "$THREADS" --threads-batch "$THREADS"
  --parallel 1
  --ctx-checkpoints 8 --cache-ram 2048
  --spec-type "${SPEC:-draft-mtp}" --spec-draft-n-max 3 --spec-draft-p-min 0.4
  --temp 0.7 --top-k 20 --top-p 0.95 --min-p 0.0 --repeat-penalty 1.0
  --jinja --no-warmup
)

# The vision half. Without it the model is text-only.
VISION="$(dirname "$MODEL")/bxzex-vision.gguf"
[ -f "$VISION" ] && ARGS+=(--mmproj "$VISION")
if [ "$DEVICE" = cpu ] && [ -f "$VISION" ]; then ARGS+=(--no-mmproj-offload); fi

exec "$BIN" "${ARGS[@]}"
