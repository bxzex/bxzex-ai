def graphics():
    """What the installed chat engine can run on besides the processor. Empty when it is processor-only."""
    if MAC: return "the Mac's graphics chip"
    try: marks = [f for f in os.listdir(f"{APP_HOME}/engine") if f.startswith(".b")]
    except OSError: marks = []
    if any("cuda" in f for f in marks): return "the NVIDIA graphics card"
