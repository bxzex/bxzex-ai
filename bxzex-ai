def log_error(kind, err, tb):
    """Keep the details of a crash out of the conversation: they go to error.log, the screen gets one line."""
    import traceback
    try:
        os.makedirs(APP_HOME, exist_ok=True)
        with open(ERROR_LOG, "a") as f:
            f.write(f"--- {time.strftime('%Y-%m-%d %H:%M:%S')} v{VERSION}\n" + "".join(traceback.format_exception(kind, err, tb)))
    except OSError: pass
def _thread_error(a):                     # a loader or a background job failing must never spill over the screen
    if a.exc_type is not SystemExit: log_error(a.exc_type, a.exc_value, a.exc_traceback)
threading.excepthook = _thread_error
def _main_error(kind, err, tb):
    if issubclass(kind, KeyboardInterrupt): sys.stderr.write("\n"); return
    log_error(kind, err, tb)
    sys.stderr.write(f"\nbxzex-ai stopped: {kind.__name__}: {str(err)[:160]}\ndetails in {ERROR_LOG.replace(HOME, '~')}\n")
sys.excepthook = _main_error

class _RemoteKey(urllib.request.HTTPRedirectHandler):
    """Sends the key with requests to the remote model only, never to web pages the tools open.
    Also follows the 303 the cloud sends while a long request is still waiting for its card."""
    def http_request(self, req):
        if REMOTE_KEY and req.full_url.startswith(HOST): req.add_unredirected_header("Authorization", f"Bearer {REMOTE_KEY}")
        return req
    https_request = http_request
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        new = super().redirect_request(req, fp, code, msg, headers, newurl)
        if new is not None and code == 303 and req.data is not None and newurl.startswith(HOST):
            new = urllib.request.Request(newurl, req.data, dict(req.header_items()), method="POST")   # keep the request as it was
        return new
