    """Downscale to a jpeg so a screenshot doesn't cost minutes of image tokens."""
    tmp = tempfile.NamedTemporaryFile(suffix=".jpg", delete=False).name
    kind = "jpeg"
    try:
        shrunk = False
        for cmd in (["sips", "-s", "format", "jpeg", "-Z", "1024", path, "--out", tmp],                      # Mac
                    ["magick", path + "[0]", "-auto-orient", "-resize", "1024x1024>", "-background", "white", "-flatten", tmp],
                    ["convert", path + "[0]", "-auto-orient", "-resize", "1024x1024>", "-background", "white", "-flatten", tmp],
                    ["ffmpeg", "-loglevel", "error", "-y", "-i", path, "-frames:v", "1", "-vf",
                     "scale=1024:1024:force_original_aspect_ratio=decrease:force_divisible_by=2", tmp]):
            if shutil.which(cmd[0]) and subprocess.run(cmd, capture_output=True).returncode == 0 and os.path.getsize(tmp):
                shrunk = True; break
        if not shrunk:                            # no image tool on this system: the picture is sent as it is
            kind = {".png": "png", ".gif": "gif", ".webp": "webp", ".bmp": "bmp"}.get(os.path.splitext(path)[1].lower(), "jpeg")
        with open(tmp if shrunk else path, "rb") as f: b64 = base64.b64encode(f.read()).decode()
    finally:
        if os.path.exists(tmp): os.unlink(tmp)
    return {"type": "image_url", "image_url": {"url": f"data:image/{kind};base64,{b64}"}}

def split_images(text):
    """Pull image file paths (typed or dragged into the terminal) out of a message."""
    if WSL:                                       # a file dragged in from Windows arrives as C:\Users\...
        text = re.sub(r'"((?:[A-Za-z]:\\|\\\\wsl)[^"]+)"|\'((?:[A-Za-z]:\\|\\\\wsl)[^\']+)\'|((?:[A-Za-z]:\\|\\\\wsl)\S+)',
                      lambda m: shlex.quote(windows_path(m.group(1) or m.group(2) or m.group(3))), text)
    try: toks = shlex.split(text)
    except ValueError: return text, []
    imgs = [os.path.expanduser(t) for t in toks
            if t.lower().endswith(IMG_EXT) and os.path.isfile(os.path.expanduser(t))]
    if not imgs: return text, []
    rest = " ".join(t for t in toks if os.path.expanduser(t) not in imgs)
    return rest, imgs

def attach_files(text):
    """@path in a message attaches that file's text, the way dragging in an image shows the image."""
    extra = []
    for m in re.finditer(r"(?<!\S)@(\S+)", text):
        path = os.path.expanduser(m.group(1).rstrip(".,;:!?)"))
        if os.path.isfile(path) and not path.lower().endswith(IMG_EXT):
            try:
                body = read_file(path)
                extra.append(f"\n\n--- {path} ---\n{body}"); print(f"  {DIM}└ file {path.replace(HOME, '~')}{R}")
            except OSError: pass
    return text + "".join(extra)

SKILL_STOP = set("""a an and or the of to in on for with from by at as is are be it its this that these those your you my me we our
use using when what how into out up make making build building get set any all new one two more most own their them they can will
not no do does without about over than then so very just also only each every like such some via per""".split())

def skill_hint(text):
    """Name the skills whose description matches the request, so the right ones get loaded instead of skipped."""
    words = {w for w in re.findall(r"[a-z0-9]+", text.lower()) if len(w) > 2 and w not in SKILL_STOP}
    if len(words) < 3 or text.startswith(("(", "By the way")): return ""
    skills = [(name, {w for w in re.findall(r"[a-z0-9]+", (name.replace("-", " ") + " " + desc).lower()) if len(w) > 2 and w not in SKILL_STOP})
              for name, desc, _ in list_skills()]
    seen = {}
    for _, keys in skills:
        for w in keys: seen[w] = seen.get(w, 0) + 1
    scored = []
    for name, keys in skills:          # a word few skills use (pwa, remotion, stripe) says more than a common one (web, app)
        score = sum(2 if seen[w] <= 2 else 1 for w in words & keys) + 2 * len(words & set(name.split("-")))
        if score >= 2: scored.append((score, name))
    best = [n for _, n in sorted(scored, reverse=True)[:4]]
    return f"\n\n(Skills that may fit this: {', '.join(best)}. Load the ones that really do before you start.)" if best else ""

def user_message(text):
    hint = skill_hint(text)                          # kept apart so /rewind and /export show only what they typed
    text = attach_files(text)
    text, imgs = split_images(text)
    if not imgs: return {"role": "user", "content": text, **({"_hint": hint} if hint else {})}
    for p in imgs: print(f"  {DIM}└ image {p}{R}")
    return {"role": "user", "content": [{"type": "text", "text": text or "What is in this image?"}]
                                       + [image_part(p) for p in imgs], **({"_hint": hint} if hint else {})}

# ---- btw: keep typing while it works ----
import select, termios, tty

class TypeAhead:
    """Collects what you type while the model is busy. Enter queues the line as a note for it."""
    def __init__(self):
        self.buf = ""; self.notes = []; self.leftover = ""
        self.saved = None; self.th = None; self.stop_ev = threading.Event()
    def start(self):
        if self.th or not sys.stdin.isatty(): return
        self.fd = sys.stdin.fileno()
        try:
            self.saved = termios.tcgetattr(self.fd); tty.setcbreak(self.fd, termios.TCSANOW)   # no echo, keys arrive one by one, Ctrl-C still works
        except termios.error:
            self.saved = None; return
        self.stop_ev.clear()
        self.th = threading.Thread(target=self.run, daemon=True); self.th.start()
    def run(self):
        while not self.stop_ev.is_set():
            global resized
            ready, _, _ = select.select([self.fd], [], [], 0.1)
            if resized: resized = False; box.draw(self.buf, len(self.buf))
            if not ready: continue
            raw = finish_escapes(self.fd, os.read(self.fd, 64).decode("utf-8", "ignore"))
            if "\x1b" in ESC_KEY.sub("", raw):                  # Esc on its own (not an arrow or other key): stop, the same as ctrl-c
                os.kill(os.getpid(), signal.SIGINT); continue
            got = ESC_KEY.sub("", raw).replace("\x1b", "")       # arrows and other keys, not text
            for ch in got:
                if ch in "\r\n":
                    if self.buf.strip(): self.notes.append(self.buf.strip())
                    self.buf = ""
                elif ch in "\x7f\b": self.buf = self.buf[:-1]
                elif ch == "\x15": self.buf = ""
                elif ch >= " ": self.buf += ch
            box.draw(self.buf, len(self.buf))
    def stop(self):
        """Back to normal line input. Whatever was typed but not sent is kept in .leftover."""
        if not self.th: return
        self.stop_ev.set(); self.th.join(); self.th = None
        if self.saved: termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)
        self.leftover, self.buf = self.buf, ""
    def drain(self):
        notes, self.notes = self.notes, []
        return notes

typed = TypeAhead()

# ---- streaming ----
class Markdown:
    """Renders the model's streamed markdown as terminal styling, wrapped to the window
    with a hanging indent. Output is held back one word at a time so wrapping never splits a word."""
    def __init__(self, prefix="  "):
        self.prefix = prefix                               # start of the very first line, e.g. the reply bullet
        self.stars = self.ticks = self.hashes = 0          # pending runs, resolved by the next char
        self.bold = self.ital = self.code = self.fence = self.head = False
        self.bol = True       # only whitespace so far on this line
        self.col0 = True      # nothing printed on this line yet
        self.skip = False     # swallowing the rest of a ``` line
        self.eat_space = False
        self.bullet = False   # just printed a bullet: squeeze the spaces after it to one
        self.dash = False     # a "-" at the start of a line, waiting to see if it is a list item
        self.prev = "\n"
        self.col = 0
        self.word = []; self.word_w = 0; self.word_style = R
        self.codeline = ""    # the code line being written inside a ``` block, coloured when it ends
        self.tline = None     # the table row being collected, from its first |
        self.trows = []       # rows of a table, drawn as a grid once the table ends

    def style(self):
        s = R
        if self.fence or self.code: s += TEAL
        if self.bold or self.head: s += BOLD
        if self.ital: s += ITAL
        return s

    def hold(self, s, w):
        if not self.word: self.word_style = self.style()
        self.word.append(s); self.word_w += w

    def flush_word(self):
        if not self.word: return
        if self.col0 and not self.word_w:      # only style codes pending: nothing to put on this line yet
            self.word = []; return
        if self.col0:
            sys.stdout.write(self.prefix + self.word_style); self.prefix = "  "
            self.col0 = False; self.col = 2
        elif self.col + self.word_w > TW() and self.col > 2 and not self.fence:
            sys.stdout.write(f"{R}\n  {self.word_style}"); self.col = 2
        sys.stdout.write("".join(self.word)); self.col += self.word_w
        self.word = []; self.word_w = 0

    def out(self, s):
        self.hold(s, len(s))
        if s.strip(): self.bol = False
        self.prev = s[-1]

    def restyle(self):
        self.hold(self.style(), 0)

    def resolve(self, run, nxt):
        n = getattr(self, run); setattr(self, run, 0)
        if run == "ticks":
            if n >= 3 and not self.codeline.strip(): self.fence = not self.fence; self.skip = True
            elif self.fence: self.codeline += "`" * n; return
            else: self.code = not self.code
        elif run == "stars":
            if n >= 2: self.bold = not self.bold
            elif self.bol and nxt == " ": self.out("•"); self.bullet = True
            elif self.prev in " \n" and nxt in " \n": self.out("*")
            else: self.ital = not self.ital
        elif nxt == " ": self.head = True; self.eat_space = True
        else: self.out("#" * n)
        self.restyle()

    def newline(self):
        self.flush_word()
        self.bold = self.ital = self.code = self.head = False
        sys.stdout.write(R + "\n"); self.bol = self.col0 = True; self.prev = "\n"; self.col = 0
        self.word_style = self.style()

    def code_line(self):
        self.flush_word()
        sys.stdout.write((self.prefix if self.col0 else "") + ("" if self.col0 else "\n  ") + highlight(self.codeline) + R + "\n")
        self.prefix = "  "; self.codeline = ""
        self.bol = self.col0 = True; self.prev = "\n"; self.col = 0

    def table(self):
        """Draw the collected | rows as a grid that fits the window."""
        import textwrap
        rows = [[c.strip() for c in r.strip().strip("|").split("|")] for r in self.trows]
        self.trows = []
        rows = [r for r in rows if not all(re.fullmatch(r":?-{2,}:?", c) for c in r if c) or not any(r)]
        if not rows: return
        clean = lambda t: re.sub(r"\*\*|__|`", "", t)
        n = max(len(r) for r in rows); rows = [[clean(c) for c in r] + [""] * (n - len(r)) for r in rows]
        width = [max(3, max(len(r[i]) for r in rows)) for i in range(n)]
        room = TW() - 2 - (3 * n + 1)
        while sum(width) > room and max(width) > 8: width[width.index(max(width))] -= 1
        self.flush_word()
        if not self.col0: sys.stdout.write("\n")
        elif self.prefix.strip(): sys.stdout.write(self.prefix.rstrip() + "\n")
        line = lambda l, m, r: f"  {DIM}{l}" + m.join("─" * (w + 2) for w in width) + f"{r}{R}\n"
        out = [line("┌", "┬", "┐")]
        for k, r in enumerate(rows):
            cells = [textwrap.wrap(c, w) or [""] for c, w in zip(r, width)]
            for j in range(max(len(c) for c in cells)):
                parts = [(c[j] if j < len(c) else "").ljust(w) for c, w in zip(cells, width)]
                out.append(f"  {DIM}│{R} " + f" {DIM}│{R} ".join((BOLD + x + R) if k == 0 else x for x in parts) + f" {DIM}│{R}\n")
            if k == 0 and len(rows) > 1: out.append(line("├", "┼", "┤"))
        out.append(line("└", "┴", "┘"))
        sys.stdout.write("".join(out))
        self.prefix = "  "; self.bol = self.col0 = True; self.prev = "\n"; self.col = 0

    def char(self, ch):
        if not self.fence:
            if self.tline is not None:                     # inside a table row
                if ch == "\n": self.trows.append(self.tline); self.tline = None
                else: self.tline += ch
                return
            if self.trows:
                if ch == "|" : self.tline = "|"; return     # the next row of the same table
                if ch in " \t" : return
                self.table()
            if ch == "|" and self.bol and self.col0 and not self.word and not (self.stars or self.ticks or self.hashes or self.dash):
                self.tline = "|"; return
        run = {"*": "stars", "`": "ticks", "#": "hashes"}.get(ch)
        if run == "hashes" and not (self.bol and not self.fence and not self.code): run = None
        if run == "stars" and (self.fence or self.code): run = None
        for r in ("stars", "ticks", "hashes"):
            if r != run and getattr(self, r): self.resolve(r, ch)
        if self.skip:
            if ch == "\n":
                self.flush_word(); self.skip = False; self.bol = self.col0 = True; self.prev = "\n"; self.col = 0
                self.word_style = self.style()
            return
        if run: setattr(self, run, getattr(self, run) + 1); return
        if self.fence:                                     # code: kept as written, coloured a line at a time
            if ch == "\n": self.code_line()
            else: self.codeline += ch
            return
        if self.dash:
            self.dash = False
            if ch == " ": self.out("•"); self.bullet = True
            else: self.out("-")
        elif ch == "-" and self.bol and not self.fence and not self.code:
            self.dash = True; return
        if self.eat_space and ch == " ": self.eat_space = False; return
        self.eat_space = False
        if self.bullet and ch == " " and self.prev == " ": return
        if ch != " ": self.bullet = False
        if ch == "\n": self.newline(); return
        if ch == " " and not self.bol and not self.fence:   # a word just ended: decide where it goes
            self.flush_word()
            if self.col < TW(): sys.stdout.write(" "); self.col += 1
            self.prev = " "
            return
        self.out(ch)

    def feed(self, text):
        for ch in text: self.char(ch)
        sys.stdout.flush()

    def close(self):
        if self.tline is not None: self.trows.append(self.tline); self.tline = None
        if self.trows: self.table()
        for r in ("stars", "ticks", "hashes"):
            if getattr(self, r): self.resolve(r, "\n")
        if self.codeline: self.code_line()
        if self.dash: self.out("-")
        self.flush_word()
        sys.stdout.write(R)

CODE_WORDS = set("""def class return if elif else for while in not and or import from as with try except finally raise lambda yield await async
    function const let var new this export default switch case break continue do typeof instanceof null undefined true false True False None
    fn pub impl struct enum match use mod mut self static void int float bool string public private protected interface type package func go
    select insert update delete where join create table values echo then fi done esac local""".split())

def highlight(line):
    """Code colours that work for most languages: keywords, strings, numbers and comments."""
    out = []
    for m in re.finditer(r'(?P<c>(?:#|//|--(?=\s)).*$)|(?P<s>"(?:\\.|[^"\\])*"?|\'(?:\\.|[^\'\\])*\'?|`[^`]*`?)|(?P<n>\b\d+(?:\.\d+)?\b)|(?P<w>[A-Za-z_][A-Za-z0-9_]*)|(?P<o>.)', line):
        t = m.group(0)
        if m.group("c"): out.append(f"{c(244)}{ITAL}{t}{R}")
        elif m.group("s"): out.append(f"{c(150)}{t}{R}")
        elif m.group("n"): out.append(f"{c(180)}{t}{R}")
        elif m.group("w") and t in CODE_WORDS: out.append(f"{GOLD}{BOLD}{t}{R}")
        else: out.append(f"{c(252)}{t}{R}")
    return "".join(out)

class Waiting:
    """One-line status shown while it loads, reads or thinks: flames, what it's doing, how long, how many tokens."""
    def __init__(self, label):
        self.label = label; self.tok = 0
        self.preview = ""     # tail of what is being written right now, e.g. the file a tool call is producing
        self.stop_ev = threading.Event(); self.t0 = time.time()
        self.th = threading.Thread(target=self.run, daemon=True); self.th.start()
    def run(self):
        while not self.stop_ev.wait(0.07):
            el = time.time() - self.t0; w = W()
            tok = f" · ↓ {self.tok} tok" if self.tok else ""
            info = f"({fmt(el)}{tok} · esc to stop)"
            used = 2 + len(self.label) + 2 + len(info)
            ride = flame(el) + " " if w > used + 16 else ""
            if ride: used += 13
            room = w - used - 6
            if self.preview and room > 12:
                tail = re.sub(r"\\[nt]|\s+", " ", self.preview).replace('\\"', '"')[-room:]
                note = f"   {DIM}{tail}{R}"
            else: note = ""
            line = f"\r\033[K{ride}{GOLD}{self.label}…{R} {DIM}{info}{R}{note}"
            RAW.write(line if w > used else f"\r\033[K{GOLD}{self.label[:max(4, w - 4)]}…{R}")
            RAW.flush()
    def stop(self):
        if self.stop_ev.is_set(): return
        self.stop_ev.set(); self.th.join()
        RAW.write("\r\033[K"); RAW.flush()

# ---- long conversations ----
# The model can only hold so much at once. Before a chat outgrows that, the older part is folded into a
# short summary written by the model itself and the newest messages are kept word for word.
ctx_size = 0          # what the running model can hold, asked from the server once
tok_per_char = 0.3    # corrected from what the server reports after each reply

def context_size():
    global ctx_size
    if not ctx_size:
        try:
            with urllib.request.urlopen(f"{HOST}/props", timeout=3) as r:
                ctx_size = min(int(json.load(r)["default_generation_settings"]["n_ctx"]), 65536)   # the card's pool is shared with helpers
        except Exception:
            return int(os.environ.get("BXZEX_CTX") or 32768)
    return ctx_size

def reply_room(): return min(12000 if REMOTE else 4096, context_size() // 4)   # the cloud card has room for long scripts

REPEAT = ("You already made this exact call twice in a row with nothing changed in between, so it was not run again. Use the result you "
          "already have: change the approach, or stop and tell the user where things stand.")

CUT_OFF = ("That call was cut off at the reply length limit, so it never ran. Write long scripts in smaller pieces: "
           "save the script with write_file first, then run it with a short run_shell command.")

def circling(calls):
    """True when the last calls are one short pattern (1 to 3 calls) repeated three times in a row, unchanged.
    Editing a script and running it again is not a circle: the edit differs each time."""
    for n in (1, 2, 3):
        if len(calls) >= 3 * n and calls[-n:] == calls[-2 * n:-n] == calls[-3 * n:-2 * n]: return True
    return False

def whole(call):
    """True when a tool call's arguments are complete JSON. A reply that runs out of room leaves them cut off."""
    try: json.loads(call["function"].get("arguments") or "{}"); return True
    except ValueError: return False

def mend(msgs):
    """Replaces cut-off tool calls with empty ones, since the server refuses the whole chat when one is broken.
    Also leaves out the app's own notes on a message (keys starting with _), which the server doesn't need."""
    out = []
    for m in msgs:
        if m.get("_hint"):                       # the skills that fit, added for the model only
            c = m.get("content")
            m = dict(m, content=c + m["_hint"] if isinstance(c, str) else
                     [dict(p, text=p["text"] + m["_hint"]) if i == 0 and p.get("type") == "text" else p for i, p in enumerate(c or [])])
        if any(k.startswith("_") for k in m): m = {k: v for k, v in m.items() if not k.startswith("_")}
        if m.get("tool_calls") and not all(whole(c) for c in m["tool_calls"]):
            m = dict(m, tool_calls=[c if whole(c) else dict(c, function=dict(c["function"], arguments="{}")) for c in m["tool_calls"]])
        out.append(m)
    return out

def chars_in(messages):
    n = 0
    for m in messages:
        c = m.get("content") or ""
        n += 12 + (len(c) if isinstance(c, str) else sum(len(p.get("text", "")) if p.get("type") == "text" else 3000 for p in c))
        for call in m.get("tool_calls") or []: n += 30 + len(call["function"]["name"]) + len(call["function"]["arguments"])
    return n

FIXED_CHARS = 0
def estimate(messages):
    """Roughly how many tokens a request with these messages will be."""
    global FIXED_CHARS
    FIXED_CHARS = len(SYSTEM) + len(json.dumps(TOOLS))
    return int((FIXED_CHARS + chars_in(messages)) * tok_per_char)

def summarize(old):
    """Have the model write up the older part of the conversation. Returns the summary, or '' if it could not."""
    room = context_size() - 1000
    msgs = [dict(m) for m in old]
    for m in msgs:                                    # too big to even re-read: shorten long tool results first
        if estimate(msgs) <= room: break
        if m["role"] == "tool" and len(m["content"]) > 400: m["content"] = m["content"][:300] + "\n[...shortened]"
    while len(msgs) > 2 and estimate(msgs) > room:    # then let go of the very oldest messages
        del msgs[0]
        while msgs and msgs[0]["role"] != "user": del msgs[0]
    ask = ("Before we go on, write a summary of this conversation so far, for your own use later. Cover what I asked for "
           "and why, what you did and found, what was decided, the exact names, numbers, file paths and links that matter, "
           "and anything still unfinished. Plain text, under 300 words. Do not call a tool.")
    body = json.dumps({"model": loaded_model(), "messages": [{"role": "system", "content": SYSTEM}] + mend(msgs) + [{"role": "user", "content": ask}],
                       "tools": TOOLS, "max_tokens": min(700, reply_room()), "temperature": 0.3,
                       "chat_template_kwargs": {"enable_thinking": False}}).encode()
    try:
        req = urllib.request.Request(f"{HOST}/v1/chat/completions", body, {"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=1800) as r:
            return (json.load(r)["choices"][0]["message"].get("content") or "").strip()
    except KeyboardInterrupt: raise
    except Exception:
        return ""

SUMMARY_HEAD = "Summary of our conversation so far"

def fold(history, force=False, everything=False):
    """Make room when the conversation is close to what the model can hold. Changes history in place.
    Returns True if anything was folded."""
    size = context_size()
    budget = size - reply_room() - min(2000, size // 8)
    if force: budget = int(budget * 0.6)
    if everything: budget = 0                         # /compact: fold whatever is older than the last exchange
    if estimate(history) <= budget: return False
    users = [i for i, m in enumerate(history) if m["role"] == "user"]
    cut = users[-1] if users else 0                   # the current request and everything after it always stays
    for i in reversed(users[:-1]):                    # plus as many earlier exchanges as fit in a tenth of the room
        if chars_in(history[i:]) * tok_per_char > max(600, size // 10): break
        cut = i
    changed = False
    folded = history and str(history[0].get("content", "")).startswith(SUMMARY_HEAD)
    if cut >= 2 and not (folded and cut <= 2):        # only the earlier summary is older: nothing new to fold, just trim below
        sys.stdout.write("\033[?25l")
        wait = Waiting("Tidying up a long conversation")
        try: summary = summarize(history[:cut])
        finally: wait.stop(); sys.stdout.write("\033[?25h"); sys.stdout.flush()
        note = SUMMARY_HEAD + " (the older messages were folded into this to save room):\n" + \
               (summary or "(it could not be summarized, so the earliest part was dropped)")
        history[:] = [{"role": "user", "content": note}, {"role": "assistant", "content": "Understood. I have that."}] + history[cut:]
        print(f"{DIM}{'the older part of this chat was folded into a summary' if everything else 'this chat got long, so the older part was folded into a summary to make room'}{R}\n")
        changed = True
    for m in history[:-6]:                            # still too big: shorten the oldest results, never the last few steps it is working from
        if estimate(history) <= budget: break
        if m["role"] == "tool" and len(m["content"]) > 600:
            m["content"] = m["content"][:500] + "\n[...shortened to save room]"; changed = True
        for c in m.get("tool_calls") or []:            # a whole file it wrote earlier: keep the call, drop the bulk
            if len(c["function"].get("arguments") or "") > 1500 and whole(c):
                args = json.loads(c["function"]["arguments"])
                args = {k: (v[:300] + "\n[...shortened to save room]" if isinstance(v, str) and len(v) > 400 else v) for k, v in args.items()} if isinstance(args, dict) else args
                c["function"]["arguments"] = json.dumps(args); changed = True
    return changed

turn_tok = 0   # tokens generated in the current turn, for the summary line
stream_error = ""   # set when the server reports a failure instead of an answer
DOING = {"update_todos": "Planning", "ask_user": "Writing a question", "delegate": "Briefing a helper",
         "generate_image": "Writing the image prompt", "write_file": "Writing file", "edit_file": "Editing file",
         "list_files": "Looking through files", "search_files": "Searching files", "run_shell": "Writing command", "web_search": "Searching", "fetch_page": "Opening page",
         "read_file": "Opening file", "use_skill": "Loading skill", "remember": "Saving to memory", "schedule_task": "Scheduling", "test_page": "Setting up the check"}

def lines(resp):
    """The reply's lines, ending quietly if the connection drops halfway (what arrived is kept)."""
    global stream_error
    try:
        for raw in resp: yield raw
    except (OSError, http.client.HTTPException, ValueError) as e:
        stream_error = f"the connection dropped ({e.__class__.__name__})"

def stream(messages, label="Reading"):
    """One model call. Returns (answer text, tool calls)."""
    model = MODEL_ID if awake() else loaded_model()
    if not model:
        print(f"{DIM}the model server isn't running. Relaunch bxzex-ai{R}"); return "", []
    body = json.dumps({"model": model, "messages": [{"role": "system", "content": SYSTEM}] + mend(messages),
                       "tools": TOOLS, "max_tokens": reply_room(), "temperature": 0.7, "stream": True,
                       "stream_options": {"include_usage": True},
                       "chat_template_kwargs": {"enable_thinking": not fast}}).encode()
    req = urllib.request.Request(f"{HOST}/v1/chat/completions", body, {"Content-Type":"application/json"})
    sys.stdout.write("\033[?25l")  # hide cursor while generating
    wait = Waiting(label)
    global turn_tok, stream_error, tok_per_char
    stream_error = ""
    sent_chars = FIXED_CHARS + chars_in(messages) if estimate(messages) else 0
    plain_text = all(isinstance(m.get("content") or "", str) for m in messages)
    answer=[]; calls={}; phase=None; tn=0; at_start=True; off=random.randrange(len(WORDS)); t0=time.time()

    md = Markdown(prefix=f"{GOLD}●{R} ")

    try:
        try:
            resp = urllib.request.urlopen(req, timeout=1800)
        except urllib.error.HTTPError as e:          # run_turn decides what to do: make room, restart, or give up
            body = e.read().decode('utf-8', 'ignore')
            try: body = json.loads(body)["error"]["message"]          # just the message, not the whole JSON reply
            except Exception: pass
            wait.stop(); stream_error = f"server error {e.code}: {' '.join(str(body).split())[:200]}"; return "", []
        except Exception as e:                       # couldn't reach it (a network blip, the card restarting): run_turn retries once
            wait.stop(); stream_error = f"couldn't reach the model ({getattr(e, 'reason', e)})"; return "", []

        for raw in lines(resp):
            line = raw.decode("utf-8","ignore").strip()
            if not line.startswith("data:"): continue
            p = line[5:].strip()
            if p=="[DONE]": break
            try: event = json.loads(p)
            except Exception: continue
            if "error" in event:                       # the server gave up on this request
                err = event["error"]
                stream_error = err.get("message", "error") if isinstance(err, dict) else str(err)
                break
            used = (event.get("usage") or {}).get("prompt_tokens")
            if used and plain_text and sent_chars: tok_per_char = max(0.2, min(0.6, used / sent_chars))
            try: delta = event["choices"][0]["delta"]
            except Exception: continue

            if delta.get("tool_calls") or delta.get("content") or delta.get("reasoning_content"): turn_tok += 1
            for tc in delta.get("tool_calls") or []:
                if wait.stop_ev.is_set():                  # it said something first: bring the status line back while it writes the call
                    if phase == "answer":
                        md.flush_word(); sys.stdout.write(R + ("" if md.col0 else "\n"))
                    sys.stdout.flush()
                    wait = Waiting("Working"); wait.tok = tn
                wait.tok += 1
                slot = calls.setdefault(tc.get("index", 0), {"id": "", "type": "function",
                                                             "function": {"name": "", "arguments": ""}})
                if tc.get("id"): slot["id"] = tc["id"]
                f = tc.get("function") or {}
                if f.get("name") and not slot["function"]["name"]: slot["function"]["name"] = f["name"]
                if f.get("arguments"): slot["function"]["arguments"] += f["arguments"]
                wait.label = DOING.get(slot["function"]["name"], "Working")
                wait.preview = slot["function"]["arguments"][-200:]

            think = delta.get("reasoning_content")
            if think:
                tn += 1
                if show_think:
                    wait.stop()
                    if phase!="think":
                        print(header("Thinking")); phase="think"; at_start=True
                    for ch in think:
                        if at_start: sys.stdout.write(f"  {DIM}{ITAL}"); at_start=False
                        sys.stdout.write(ch)
                        if ch=="\n": sys.stdout.write(R); at_start=True
                    sys.stdout.flush()
                else:   # keep the loader running, just relabel it
                    word = WORDS[(off + int((time.time()-t0)/1.8)) % len(WORDS)]
                    wait.label = word; wait.tok = tn

            content = delta.get("content")
            if content:
                wait.stop()
                if phase=="think":
                    sys.stdout.write(f"{R}\n\n"); phase=None
                if phase!="answer":
                    phase="answer"; at_start=True
                md.feed(content); answer.append(content)
    finally:
        wait.stop(); md.close()
        if phase=="answer" and not md.col0: sys.stdout.write("\n")
        elif phase!="answer": sys.stdout.write(f"{R}\r\033[K")
        sys.stdout.write("\033[?25h")  # restore cursor
        sys.stdout.flush()
    global last_ok
    if not stream_error: last_ok = time.time()
    else: last_ok = 0
    return "".join(answer).strip(), [calls[i] for i in sorted(calls)]

def run_turn(history):
    """Agent loop: keep calling the model until it answers without asking for a tool.
    Anything typed and sent while it works is passed to it as a "by the way" note."""
    if not ensure_server(): return      # e.g. still reloading after an image
    typed.start()
    try:
        global turn_tok
        turn_tok = 0; began = time.time(); retried = made_room = False; recent = []
        label = "Reading"
        for _ in range(MAX_STEPS):
            if fold(history): label = "Reading"
            text, calls = stream(history, label)
            if stream_error and not text and not calls:
                if not made_room and re.search(r"context|exceed|too (long|large|many)", stream_error, re.I):
                    made_room = True                 # it was fuller than estimated: fold harder and ask again
                    if fold(history, force=True): continue
                if retried:
                    print(f"{DIM}the model failed: {stream_error} Try again, or quit and relaunch.{R}"); return
                retried = True                   # usually the graphics memory got into a bad state: a fresh start clears it
                print(f"{DIM}the model hit an error ({stream_error.rstrip('.')}), {'trying again' if REMOTE else 'restarting it'}{R}")
                stop_server()
                if not ensure_server(): return
                continue
            if stream_error and (text or calls): print(f"{DIM}{stream_error}, so this reply may be cut short{R}")
            if calls:
                if text: print()
                history.append({"role": "assistant", "content": text, "tool_calls": calls})
                for i, call in enumerate(calls): call["id"] = call["id"] or f"call_{len(history)}_{i}"
                asked = [x for x in calls if x["function"]["name"] == "delegate" and whole(x)]
                helped = run_helpers(asked) if asked and REMOTE else {}
                for i, call in enumerate(calls):
                    if call["id"] in helped:
                        history.append({"role": "tool", "tool_call_id": call["id"], "content": helped[call["id"]]}); continue
                    recent.append((call["function"]["name"], call["function"].get("arguments")))
                    if circling(recent):                   # the same call, or the same few, a third time in a row
                        history.append({"role": "tool", "tool_call_id": call["id"], "content": REPEAT})
                        print(f"  {DIM}└ skipped: the same call a third time{R}"); continue
                    history.append({"role": "tool", "tool_call_id": call["id"], "content": run_tool(call) if whole(call) else CUT_OFF})
                if PENDING_SHOTS:                          # screenshots from test_page, for it to look at
                    parts = [{"type": "text", "text": "(Screenshots from test_page: " + ", ".join(d for d, _ in PENDING_SHOTS) + ", in that order.)"}]
                    for _, shot in PENDING_SHOTS:
                        try: parts.append(image_part(shot))
                        except OSError: pass
                    PENDING_SHOTS.clear()
                    history.append({"role": "user", "content": parts})
                label = "Reading results"
            else:
                history.append({"role": "assistant", "content": text})
            notes = typed.drain()
            if notes:
                print()
                for n in notes: print(f"{GOLD}❯{R} {DIM}btw{R} {n}")
                print()
                history.append({"role": "user", "content": "By the way: " + " ".join(notes)})
                label = "Reading"
            elif not calls:
                if speak and text: say_aloud(text)
                took = time.time() - began
                got = len(learned); learned.clear()
                note = f"remembered {got} new thing{'s' if got > 1 else ''} about you (/memory)" if got else ""
                if sys.stdout.isatty() and took >= 1: print(f"\n{DIM}≈ done in {fmt(took)} · {turn_tok} tok{' · ' + note if note else ''}{R}")
                elif note: print(f"\n{DIM}≈ {note}{R}")
                if took >= 30: ping_if_away("done: " + " ".join(re.sub(r"[*#`>|_]", "", text or "finished").split())[:160])
                hooks_done(text or "", took)
                return
        print(f"{DIM}paused after {MAX_STEPS} tool steps · type continue to keep going{R}")
    finally:
        typed.stop()

