# ---- /cost: what the cloud card has cost, from Modal's own billing ----
def show_cost(arg=""):
    conf = load_config().get("cost") or {}
    if not REMOTE: print(f"{DIM}this computer runs the model itself, so there's no cloud bill{R}"); return
    if not shutil.which("modal") or not conf.get("app"):
        print(f"{DIM}/cost needs the modal command and, in {CONFIG.replace(HOME, '~')}: \"cost\": {{\"app\": \"<your Modal app>\", \"profile\": \"<your Modal profile>\"}}{R}"); return
    env = dict(os.environ, **({"MODAL_PROFILE": conf["profile"]} if conf.get("profile") else {}))
    def modal(*a):
        r = subprocess.run(["modal", "billing", *a, "--json"], capture_output=True, text=True, env=env, timeout=90, stdin=subprocess.DEVNULL)
        return json.loads(r.stdout)
    sys.stdout.write("\033[?25l"); wait = Waiting("Asking Modal for the bill")
    try:
        today = modal("report", "--for", "today", "-r", "h", "--tz", "local")
        month = modal("report", "--for", "this month")
        last = modal("report", "--for", "last month")
        summary = modal("summary")
    except Exception as e:
        wait.stop(); sys.stdout.write("\033[?25h"); print(f"{DIM}couldn't get the bill from Modal: {e}{R}"); return
    wait.stop(); sys.stdout.write("\033[?25h")
    mine = lambda rows: sum(float(r["cost"]) for r in rows if r.get("description") == conf["app"])
    hours = sum(1 for r in today if r.get("description") == conf["app"] and float(r["cost"]) > 0.05)
    d = datetime.date.today(); days_in = (d.replace(month=d.month % 12 + 1, day=1, year=d.year + (d.month == 12)) - datetime.timedelta(days=1)).day
    print(header("Cloud card cost"))
    print(f"  {GOLD}today{R}        ${mine(today):.2f}  {DIM}awake in {hours} hour{'s' if hours != 1 else ''} of today{R}")
    week = [r for r in month if r.get("description") == conf["app"] and r.get("interval_start", "")[:10] >= str(d - datetime.timedelta(days=7))]
    per_day = (sum(float(r["cost"]) for r in week) + mine(today)) / 8          # the last 7 full days and today
    print(f"  {GOLD}this month{R}   ${mine(month):.2f}  {DIM}at this week's pace, about ${mine(month) + per_day * (days_in - d.day):.0f} by the end of the month{R}")
    print(f"  {GOLD}last month{R}   ${mine(last):.2f}")
    w = load_config().get("warm") or {}
    if w: print(f"  {DIM}/warm is on {w.get('from')}:00 to {w.get('to')}:00, which adds about ${4 * (w.get('to', 0) - w.get('from', 0))} a day{R}")
    print(f"  {DIM}whole Modal account this month: ${float(summary.get('metered_cost', 0)):.2f} used, ${float(summary.get('billed_cost', 0)):.2f} billed after credits{R}")

