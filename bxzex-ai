def car(el, n=26, speed=12):
    """A one-line DeLorean driving back and forth, leaving a trail."""
    body_r = [("∴", 1), ("≈", 2), ("▄", 3), ("▟", 4), ("█", 4), ("█", 4), ("▙", 4), ("▃", 5)]   # nose on the right
    body_l = [("▃", 5), ("▟", 4), ("█", 4), ("█", 4), ("▙", 4), ("▄", 3), ("≈", 2), ("∴", 1)]   # nose on the left
    span = n - len(body_r)
    step = int(el * speed) % (2 * span)
    right = step < span
    p = step if right else 2 * span - step
    tone = {1: T[2], 2: T[3], 3: T[3], 4: T[4], 5: HI}
    cells = [f"{c(T[1])}─"] * n
    for i, (ch, t) in enumerate(body_r if right else body_l):
        cells[p + i] = f"{c(tone[t])}{ch}"
    return "".join(cells) + R

