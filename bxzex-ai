def system_name():
    """What this computer runs, in a few words, so the assistant uses the right commands."""
    if MAC: return "macOS"
    name = "Linux"
    try:
        with open("/etc/os-release") as f:
            m = re.search(r'(?m)^PRETTY_NAME="?([^"\n]+)', f.read())
        if m: name = m.group(1).strip()
    except OSError: pass
    return f"Windows, inside WSL ({name}). Windows drives are under /mnt, like /mnt/c" if WSL else name

def windows_path(p):
    """A Windows path such as C:\\Users\\me\\a.png as the path WSL sees it."""
    m = re.match(r"\\\\wsl(?:\.localhost|\$)\\[^\\]+(\\.*)", p)
    if m: return m.group(1).replace("\\", "/")
    m = re.match(r"([A-Za-z]):[\\/](.*)", p)
    return f"/mnt/{m.group(1).lower()}/" + m.group(2).replace("\\", "/") if m else p

class Screen:
    """Everything printed goes through here and is remembered, so the conversation can be redrawn
    cleanly when the window is resized. Spinner frames and the input box bypass it via RAW."""
    def __init__(self, real):
        self.real = real; self.log = []; self.size = 0; self.lock = threading.RLock()
    def write(self, text):
        with self.lock:
            self.real.write(text)
            self.log.append(text); self.size += len(text)
            while self.size > 300000 and len(self.log) > 1: self.size -= len(self.log.pop(0))
    def replay(self): return "".join(self.log)
    def flush(self): self.real.flush()
    def isatty(self): return self.real.isatty()
    def fileno(self): return self.real.fileno()
    def __getattr__(self, name): return getattr(self.real, name)

