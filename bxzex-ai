def png_pixels(path):
    """Read a plain 8-bit PNG with nothing but the standard library. Returns (width, height, bytes per pixel, rows)."""
    import struct, zlib
    with open(path, "rb") as f: d = f.read()
    if d[:8] != b"\x89PNG\r\n\x1a\n": raise ValueError("not a png")
    i = 8; raw = b""; w = h = bpp = 0
    while i < len(d):
        n, kind = struct.unpack(">I4s", d[i:i + 8]); body = d[i + 8:i + 8 + n]; i += 12 + n
        if kind == b"IHDR":
            w, h, depth, color, _, _, lace = struct.unpack(">IIBBBBB", body)
            if depth != 8 or lace or color not in (0, 2, 4, 6): raise ValueError("unsupported png")
            bpp = {0: 1, 2: 3, 4: 2, 6: 4}[color]
        elif kind == b"IDAT": raw += body
    raw = zlib.decompress(raw); stride = w * bpp; rows = []; prev = bytearray(stride)
    for y in range(h):
        kind = raw[y * (stride + 1)]; line = bytearray(raw[y * (stride + 1) + 1:(y + 1) * (stride + 1)])
        if kind == 1:
            for x in range(bpp, stride): line[x] = (line[x] + line[x - bpp]) & 255
        elif kind == 2:
            for x in range(stride): line[x] = (line[x] + prev[x]) & 255
        elif kind == 3:
            for x in range(stride): line[x] = (line[x] + ((line[x - bpp] if x >= bpp else 0) + prev[x]) // 2) & 255
        elif kind == 4:
            for x in range(stride):
                a = line[x - bpp] if x >= bpp else 0; b = prev[x]; c2 = prev[x - bpp] if x >= bpp else 0
                pa = abs(b - c2); pb = abs(a - c2); pc = abs(a + b - 2 * c2)
                line[x] = (line[x] + (a if pa <= pb and pa <= pc else b if pb <= pc else c2)) & 255
        rows.append(line); prev = line
    return w, h, bpp, rows

def preview_png(path, cols):
    """The same half-block picture, for systems without the Mac image tool."""
    try:
        iw, ih, bpp, rows = png_pixels(path)
        w = min(cols, W() - 4); h = max(2, round(w * ih / iw) // 2 * 2)
        def px(x, y):
            line = rows[min(ih - 1, int((y + 0.5) * ih / h))]; i = min(iw - 1, int((x + 0.5) * iw / w)) * bpp
            r, g, b = (line[i], line[i + 1], line[i + 2]) if bpp >= 3 else (line[i],) * 3
            return 16 + 36 * round(r / 51) + 6 * round(g / 51) + round(b / 51)
        return ["".join(f"\033[38;5;{px(x, y)};48;5;{px(x, y + 1)}m▀" for x in range(w)) + R for y in range(0, h - 1, 2)]
    except Exception:
        return []

def preview(path, cols=44):
    """A small picture of the image drawn with half-block characters, so it shows up right in the chat."""
    if not shutil.which("sips"): return preview_png(path, cols)
    tmp = tempfile.NamedTemporaryFile(suffix=".bmp", delete=False).name
    try:
        info = subprocess.run(["sips", "-g", "pixelWidth", "-g", "pixelHeight", path], capture_output=True, text=True).stdout
        m = re.findall(r"pixel(?:Width|Height): (\d+)", info)
        if len(m) != 2: return []
        w = min(cols, W() - 4); h = max(2, round(w * int(m[1]) / int(m[0])) // 2 * 2)
        if subprocess.run(["sips", "-s", "format", "bmp", "-z", str(h), str(w), path, "--out", tmp], capture_output=True).returncode: return []
        with open(tmp, "rb") as f: d = f.read()
        off = int.from_bytes(d[10:14], "little"); bw = int.from_bytes(d[18:22], "little", signed=True)
        bh = int.from_bytes(d[22:26], "little", signed=True); bpp = int.from_bytes(d[28:30], "little") // 8
        stride = (bw * bpp + 3) // 4 * 4
        def px(x, y):
            row = (abs(bh) - 1 - y) if bh > 0 else y            # most bitmaps are stored bottom row first
            i = off + row * stride + x * bpp
            b, g, r = d[i], d[i + 1], d[i + 2]
            return 16 + 36 * round(r / 51) + 6 * round(g / 51) + round(b / 51)
        return ["".join(f"\033[38;5;{px(x, y)};48;5;{px(x, y + 1)}m▀" for x in range(bw)) + R for y in range(0, abs(bh) - 1, 2)]
    except Exception:
        return []
    finally:
        if os.path.exists(tmp): os.unlink(tmp)

PAINTING = f"{APP_HOME}/painting.lock"   # exists while an image is being made, so nothing reloads the chat model under it

def painting():
    try: return time.time() - os.path.getmtime(PAINTING) < 1200
    except OSError: return False

def stop_server():
    """Free the chat model's memory. The image model needs it: both do not fit in 24GB together."""
    if REMOTE: return                         # the model is on the cloud card, nothing to free here
    port = HOST.rsplit(":", 1)[1]
    if shutil.which("lsof"):
        pids = [int(x) for x in subprocess.run(["lsof", "-ti", f"tcp:{port}", "-sTCP:LISTEN"], capture_output=True, text=True).stdout.split() if x.isdigit()]
    else:                                     # Linux without lsof: look through the process list ourselves
        pids = []
        for name in os.listdir("/proc") if os.path.isdir("/proc") else []:
            if not name.isdigit(): continue
            try:
                with open(f"/proc/{name}/cmdline", "rb") as f: args = f.read().split(b"\0")
            except OSError: continue
            if b"llama-server" in os.path.basename(args[0]) and port.encode() in args: pids.append(int(name))
    def alive():
        out = []
        for pid in pids:
            if server_proc and server_proc.pid == pid and server_proc.poll() is not None: continue   # ours, and finished
            try:
                with open(f"/proc/{pid}/stat") as f:
                    if f.read().rsplit(")", 1)[-1].split()[0] == "Z": continue                         # finished, only its record is left
            except (OSError, IndexError): pass
            try: os.kill(pid, 0); out.append(pid)
            except OSError: pass
        return out
    for pid in pids:
        try: os.kill(pid, 15)
        except OSError: pass
    for _ in range(60):                       # wait until the memory is really given back
        if not alive(): return
        time.sleep(0.25)
    for pid in alive():
        try: os.kill(pid, 9)
        except OSError: pass
    time.sleep(0.5)

PAINT = f"{APP_HOME}/models/bxzex-paint"     # the same image model packaged for the Linux engine

def paint_engine():
    """The image engine used on Linux, if it is installed."""
    for root, _, files in os.walk(f"{APP_HOME}/imgengine"):
        if "sd-cli" in files: return os.path.join(root, "sd-cli")
    return None

def generate_image(prompt, shape="square", quality="fast", wait_for_chat=True):
    quality = quality.strip().lower() if quality.strip().lower() in SHAPES else "fast"
    w, h = SHAPES[quality].get(shape.strip().lower(), SHAPES[quality]["square"])
    prompt = " ".join(prompt.split())
    mac_engine = os.path.isdir(IMAGE_MODEL) and os.path.exists(IMAGE_BIN)
    engine = None if mac_engine else paint_engine()
    if not mac_engine and not (engine and os.path.exists(f"{PAINT}/model.gguf")):
        return "Image generation is not installed. Run the installer again to add it."
    out = f"{pictures_dir()}/{time.strftime('%Y-%m-%d %H-%M-%S')}.png"
    try: loras = sorted(os.path.join(LORAS, f) for f in os.listdir(LORAS) if f.endswith(".safetensors"))
    except OSError: loras = []
    scale = os.environ.get("BXZEX_LORA_SCALE", "0.8")
    env = None
    if mac_engine:
        cmd = [IMAGE_BIN, "--model", IMAGE_MODEL, "--low-ram", "--prompt", prompt,
               "--width", str(w), "--height", str(h), "--steps", str(STEPS[quality]), "--output", out]
        if loras: cmd += ["--lora-paths", *loras, "--lora-scales", *[scale] * len(loras)]
    else:                                                                        # Linux engine
        styles = "".join(f" <lora:{os.path.basename(f)[:-len('.safetensors')]}:{scale}>" for f in loras)
        cmd = [engine, "--diffusion-model", f"{PAINT}/model.gguf", "--vae", f"{PAINT}/vae.safetensors",
               "--llm", f"{PAINT}/text.gguf", "-p", prompt + styles, "--cfg-scale", "1.0", "--diffusion-fa",
               "--steps", str(STEPS[quality]), "-W", str(w), "-H", str(h), "-s", "-1", "-o", out]
        if loras: cmd += ["--lora-model-dir", LORAS]
        env = dict(os.environ, LD_LIBRARY_PATH=f"{os.path.dirname(engine)}:{os.environ.get('LD_LIBRARY_PATH', '')}")
    sys.stdout.write("\033[?25l")
    wait = Waiting("Making room")
    err = ""; proc = None
    try:
        while painting(): wait.label = "Waiting for another image to finish"; time.sleep(1)
        open(PAINTING, "w").close()
        stop_server()
        wait.label = "Painting"
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=env)
        while True:                                   # the generator reports its steps on stderr
            chunk = proc.stdout.read1(256).decode("utf-8", "ignore")
            if not chunk: break
            err = (err + chunk)[-2000:]
            step = [x for x in re.findall(r"(\d+)/(\d+)", chunk) if x[1] == str(STEPS[quality])]
            if step: wait.label = f"Painting, step {step[-1][0]} of {step[-1][1]}"
        proc.wait()
    except KeyboardInterrupt:
        if proc: proc.kill()
        wait.stop()
        if os.path.exists(PAINTING): os.remove(PAINTING)
        ensure_server(block=False); raise
    finally:
        wait.stop(); sys.stdout.write("\033[?25h"); sys.stdout.flush()
        if os.path.exists(PAINTING): os.remove(PAINTING)
    ensure_server(block=wait_for_chat)                # bring the chat model back
    if proc.returncode != 0 or not os.path.exists(out):
        last = [l for l in err.splitlines() if l.strip()]
        return f"error: the image could not be made ({last[-1][:200] if last else 'no details'})"
    for row in preview(out): print("  " + row)
    print(f"  {GOLD}{link(file_link(out), out.replace(HOME, '~'))}{R} {DIM}· {'cmd' if MAC else 'ctrl'}-click to open{R}")
    return f"saved to {out.replace(HOME, '~')} ({w}x{h}" + (f", {len(loras)} style file(s) applied)" if loras else ")")

# ---- working like an agent: a to-do list, questions, background jobs, helpers and plan mode ----
TODOS = []          # (state, text): state is " " to do, ">" doing now, "x" done
PLAN = False        # plan mode: it only looks around and writes a plan, nothing is changed

def show_todos():
    for state, text in TODOS:
        if state == "x": print(f"  {DIM}✓ {text}{R}")
        elif state == ">": print(f"  {GOLD}▸{R} {BOLD}{text}{R}")
        else: print(f"  {DIM}○{R} {text}")

def todo_items(todos):
    """The list as models actually send it: [ ] lines, or JSON (strings, or objects with text and done/status)."""
    data = todos
    if isinstance(todos, str) and todos.strip()[:1] in "[{":
        try: data = json.loads(todos)
        except ValueError:
            try:
                import ast
                data = ast.literal_eval(todos)
            except (ValueError, SyntaxError): data = todos
    if isinstance(data, dict): data = data.get("todos") or data.get("items") or [data]
    if not isinstance(data, list): return None
    out = []
    for it in data:
        if isinstance(it, str): out.append((" ", it.strip())); continue
        if not isinstance(it, dict): continue
        text = next((str(it[k]) for k in ("t", "text", "title", "content", "task", "step", "name") if it.get(k)), "")
        status = str(it.get("status") or it.get("state") or "").lower()
        done = it.get("done") is True or it.get("completed") is True or status in ("done", "completed", "complete", "finished")
        doing = status in ("in_progress", "in progress", "doing", "active", "current") or it.get("current") is True
        if text: out.append(("x" if done else ">" if doing else " ", text.strip()))
    return out

def update_todos(todos):
    parsed = todo_items(todos)
    if parsed:
        TODOS[:] = parsed[:20]; show_todos()
        left = sum(1 for st, _ in TODOS if st != "x")
        return f"to-do list updated: {len(TODOS) - left} done, {left} left"
    items = []
    for line in str(todos).splitlines():
        m = re.match(r"\s*(?:[-*]\s*)?\[(.)\]\s*(.+)", line)
        if m: items.append(({"x": "x", "X": "x", ">": ">", "~": ">"}.get(m.group(1), " "), m.group(2).strip()))
        elif line.strip(): items.append((" ", line.strip(" -*")))
    if not items: return "error: give one step per line, like [ ] step, [>] the step you are on, [x] a finished step"
    TODOS[:] = items[:20]
    show_todos()
    left = sum(1 for st, _ in TODOS if st != "x")
    return f"to-do list updated: {len(TODOS) - left} done, {left} left"

def ask_user(question, options=""):
    """A question with choices the user picks with the arrow keys, or answers in their own words."""
    picks = [o.strip() for o in str(options).split("|") if o.strip()][:6]
    if PHONE and picks:
        at = phone_choose(question, picks)
        return f"The user picked: {picks[at]}" if at is not None else "The user didn't answer. Use your best judgment and say what you chose."
    if not sys.stdin.isatty(): return "The user isn't at the keyboard. Pick the most sensible option and say which."
    busy = typed.th is not None
    typed.stop()
    try:
        ping_if_away(f"has a question: {question}")
        print(f"{GOLD}?{R} {BOLD}{question}{R}")
        rows = [(o, "") for o in picks] + [("Type my own answer", "")]
        at = menu(rows, hint="↑↓ to move · enter to pick · esc to skip")
        if at is None: print(f"  {DIM}skipped{R}"); return "The user skipped the question. Use your best judgment and say what you chose."
        if at < len(picks): print(f"  {GOLD}❯{R} {picks[at]}"); return f"The user picked: {picks[at]}"
        own = line_input(f"  {GOLD}❯{R} ").strip()
        return f"The user answered: {own}" if own else "The user didn't answer. Use your best judgment."
    finally:
        if busy: typed.start()

JOBS = {}           # number -> (process, log file, command) for commands left running in the background

def start_job(command):
    os.makedirs(f"{APP_HOME}/jobs", exist_ok=True)
    n = max(JOBS, default=0) + 1
    log = f"{APP_HOME}/jobs/{n}.log"
    with open(log, "w") as f:
        p = subprocess.Popen(command, shell=True, stdin=subprocess.DEVNULL, stdout=f, stderr=subprocess.STDOUT, start_new_session=True)
    JOBS[n] = (p, log, command)
    time.sleep(1.5)                                  # long enough to catch a command that fails straight away
    return f"started job {n} in the background (pid {p.pid}). First output:\n" + job_output(n)

def job_output(n):
    p, log, _ = JOBS[n]
    with open(log, errors="replace") as f: text = f.read()
    state = "still running" if p.poll() is None else f"finished, exit code {p.returncode}"
    return f"[job {n}: {state}]\n" + (text[-3000:] if len(text) > 3000 else text)

def check_job(job, action="output"):
    try: n = int(str(job).strip().lstrip("#"))
    except ValueError: return "error: job must be the job number"
    if n not in JOBS: return f"error: no job {n}. Running jobs: {', '.join(map(str, JOBS)) or 'none'}"
    if str(action).strip() == "stop":
        p = JOBS[n][0]
        try: os.killpg(p.pid, 15)
        except OSError: pass
        try: p.wait(5)
        except subprocess.TimeoutExpired:
            try: os.killpg(p.pid, 9)
            except OSError: pass
        return f"stopped job {n}"
    return job_output(n)

def stop_jobs():
    for p, _, _ in JOBS.values():
        if p.poll() is None:
            try: os.killpg(p.pid, 15)
            except OSError: pass

def show_jobs():
    print(header("Background jobs"))
    if not JOBS: print(f"  {DIM}none{R}"); return
    for n, (p, log, cmd) in JOBS.items():
        state = f"{GOLD}running{R}" if p.poll() is None else f"{DIM}done ({p.returncode}){R}"
        print(f"  {GOLD}{n}{R}  {state}  {cmd[:W() - 24]}")
    print(f"  {DIM}logs in {APP_HOME.replace(HOME, '~')}/jobs · they stop when you quit{R}")

out_lock = threading.Lock()
def put_line(text):
    """Print one whole line from any thread, over whatever loader is on the current line."""
    with out_lock:
        sys.stdout.write(f"\r\033[K{text}\n"); sys.stdout.flush()

# ---- helpers: several look-only workers at once, each with its own fresh memory ----
HELPER_TOOLS = {"web_search", "fetch_page", "read_file", "list_files", "search_files", "use_skill", "run_shell"}
HELPERS_AT_ONCE = 3
helper_stop = threading.Event()

def ask_model(messages, tools):
    """One quiet model call that returns the whole reply at once. Nothing is drawn, so several can run side by side."""
    body = json.dumps({"model": MODEL_ID if awake() else loaded_model(), "messages": [{"role": "system", "content": SYSTEM}] + mend(messages),
                       "tools": tools, "max_tokens": reply_room(), "temperature": 0.7, "stream": False,
                       "chat_template_kwargs": {"enable_thinking": not fast}}).encode()
    req = urllib.request.Request(f"{HOST}/v1/chat/completions", body, {"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=1800) as r: msg = json.load(r)["choices"][0]["message"]
    return (msg.get("content") or "").strip(), msg.get("tool_calls") or []

def helper_tools():
    return [t for t in TOOLS if t["function"]["name"] in HELPER_TOOLS
            or t["function"]["name"] in MCP and not mcp_acts(MCP[t["function"]["name"]][1], {})]

def helper_tool(n, call):
    """A helper only looks: reading, searching, read-only commands and reading from apps. Nothing it does asks the user."""
    fn = call["function"]; name = fn["name"]
    try: args = json.loads(fn.get("arguments") or "{}")
    except ValueError: return "error: arguments were not valid JSON"
    if not isinstance(args, dict): return "error: arguments must be a JSON object with the tool's named fields"
    shown = " ".join(str(v) for v in args.values()).replace("\n", " ")
    put_line(f"  {DIM}┊ helper {n} · {name}({shown[:max(10, W() - len(name) - 22)]}){R}")
    looks = (not mcp_acts(MCP[name][1], args)) if name in MCP else name in HELPER_TOOLS and not (
        name == "run_shell" and (not only_looks(str(args.get("command", ""))) or str(args.get("background")).lower() == "true"))
    if not looks: return "error: helpers can only look (read, search, list, read-only commands). Put what should be done in your report."
    blocked = hooks_before(name, args)
    if blocked: return blocked
    try: out = mcp_call(name, args) if name in MCP else str(TOOL_FUNCS[name](**args))
    except Exception as e: out = f"error: {e}"
    return out + hooks_after(name, args, out)

def one_helper(n, task):
    sub = [{"role": "user", "content": str(task) + "\n\nWork on this on your own with your tools. Don't ask me questions. You can only look: "
            "read, search, list and run read-only commands. When you're done, reply with a short report of what you found, with the exact "
            "file paths, links and numbers, and anything that should be changed."}]
    tools = helper_tools(); recent = []
    for _ in range(30):
        if helper_stop.is_set(): return "stopped before it finished"
        try: text, calls = ask_model(sub, tools)
        except Exception as e: return f"the helper hit an error: {getattr(e, 'reason', e)}"
        if not calls: return text or "the helper finished without a report"
        sub.append({"role": "assistant", "content": text, "tool_calls": calls})
        for i, call in enumerate(calls):
            call["id"] = call.get("id") or f"h{n}_{len(sub)}_{i}"
            recent.append((call["function"]["name"], call["function"].get("arguments")))
            out = REPEAT if circling(recent) else helper_tool(n, call)
            sub.append({"role": "tool", "tool_call_id": call["id"], "content": clip(out, OUT_CHARS)})
    return "the helper used all its steps. What it last said: " + (sub[-1].get("content") or "")[:2000]

def run_helpers(calls):
    """Every delegate call in one reply runs at the same time. Returns {call id: report}."""
    jobs = []
    for call in calls:
        try: task = json.loads(call["function"]["arguments"] or "{}").get("task", "")
        except (ValueError, AttributeError): task = ""
        jobs.append((call["id"], str(task)))
    n = len(jobs)
    for i, (_, task) in enumerate(jobs, 1):
        print(f"{TEAL}◆{R} {BOLD}helper {i}{R}{DIM}({' '.join(task.split())[:max(10, W() - 16)]}){R}")
    helper_stop.clear(); got = {}
    sys.stdout.write("\033[?25l")
    wait = Waiting("Helper working" if n == 1 else f"{n} helpers working")
    pool = concurrent.futures.ThreadPoolExecutor(max_workers=HELPERS_AT_ONCE)
    runs = {pool.submit(one_helper, i, task): cid for i, (cid, task) in enumerate(jobs, 1)}
    try:
        for f in concurrent.futures.as_completed(runs):
            got[runs[f]] = f.result()
            if n > 1: wait.label = f"{n} helpers working · {len(got)} done"
    except KeyboardInterrupt:
        helper_stop.set(); raise
    finally:
        wait.stop(); pool.shutdown(wait=False); sys.stdout.write("\033[?25h"); sys.stdout.flush()
    for i, (cid, _) in enumerate(jobs, 1):
        out = got[cid]; LAST_TOOLS.append((f"helper {i}", out))
        rows = [l for l in out.splitlines() if l.strip()]
        more = f" (+{len(rows) - 1} lines · ctrl-o)" if len(rows) > 1 else ""
        print(f"  {DIM}└ helper {i}: {(rows[0] if rows else '(empty)')[:max(10, W() - len(more) - 18)]}{more}{R}")
    print()
    return got

# ---- hooks: your own commands that run before or after its tools, or when a reply is done ----
# config.json "hooks": [{"on": "before" | "after" | "done", "tool": "edit_file|write_file", "run": "a shell command"}]
# A "before" hook that exits with an error blocks the tool, and what it printed is given as the reason.
def hooks(event):
    return [h for h in (load_config().get("hooks") or []) if isinstance(h, dict) and h.get("on") == event and h.get("run")]

def hook_matches(h, name):
    pattern = h.get("tool") or "*"
    if pattern == "*": return True
    try: return re.fullmatch(pattern, name) is not None
    except re.error: return pattern == name

def run_hook(h, env):
    try:
        p = subprocess.run(h["run"], shell=True, capture_output=True, text=True, errors="replace", timeout=60,
                           stdin=subprocess.DEVNULL, env=dict(os.environ, **env), start_new_session=True)
        return p.returncode, (p.stdout + p.stderr).strip()
    except subprocess.TimeoutExpired:
        return 1, "the hook took over 60 seconds and was stopped"
    except OSError as e:
        return 1, str(e)

def hook_env(name, args, out=""):
    return {"BXZEX_TOOL": name, "BXZEX_ARGS": json.dumps(args)[:100000], "BXZEX_FILE": str(args.get("path", "")),
            "BXZEX_COMMAND": str(args.get("command", "")), "BXZEX_RESULT": out[:20000]}

def hooks_before(name, args):
    for h in hooks("before"):
        if not hook_matches(h, name): continue
        code, said = run_hook(h, hook_env(name, args))
        if code != 0:
            put_line(f"  {DIM}⚑ blocked by your hook: {h['run'][:max(10, W() - 30)]}{R}")
            return f"Blocked by the user's hook (`{h['run']}`): {clip(said, 2000) or 'no reason given'}"
    return ""

def hooks_after(name, args, out):
    extra = []
    for h in hooks("after"):
        if not hook_matches(h, name): continue
        code, said = run_hook(h, hook_env(name, args, out))
        put_line(f"  {DIM}⚑ hook · {h['run'][:max(10, W() - 30)]} · {'ok' if code == 0 else f'exit {code}'}{R}")
        if said or code: extra.append(f"[the user's hook `{h['run']}` ran after this · exit {code}]\n{clip(said, 2000)}")
    return ("\n\n" + "\n".join(extra)) if extra else ""

def hooks_done(reply, took):
    for h in hooks("done"):
        threading.Thread(target=run_hook, args=(h, {"BXZEX_REPLY": reply[:20000], "BXZEX_SECONDS": str(int(took))}), daemon=True).start()

def show_hooks(arg=""):
    arg = arg.strip(); items = load_config().get("hooks") or []
    if arg.startswith("add "):
        parts = arg[4:].strip().split(None, 1)
        on = parts[0] if parts else ""
        if on == "done" and len(parts) == 2: tool_, run = "*", parts[1]
        elif on in ("before", "after") and len(parts) == 2 and len(parts[1].split(None, 1)) == 2: tool_, run = parts[1].split(None, 1)
        else: print(f"{DIM}/hooks add before|after <tool> <command>  ·  /hooks add done <command>{R}"); return
        items.append({"on": on, "tool": tool_, "run": run}); save_config(hooks=items)
        print(f"{DIM}saved: {on} {'' if on == 'done' else tool_ + ' '}→ {run}{R}"); return
    if arg.startswith(("remove", "rm")):
        try: n = int(arg.split()[1]); gone = items.pop(n - 1)
        except (IndexError, ValueError): print(f"{DIM}/hooks remove <number>{R}"); return
        save_config(hooks=items); print(f"{DIM}removed: {gone.get('run')}{R}"); return
    print(header("Hooks"))
    for i, h in enumerate(items, 1):
        print(f"  {GOLD}{i}{R}  {h.get('on'):<6} {DIM}{h.get('tool', '*') if h.get('on') != 'done' else ''}{R}  {h.get('run')}")
    if not items: print(f"  {DIM}none yet{R}")
    print(f"  {DIM}/hooks add after edit_file|write_file npx prettier --write \"$BXZEX_FILE\"     format every file it changes")
    print(f"  /hooks add before run_shell ! echo \"$BXZEX_COMMAND\" | grep -q 'git push'        a failing before-hook blocks the tool")
    print(f"  /hooks add done say done                                                       when a reply is finished")
    print(f"  /hooks remove 1 · tools match as a regex · they get BXZEX_TOOL, BXZEX_FILE, BXZEX_COMMAND, BXZEX_ARGS, BXZEX_RESULT{R}")

# ---- notifications: when a long reply ends or it needs you while you're in another window ----
HOME_APP = ""      # the app it was started in (it's in front then), to tell when they've switched away

def front_app():
    """The app in front on a Mac. Needs no permission."""
    if not MAC: return ""
    try:
        asn = subprocess.run(["lsappinfo", "front"], capture_output=True, text=True, timeout=2).stdout.strip()
        got = subprocess.run(["lsappinfo", "info", "-only", "name", asn], capture_output=True, text=True, timeout=2).stdout
        m = re.search(r'"LSDisplayName"="([^"]*)"', got)
        return m.group(1) if m else ""
    except Exception:
        return ""

def away():
    """True when they're likely not looking at this window."""
    if not (sys.stdout.isatty() and load_config().get("notify", True)): return False
    if MAC:
        now = front_app()
        return bool(HOME_APP and now and now != HOME_APP)
    return bool(shutil.which("notify-send"))

def notify(title, text):
    if os.environ.get("BXZEX_NO_TICKER"): return        # the tests: no system timer and no notifications
    try:
        if MAC:
            subprocess.Popen(["osascript", "-e", "on run argv", "-e", "display notification (item 2 of argv) with title (item 1 of argv)",
                              "-e", "end run", title, text[:220]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif shutil.which("notify-send"):
            subprocess.Popen(["notify-send", title, text[:220]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass

def ping_if_away(text):
    if away():
        notify(AI_NAME, text); RAW.write("\a"); RAW.flush()     # the bell also bounces the terminal in the dock

# ---- scheduled tasks: it does a task at set times on its own, even with the app closed ----
SCHEDULES = f"{APP_HOME}/schedules.json"
RESULTS = f"{APP_HOME}/scheduled"
DAYS = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
TICK_LABEL = "com.bxzex.ai.schedule"

def load_schedules():
    try:
        with open(SCHEDULES) as f: got = json.load(f)
        return [s for s in got if isinstance(s, dict) and s.get("id")] if isinstance(got, list) else []
    except (OSError, ValueError):
        return []

def save_schedules(items):
    os.makedirs(APP_HOME, exist_ok=True)
    with open(SCHEDULES + ".tmp", "w") as f: json.dump(items, f, indent=1)
    os.replace(SCHEDULES + ".tmp", SCHEDULES)

def clock(text):
    m = re.fullmatch(r"(\d{1,2})(?::(\d{2}))?\s*(am|pm|a\.m\.|p\.m\.)?", text.strip())
    if not m: return ""
    h, mi, half = int(m.group(1)), int(m.group(2) or 0), (m.group(3) or "")[:1]
    if half and not 1 <= h <= 12: return ""
    if half == "p" and h != 12: h += 12
    if half == "a" and h == 12: h = 0
    return f"{h:02d}:{mi:02d}" if h < 24 and mi < 60 else ""

def day_list(text):
    text = re.sub(r"\b(mornings?|evenings?|nights?|afternoons?|at)\b", " ", text.replace(" and ", ",")).strip()
    if text in ("", "daily", "day", "every day", "everyday", "each day"): return list(range(7))
    if text in ("weekday", "weekdays"): return list(range(5))
    if text in ("weekend", "weekends"): return [5, 6]
    days = set()
    for part in re.split(r"[,\s]+", text):
        if not part: continue
        if "-" in part:
            a, _, b = part.partition("-")
            if a[:3] not in DAYS or b[:3] not in DAYS: return None
            i, j = DAYS.index(a[:3]), DAYS.index(b[:3])
            days.update(range(i, j + 1) if i <= j else list(range(i, 7)) + list(range(j + 1)))
        elif part[:3] in DAYS: days.add(DAYS.index(part[:3]))
        else: return None
    return sorted(days) or None

def parse_when(text):
    """'every day at 8am', 'weekdays 9:30', 'mon,thu 18:00', 'every 30 minutes', 'hourly', 'once 2026-10-20 15:00'."""
    s = " ".join(str(text).lower().replace("every day", "daily").split())
    s = re.sub(r"^(every|on)\s+(?=[a-z])(?!\d)", "", s) if not re.match(r"every\s+\d", s) else s
    s = s.removeprefix("at ")
    if s in ("hourly", "hour", "every hour"): return {"every": 60}
    m = re.fullmatch(r"(?:every\s*)?(\d+)\s*(m|mins?|minutes?|h|hrs?|hours?)", s)
    if m:
        n = int(m.group(1)) * (60 if m.group(2).startswith("h") else 1)
        return {"every": n} if n >= 5 else "error: the most often is every 5 minutes"
    m = re.fullmatch(r"(?:once\s+)?(?:on\s+)?(\d{4}-\d{2}-\d{2})(?:\s+at)?\s+(.+)", s)
    if m:
        t = clock(m.group(2))
        try: at = datetime.datetime.strptime(f"{m.group(1)} {t}", "%Y-%m-%d %H:%M")
        except ValueError: return "error: couldn't read that date and time; use like once 2026-10-20 15:00"
        if at <= datetime.datetime.now(): return "error: that time has already passed"
        return {"once": f"{at:%Y-%m-%d %H:%M}"}
    m = re.fullmatch(r"(?:(.+?)\s+)?(?:at\s+)?(\d{1,2}(?::\d{2})?\s*(?:am|pm|a\.m\.|p\.m\.)?)", s)
    if m:
        days, t = day_list((m.group(1) or "").removesuffix(" at")), clock(m.group(2))
        if days is not None and t: return {"days": days, "at": t}
    return ("error: couldn't read when. Use one of: daily 08:00 · weekdays 9am · mon,thu 18:00 · every 30 minutes · "
            "every 2 hours · hourly · once 2026-10-20 15:00")

def describe(it):
    if "every" in it:
        n = it["every"]
        return "every hour" if n == 60 else f"every {n // 60} hours" if n % 60 == 0 else f"every {n} minutes"
    if "once" in it: return f"once, {it['once']}"
    d = it.get("days") or []
    days = "every day" if len(d) == 7 else "weekdays" if d == [0, 1, 2, 3, 4] else "weekends" if d == [5, 6] else ", ".join(DAYS[i] for i in d)
    return f"{days} at {it.get('at')}"

def due(it, now):
    last = it.get("last") or it.get("made") or 0
    if "every" in it: return now.timestamp() - last >= it["every"] * 60 - 30
    if "once" in it: return not it.get("last") and now >= datetime.datetime.strptime(it["once"], "%Y-%m-%d %H:%M")
    h, mi = map(int, it["at"].split(":"))
    for back in range(8):
        slot = (now - datetime.timedelta(days=back)).replace(hour=h, minute=mi, second=0, microsecond=0)
        if slot > now or slot.weekday() not in it.get("days", []): continue
        return slot.timestamp() > last and (now - slot).total_seconds() < 6 * 3600   # missed while the computer slept: still runs within 6 hours
    return False

def warm_now(now):
    w = load_config().get("warm") or {}
    if not (REMOTE and w): return False
    return now.weekday() in w.get("days", range(7)) and w.get("from", 9) <= now.hour < w.get("to", 18)

def ticker():
    """The system starts this app every minute to begin tasks that are due (launchd on a Mac, cron on Linux).
    It's switched on while anything is scheduled or kept warm, and off again when nothing is."""
    if os.environ.get("BXZEX_NO_TICKER"): return ""
    on = bool(load_schedules()) or bool(load_config().get("warm"))
    me = [sys.executable, os.path.abspath(__file__), "--tick"]
    env = {"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "HOME": HOME}
    if "BXZEX_HOME" in os.environ: env["BXZEX_HOME"] = APP_HOME
    os.makedirs(RESULTS, exist_ok=True)
    try:
        if MAC:
            import plistlib
            plist = f"{HOME}/Library/LaunchAgents/{TICK_LABEL}.plist"; where = f"gui/{os.getuid()}"
            data = plistlib.dumps({"Label": TICK_LABEL, "ProgramArguments": me, "StartInterval": 60, "RunAtLoad": True,
                                   "EnvironmentVariables": env, "StandardOutPath": f"{RESULTS}/tick.log", "StandardErrorPath": f"{RESULTS}/tick.log"})
            try:
                with open(plist, "rb") as f: same = f.read() == data
            except OSError: same = False
            loaded = subprocess.run(["launchctl", "print", f"{where}/{TICK_LABEL}"], capture_output=True).returncode == 0
            if on and same and loaded: return ""
            subprocess.run(["launchctl", "bootout", f"{where}/{TICK_LABEL}"], capture_output=True)
            if not on:
                if os.path.exists(plist): os.remove(plist)
                return ""
            os.makedirs(os.path.dirname(plist), exist_ok=True)
            with open(plist, "wb") as f: f.write(data)
            r = subprocess.run(["launchctl", "bootstrap", where, plist], capture_output=True, text=True)
            return "" if r.returncode == 0 else f"couldn't start the timer: {r.stderr.strip()[:160]}"
        if not shutil.which("crontab"): return "scheduled tasks need cron on this computer: sudo apt install cron"
        cur = subprocess.run(["crontab", "-l"], capture_output=True, text=True).stdout
        rows = [l for l in cur.splitlines() if "# bxzex-ai schedule" not in l]
        if on:
            rows.append("* * * * * " + " ".join(f"{k}={shlex.quote(v)}" for k, v in env.items()) + " " + " ".join(shlex.quote(x) for x in me)
                        + f" >> {shlex.quote(RESULTS + '/tick.log')} 2>&1 # bxzex-ai schedule")
        subprocess.run(["crontab", "-"], input="\n".join(rows) + "\n", text=True, capture_output=True)
        return ""
    except Exception as e:
        log_error(type(e), e, e.__traceback__); return f"couldn't set the timer: {e}"

def tick():
    """Every minute: start each task that's due in its own process, and keep the cloud card awake in the warm hours."""
    import fcntl
    os.makedirs(RESULTS, exist_ok=True)
    with open(f"{RESULTS}/.tick.lock", "w") as lock:
        try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError: return
        now = datetime.datetime.now()
        items = load_schedules(); go = [it for it in items if not it.get("paused") and due(it, now)]
        for it in go: it["last"] = time.time()
        if go: save_schedules(items)               # marked before starting, so a slow task is never started twice
        for it in go:
            with open(f"{RESULTS}/{it['id']}.log", "w") as log:
                subprocess.Popen([sys.executable, os.path.abspath(__file__), "--run-schedule", it["id"]], stdin=subprocess.DEVNULL,
                                 stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
        if warm_now(now):
            try: urllib.request.urlopen(f"{HOST}/health", timeout=20).read()
            except Exception: pass

def run_schedule(sid):
    """Run one scheduled task with nobody at the keyboard, save its report and send a notification."""
    global allow_all
    item = next((it for it in load_schedules() if it["id"] == sid), None)
    if not item: return
    allow_all = bool(item.get("act"))        # risky commands still never run: there's nobody to ask
    def stop(*_): raise KeyboardInterrupt
    signal.signal(signal.SIGALRM, stop); signal.alarm(30 * 60)
    before = read_text(item.get("result") or "", 3000) if item.get("result") else ""
    h = [user_message(
        "(This is a scheduled task running on its own. Nobody is at the keyboard and nobody can answer questions. "
        + ("You may take the actions the task asks for. " if item.get("act") else
           "Only look and read: anything that sends, posts, changes or deletes is not allowed, so say what you would do instead. ")
        + "End with a short, plain report of what you found or did: it is saved and shown to the user as a notification. "
        + "If there is nothing worth telling them, reply with just: nothing new"
        + (f"\nYour report from the last run, so you can tell what's new:\n{before}" if before else "") + ")\n\n" + item["task"])]
    try:
        if not ensure_server(): result = "couldn't reach the model, so this didn't run"
        else:
            if load_config().get("mcp"): connect_mcp()
            refresh_system()
            run_turn(h)
            result = next((m["content"] for m in reversed(h) if m["role"] == "assistant" and isinstance(m.get("content"), str) and m["content"].strip()), "")
            result = result or "it finished without a report"
    except KeyboardInterrupt:
        result = "stopped: it ran for more than 30 minutes"
    except Exception as e:
        log_error(type(e), e, e.__traceback__); result = f"it hit an error: {e}"
    signal.alarm(0)
    stamp = datetime.datetime.now(); os.makedirs(RESULTS, exist_ok=True)
    path = f"{RESULTS}/{stamp:%Y-%m-%d_%H%M}-{sid}.md"
    with open(path, "w") as f: f.write(f"# {item['name']}\n{stamp:%A %B %d, %Y at %H:%M} · {describe(item)}\n\n{result}\n")
    quiet = result.strip().lower().rstrip(".") == "nothing new"
    items = load_schedules()
    for it in items:
        if it["id"] == sid: it.update(result=path, seen=quiet, ran=stamp.strftime("%b %d %H:%M"))
    save_schedules([it for it in items if not (it["id"] == sid and "once" in it)])
    if "once" in item: ticker()
    if not quiet:
        notify(f"{AI_NAME} · {item['name']}", " ".join(re.sub(r"[*#`>|_]", "", result).split()))
        try: phone_send(f"{item['name']}\n\n{result}")
        except Exception as e: log_error(type(e), e, e.__traceback__)

def schedule_task(action="add", when="", task="", name="", can_act="false", id=""):
    action = str(action).strip().lower()
    items = load_schedules()
    if action == "list":
        return "\n".join(f"{it['id']}: {it['name']} · {describe(it)} · {'can act' if it.get('act') else 'looks only'} · task: {it['task']}"
                         for it in items) or "nothing is scheduled"
    if action == "remove":
        left = [it for it in items if it["id"] != str(id).strip()]
        if len(left) == len(items): return f"error: no scheduled task {id}. Use action list to see them."
        if not confirm("remove a scheduled task", next(it["name"] for it in items if it["id"] == str(id).strip())): return "The user declined."
        save_schedules(left); ticker(); return f"removed {id}"
    if PLAN: return plan_block()
    rule = parse_when(when)
    if isinstance(rule, str): return rule
    if not str(task).strip(): return "error: task is empty: write out the full task, with every detail it needs"
    act = str(can_act).lower() == "true"
    name = " ".join((str(name).strip() or str(task)).split()[:6])[:48]
    it = {"id": f"s{max([int(i['id'][1:]) for i in items if i['id'][1:].isdigit()], default=0) + 1}", "name": name, "task": str(task).strip(),
          "act": act, "made": time.time(), **rule}
    if not confirm(f"schedule: {name} · {describe(it)}", f"{it['task']}\n\n" + (
            "It may act on its own when it runs (send, post, change things), without asking." if act else
            "It only looks and reads when it runs, then tells you what it found."), always_ask=act):
        return "The user declined."
    items.append(it); save_schedules(items)
    trouble = ticker()
    return (f"scheduled {it['id']}: {name} · {describe(it)}. It runs on its own, even with the app closed, and sends a notification "
            f"with what it found. /schedule shows them." + (f" But: {trouble}" if trouble else ""))

def unseen_results():
    return [it for it in load_schedules() if it.get("result") and it.get("seen") is False]

def show_schedules(arg=""):
    global history
    items = load_schedules()
    print(header("Scheduled tasks"))
    if not items:
        print(f"  {DIM}none yet · ask for one in your own words, like: every weekday at 8am read my gmail and tell me what's important{R}"); return
    rows = [(it["name"], f"{describe(it)} · {'can act' if it.get('act') else 'looks only'}{' · paused' if it.get('paused') else ''}"
             f"{' · last ran ' + it['ran'] if it.get('ran') else ''}{' · NEW' if it.get('seen') is False else ''}") for it in items]
    at = menu(rows, hint="↑↓ to move · enter to pick · esc to close")
    if at is None: return
    it = items[at]
    acts = (["Read the last result"] if it.get("result") else []) + ["Run it now", "Resume" if it.get("paused") else "Pause", "Remove"]
    print(f"{GOLD}●{R} {BOLD}{it['name']}{R} {DIM}· {describe(it)} · {it['task'][:max(10, W() - len(it['name']) - 30)]}{R}")
    pick = menu([(a, "") for a in acts])
    if pick is None: return
    what = acts[pick]
    if what == "Read the last result":
        text = read_text(it["result"], 20000)
        md = Markdown(prefix=f"{GOLD}●{R} "); md.feed(text); md.close(); print()
        history.append({"role": "user", "content": f"(The result of my scheduled task \"{it['name']}\", for reference:)\n{text}"})
        it["seen"] = True
    elif what == "Run it now":
        with open(f"{RESULTS}/{it['id']}.log", "w") as log:
            subprocess.Popen([sys.executable, os.path.abspath(__file__), "--run-schedule", it["id"]], stdin=subprocess.DEVNULL,
                             stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
        print(f"  {DIM}running in the background · a notification comes when it's done · /schedule to read it{R}")
    elif what in ("Pause", "Resume"):
        it["paused"] = what == "Pause"; print(f"  {DIM}{'paused' if it['paused'] else 'running again on schedule'}{R}")
    else:
        items.remove(it); print(f"  {DIM}removed{R}")
    save_schedules(items); ticker()

def keep_warm(arg=""):
    """/warm 9-18 keeps the cloud card awake in those hours (weekdays too: /warm weekdays 9-18), /warm off stops it."""
    arg = arg.strip().lower()
    if not REMOTE: print(f"{DIM}/warm is for the cloud card · this computer runs the model itself{R}"); return
    if arg in ("off", "stop", "no"):
        save_config(warm={}); ticker(); print(f"{DIM}keep-warm off · the card sleeps 5 minutes after the last message{R}"); return
    m = re.fullmatch(r"(?:(weekdays|every ?day|daily)\s+)?(\d{1,2})\s*-\s*(\d{1,2})", arg)
    if not m:
        w = load_config().get("warm") or {}
        now = f"on: {'weekdays' if w.get('days') == [0, 1, 2, 3, 4] else 'every day'} {w.get('from')}:00 to {w.get('to')}:00" if w else "off"
        print(f"{DIM}keep-warm is {now} · /warm 9-18 keeps it awake 9am to 6pm so replies start right away · /warm weekdays 9-18 · /warm off")
        print(f"it costs about $4 for every hour the card stays awake{R}"); return
    a, b = int(m.group(2)), int(m.group(3))
    if not (0 <= a < b <= 24): print(f"{DIM}hours go from 0 to 24, like /warm 9-18{R}"); return
    days = [0, 1, 2, 3, 4] if m.group(1) == "weekdays" else list(range(7))
    save_config(warm={"from": a, "to": b, "days": days})
    trouble = ticker()
    print(f"{DIM}keep-warm on: {'weekdays' if len(days) == 5 else 'every day'} {a}:00 to {b}:00 · about ${4 * (b - a)} a day it's on · /warm off to stop{R}"
          + (f"\n{DIM}{trouble}{R}" if trouble else ""))

# ---- MCP: tools from other servers, like Composio for connecting apps (Gmail, Slack, GitHub, Calendar...) ----
# Servers live in config.json under "mcp": {"name": {"url": ..., "headers": {...}}}, on this computer only.
MCP = {}            # tool name the model sees -> (server, real tool name)
MCP_STATUS = {}     # server -> "ok: N tools" or the error
mcp_sessions = {}   # server -> Mcp-Session-Id

def mcp_rpc(server, method, params=None, note=False):
    conf = load_config().get("mcp", {}).get(server) or {}
    body = {"jsonrpc": "2.0", "method": method, "params": params or {}}
    if not note: body["id"] = int(time.time() * 1000) % 10**9
    head = {"Content-Type": "application/json", "Accept": "application/json, text/event-stream", **(conf.get("headers") or {})}
    if server in mcp_sessions: head["Mcp-Session-Id"] = mcp_sessions[server]
    req = urllib.request.Request(conf["url"], json.dumps(body).encode(), head)
    with urllib.request.urlopen(req, timeout=120) as r:
        sid = r.headers.get("Mcp-Session-Id")
        if sid: mcp_sessions[server] = sid
        raw = r.read().decode("utf-8", "ignore")
    if note: return None
    found = None
    for line in raw.splitlines():                     # either plain JSON or a stream of "data:" events
        line = line.strip()
        if line.startswith("data:"): line = line[5:].strip()
        if line.startswith("{"):
            try: msg = json.loads(line)
            except ValueError: continue
            if msg.get("id") == body["id"] or "result" in msg or "error" in msg: found = msg
    if found is None:
        try: found = json.loads(raw)
        except ValueError: raise RuntimeError("the server's answer couldn't be read")
    if "error" in found: raise RuntimeError(str(found["error"].get("message", found["error"]))[:300])
    return found.get("result") or {}

def mcp_name(server, tool_name):
    return re.sub(r"[^A-Za-z0-9_-]", "_", f"{server}__{tool_name}")[:64]

COMPOSIO_API = "https://backend.composio.dev/api/v3.1"

def composio_key():
    conf = (load_config().get("mcp") or {}).get("composio") or {}
    return (conf.get("headers") or {}).get("x-api-key", "")

def composio_api(path, body=None):
    req = urllib.request.Request(COMPOSIO_API + path, json.dumps(body).encode() if body is not None else None,
                                 {"x-api-key": composio_key(), "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=30) as r: return json.load(r)

def renew_composio():
    """Composio sessions can run out. With the project key, a fresh one is made and saved, so apps keep working."""
    if not composio_key(): return False
    try:
        conf = load_config().get("mcp") or {}
        user = conf["composio"].get("user_id") or "bxzex-ai"
        made = composio_api("/tool_router/session", {"user_id": user})
        url = (made.get("mcp") or {}).get("url")
        if not url: return False
        conf["composio"]["url"] = url; conf["composio"]["user_id"] = user
        save_config(mcp=conf)
        try: os.chmod(CONFIG, 0o600)
        except OSError: pass
        return True
    except Exception:
        return False

def connect_mcp():
    """Start every MCP server in config.json and add its tools to the ones the model can call."""
    for server, conf in (load_config().get("mcp") or {}).items():
        if not isinstance(conf, dict) or not conf.get("url"): continue
        try:
            mcp_sessions.pop(server, None)
            try:
                mcp_rpc(server, "initialize", {"protocolVersion": "2025-03-26", "capabilities": {},
                                               "clientInfo": {"name": "bxzex-ai", "version": VERSION}})
            except Exception:
                if not (server == "composio" and renew_composio()): raise
                mcp_rpc(server, "initialize", {"protocolVersion": "2025-03-26", "capabilities": {},
                                               "clientInfo": {"name": "bxzex-ai", "version": VERSION}})
            try: mcp_rpc(server, "notifications/initialized", note=True)
            except Exception: pass
            tools, cursor = [], None
            while True:
                got = mcp_rpc(server, "tools/list", {"cursor": cursor} if cursor else {})
                tools += got.get("tools") or []
                cursor = got.get("nextCursor")
                if not cursor or len(tools) > 200: break
            for t in tools:
                name = mcp_name(server, t["name"])
                MCP[name] = (server, t["name"])
                schema = t.get("inputSchema") or {"type": "object", "properties": {}}
                TOOLS.append({"type": "function", "function": {"name": name, "description": f"[{server}] " + (t.get("description") or "")[:900],
                                                                "parameters": schema}})
            MCP_STATUS[server] = f"connected · {len(tools)} tools"
        except Exception as e:
            MCP_STATUS[server] = f"couldn't connect: {str(e)[:160]}"

