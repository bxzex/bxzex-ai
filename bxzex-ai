import fcntl, termios
WHISPER = shutil.which("whisper-cli")
VOICE_MODEL = f"{APP_HOME}/models/bxzex-voice.bin"
VOICE_LANG = os.environ.get("BXZEX_VOICE_LANG", "en")

def listen():
    """Record the mic until Enter, transcribe on-device with whisper.cpp, return the text."""
    if not (WHISPER and shutil.which("ffmpeg") and os.path.exists(VOICE_MODEL)):
        print(f"{DIM}voice needs whisper-cli, ffmpeg and {VOICE_MODEL}{R}"); return ""
    wav = tempfile.NamedTemporaryFile(suffix=".wav", delete=False).name
    rec = subprocess.Popen(["ffmpeg", "-loglevel", "error", "-y", "-f", "avfoundation", "-i", ":default",
                            "-ar", "16000", "-ac", "1", wav], stdin=subprocess.PIPE, stderr=subprocess.PIPE)
    sys.stdout.write("\033[?25l")
    wait = Waiting("LISTENING · press enter when done")
    try:
        input()
        sys.stdout.write("\033[1A")          # back onto the loader line the Enter moved us off
    except (EOFError, KeyboardInterrupt):
        wait.stop(); rec.kill(); os.unlink(wav); sys.stdout.write("\033[?25h"); print(f"{DIM}cancelled{R}"); return ""
    wait.stop()
    try: rec.communicate(b"q", timeout=5)    # 'q' lets ffmpeg finish the wav header
    except subprocess.TimeoutExpired: rec.kill()
    wait = Waiting("TRANSCRIBING")
    try:
        out = subprocess.run([WHISPER, "-m", VOICE_MODEL, "-f", wav, "-l", VOICE_LANG, "-nt", "-np"],
                             capture_output=True, text=True, timeout=120).stdout
    except Exception:
        out = ""
    finally:
        wait.stop(); sys.stdout.write("\033[?25h"); sys.stdout.flush()
        if os.path.exists(wav): os.unlink(wav)
    text = re.sub(r"[\[(][^\])]*[\])]", " ", out)   # drop [BLANK_AUDIO], (music) and the like
    text = " ".join(text.split())
    if not text: print(f"{DIM}didn't catch anything — check the mic permission for Terminal{R}")
    return text

def ask(prefill=""):
    """Prompt for a message. Prefill is typed into the terminal so it can be edited before sending."""
    sys.stdout.write(f"\n{GOLD}►{R} "); sys.stdout.flush()
    if prefill:
        try:
            for b in prefill.encode(): fcntl.ioctl(sys.stdin.fileno(), termios.TIOCSTI, bytes([b]))
        except OSError:
            print(prefill); return prefill
    return input().strip()

