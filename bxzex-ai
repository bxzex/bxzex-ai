import select, termios, tty

class TypeAhead:
    """Collects what you type while the model is busy. Enter queues the line as a note for it."""
    def __init__(self):
        self.buf = ""; self.notes = []; self.leftover = ""
        self.saved = None; self.th = None; self.stop_ev = threading.Event()
    def start(self):
        if self.th or not sys.stdin.isatty(): return
        self.fd = sys.stdin.fileno()
        try:
            self.saved = termios.tcgetattr(self.fd); tty.setcbreak(self.fd)   # no echo, keys arrive one by one, Ctrl-C still works
        except termios.error:
            self.saved = None; return
        self.stop_ev.clear()
        self.th = threading.Thread(target=self.run, daemon=True); self.th.start()
    def run(self):
        while not self.stop_ev.is_set():
            global resized
            ready, _, _ = select.select([self.fd], [], [], 0.1)
            if resized: resized = False; box.draw(self.buf, len(self.buf))
            if not ready: continue
            got = re.sub(r"\x1b\[[0-9;]*[A-Za-z~]|\x1bO[A-Za-z]|\x1b", "", os.read(self.fd, 64).decode("utf-8", "ignore"))   # arrows and other keys, not text
            for ch in got:
                if ch in "\r\n":
                    if self.buf.strip(): self.notes.append(self.buf.strip())
                    self.buf = ""
                elif ch in "\x7f\b": self.buf = self.buf[:-1]
                elif ch == "\x15": self.buf = ""
                elif ch >= " ": self.buf += ch
            box.draw(self.buf, len(self.buf))
    def stop(self):
        """Back to normal line input. Whatever was typed but not sent is kept in .leftover."""
        if not self.th: return
        self.stop_ev.set(); self.th.join(); self.th = None
        if self.saved: termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)
        self.leftover, self.buf = self.buf, ""
    def drain(self):
        notes, self.notes = self.notes, []
        return notes

typed = TypeAhead()

# ---- streaming ----
class Markdown:
    """Renders the model's streamed markdown as terminal styling, wrapped to the window
    with a hanging indent. Output is held back one word at a time so wrapping never splits a word."""
    def __init__(self, prefix="  "):
        self.prefix = prefix                               # start of the very first line, e.g. the reply bullet
        self.stars = self.ticks = self.hashes = 0          # pending runs, resolved by the next char
        self.bold = self.ital = self.code = self.fence = self.head = False
        self.bol = True       # only whitespace so far on this line
        self.col0 = True      # nothing printed on this line yet
        self.skip = False     # swallowing the rest of a ``` line
        self.eat_space = False
        self.bullet = False   # just printed a bullet: squeeze the spaces after it to one
        self.dash = False     # a "-" at the start of a line, waiting to see if it is a list item
        self.prev = "\n"
        self.col = 0
        self.word = []; self.word_w = 0; self.word_style = R

    def style(self):
        s = R
        if self.fence or self.code: s += TEAL
        if self.bold or self.head: s += BOLD
        if self.ital: s += ITAL
        return s

    def hold(self, s, w):
        if not self.word: self.word_style = self.style()
        self.word.append(s); self.word_w += w

    def flush_word(self):
        if not self.word: return
        if self.col0 and not self.word_w:      # only style codes pending: nothing to put on this line yet
            self.word = []; return
        if self.col0:
            sys.stdout.write(self.prefix + self.word_style); self.prefix = "  "
            self.col0 = False; self.col = 2
        elif self.col + self.word_w > TW() and self.col > 2 and not self.fence:
            sys.stdout.write(f"{R}\n  {self.word_style}"); self.col = 2
        sys.stdout.write("".join(self.word)); self.col += self.word_w
        self.word = []; self.word_w = 0

    def out(self, s):
        self.hold(s, len(s))
        if s.strip(): self.bol = False
        self.prev = s[-1]

    def restyle(self):
        self.hold(self.style(), 0)

    def resolve(self, run, nxt):
        n = getattr(self, run); setattr(self, run, 0)
        if run == "ticks":
            if n >= 3: self.fence = not self.fence; self.skip = True
            elif self.fence: self.out("`" * n)
            else: self.code = not self.code
        elif run == "stars":
            if n >= 2: self.bold = not self.bold
            elif self.bol and nxt == " ": self.out("•"); self.bullet = True
            elif self.prev in " \n" and nxt in " \n": self.out("*")
            else: self.ital = not self.ital
        elif nxt == " ": self.head = True; self.eat_space = True
        else: self.out("#" * n)
        self.restyle()

    def newline(self):
        self.flush_word()
        self.bold = self.ital = self.code = self.head = False
        sys.stdout.write(R + "\n"); self.bol = self.col0 = True; self.prev = "\n"; self.col = 0
        self.word_style = self.style()

    def char(self, ch):
        run = {"*": "stars", "`": "ticks", "#": "hashes"}.get(ch)
        if run == "hashes" and not (self.bol and not self.fence and not self.code): run = None
        if run == "stars" and (self.fence or self.code): run = None
        for r in ("stars", "ticks", "hashes"):
            if r != run and getattr(self, r): self.resolve(r, ch)
        if self.skip:
            if ch == "\n":
                self.flush_word(); self.skip = False; self.bol = self.col0 = True; self.prev = "\n"; self.col = 0
                self.word_style = self.style()
            return
        if run: setattr(self, run, getattr(self, run) + 1); return
        if self.dash:
            self.dash = False
            if ch == " ": self.out("•"); self.bullet = True
            else: self.out("-")
        elif ch == "-" and self.bol and not self.fence and not self.code:
            self.dash = True; return
        if self.eat_space and ch == " ": self.eat_space = False; return
        self.eat_space = False
        if self.bullet and ch == " " and self.prev == " ": return
        if ch != " ": self.bullet = False
        if ch == "\n": self.newline(); return
        if ch == " " and not self.bol and not self.fence:   # a word just ended: decide where it goes
            self.flush_word()
            if self.col < TW(): sys.stdout.write(" "); self.col += 1
            self.prev = " "
            return
        self.out(ch)

    def feed(self, text):
        for ch in text: self.char(ch)
        sys.stdout.flush()

    def close(self):
        for r in ("stars", "ticks", "hashes"):
            if getattr(self, r): self.resolve(r, "\n")
        if self.dash: self.out("-")
        self.flush_word()
        sys.stdout.write(R)

class Waiting:
    """One-line status shown while it loads, reads or thinks: flames, what it's doing, how long, how many tokens."""
    def __init__(self, label):
        self.label = label; self.tok = 0
        self.preview = ""     # tail of what is being written right now, e.g. the file a tool call is producing
        self.stop_ev = threading.Event(); self.t0 = time.time()
        self.th = threading.Thread(target=self.run, daemon=True); self.th.start()
    def run(self):
        while not self.stop_ev.wait(0.07):
            el = time.time() - self.t0; w = W()
            tok = f" · ↓ {self.tok} tok" if self.tok else ""
            info = f"({fmt(el)}{tok} · ctrl-c to stop)"
            used = 2 + len(self.label) + 2 + len(info)
            ride = flame(el) + " " if w > used + 16 else ""
            if ride: used += 13
            room = w - used - 6
            if self.preview and room > 12:
                tail = re.sub(r"\\[nt]|\s+", " ", self.preview).replace('\\"', '"')[-room:]
                note = f"   {DIM}{tail}{R}"
            else: note = ""
            line = f"\r\033[K{ride}{GOLD}{self.label}…{R} {DIM}{info}{R}{note}"
            RAW.write(line if w > used else f"\r\033[K{GOLD}{self.label[:max(4, w - 4)]}…{R}")
            RAW.flush()
    def stop(self):
        if self.stop_ev.is_set(): return
        self.stop_ev.set(); self.th.join()
        RAW.write("\r\033[K"); RAW.flush()

# ---- long conversations ----
# The model can only hold so much at once. Before a chat outgrows that, the older part is folded into a
# short summary written by the model itself and the newest messages are kept word for word.
ctx_size = 0          # what the running model can hold, asked from the server once
tok_per_char = 0.3    # corrected from what the server reports after each reply

def context_size():
    global ctx_size
    if not ctx_size:
        try:
            with urllib.request.urlopen(f"{HOST}/props", timeout=3) as r:
                ctx_size = int(json.load(r)["default_generation_settings"]["n_ctx"])
        except Exception:
            return int(os.environ.get("BXZEX_CTX") or 32768)
    return ctx_size

def reply_room(): return min(12000 if REMOTE else 4096, context_size() // 4)   # the cloud card has room for long scripts

CUT_OFF = ("That call was cut off at the reply length limit, so it never ran. Write long scripts in smaller pieces: "
           "save the script with write_file first, then run it with a short run_shell command.")

def whole(call):
    """True when a tool call's arguments are complete JSON. A reply that runs out of room leaves them cut off."""
    try: json.loads(call["function"].get("arguments") or "{}"); return True
    except ValueError: return False

def mend(msgs):
    """Replaces cut-off tool calls with empty ones, since the server refuses the whole chat when one is broken."""
    out = []
    for m in msgs:
        if m.get("tool_calls") and not all(whole(c) for c in m["tool_calls"]):
            m = dict(m, tool_calls=[c if whole(c) else dict(c, function=dict(c["function"], arguments="{}")) for c in m["tool_calls"]])
        out.append(m)
    return out

def chars_in(messages):
    n = 0
    for m in messages:
        c = m.get("content") or ""
        n += 12 + (len(c) if isinstance(c, str) else sum(len(p.get("text", "")) if p.get("type") == "text" else 3000 for p in c))
        for call in m.get("tool_calls") or []: n += 30 + len(call["function"]["name"]) + len(call["function"]["arguments"])
    return n

FIXED_CHARS = 0
def estimate(messages):
    """Roughly how many tokens a request with these messages will be."""
    global FIXED_CHARS
    FIXED_CHARS = len(SYSTEM) + len(json.dumps(TOOLS))
    return int((FIXED_CHARS + chars_in(messages)) * tok_per_char)

def summarize(old):
    """Have the model write up the older part of the conversation. Returns the summary, or '' if it could not."""
    room = context_size() - 1000
    msgs = [dict(m) for m in old]
    for m in msgs:                                    # too big to even re-read: shorten long tool results first
        if estimate(msgs) <= room: break
        if m["role"] == "tool" and len(m["content"]) > 400: m["content"] = m["content"][:300] + "\n[...shortened]"
    while len(msgs) > 2 and estimate(msgs) > room:    # then let go of the very oldest messages
        del msgs[0]
        while msgs and msgs[0]["role"] != "user": del msgs[0]
    ask = ("Before we go on, write a summary of this conversation so far, for your own use later. Cover what I asked for "
           "and why, what you did and found, what was decided, the exact names, numbers, file paths and links that matter, "
           "and anything still unfinished. Plain text, under 300 words. Do not call a tool.")
    body = json.dumps({"model": loaded_model(), "messages": [{"role": "system", "content": SYSTEM}] + mend(msgs) + [{"role": "user", "content": ask}],
                       "tools": TOOLS, "max_tokens": min(700, reply_room()), "temperature": 0.3,
                       "chat_template_kwargs": {"enable_thinking": False}}).encode()
    try:
        req = urllib.request.Request(f"{HOST}/v1/chat/completions", body, {"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=1800) as r:
            return (json.load(r)["choices"][0]["message"].get("content") or "").strip()
    except KeyboardInterrupt: raise
    except Exception:
        return ""

def fold(history, force=False):
    """Make room when the conversation is close to what the model can hold. Changes history in place.
    Returns True if anything was folded."""
    size = context_size()
    budget = size - reply_room() - min(2000, size // 8)
    if force: budget = int(budget * 0.6)
    if estimate(history) <= budget: return False
    users = [i for i, m in enumerate(history) if m["role"] == "user"]
    cut = users[-1] if users else 0                   # the current request and everything after it always stays
    for i in reversed(users[:-1]):                    # plus as many earlier exchanges as fit in a tenth of the room
        if chars_in(history[i:]) * tok_per_char > max(600, size // 10): break
        cut = i
    changed = False
    if cut >= 2:
        sys.stdout.write("\033[?25l")
        wait = Waiting("Tidying up a long conversation")
        try: summary = summarize(history[:cut])
        finally: wait.stop(); sys.stdout.write("\033[?25h"); sys.stdout.flush()
        note = "Summary of our conversation so far (the older messages were folded into this to save room):\n" + \
               (summary or "(it could not be summarized, so the earliest part was dropped)")
        history[:] = [{"role": "user", "content": note}, {"role": "assistant", "content": "Understood. I have that."}] + history[cut:]
        print(f"{DIM}this chat got long, so the older part was folded into a summary to make room{R}\n")
        changed = True
    for m in history:                                 # still too big: one request with many long results. Shorten the oldest
        if estimate(history) <= budget: break
        if m["role"] == "tool" and len(m["content"]) > 600:
            m["content"] = m["content"][:500] + "\n[...shortened to save room]"; changed = True
    return changed

turn_tok = 0   # tokens generated in the current turn, for the summary line
stream_error = ""   # set when the server reports a failure instead of an answer
DOING = {"generate_image": "Writing the image prompt", "write_file": "Writing file", "run_shell": "Writing command", "web_search": "Searching", "fetch_page": "Opening page",
         "read_file": "Opening file", "use_skill": "Loading skill", "remember": "Saving to memory"}

def stream(messages, label="Reading"):
    """One model call. Returns (answer text, tool calls)."""
    model = loaded_model()
    if not model:
        print(f"{DIM}the model server isn't running. Relaunch bxzex-ai{R}"); return "", []
    body = json.dumps({"model": model, "messages": [{"role": "system", "content": SYSTEM}] + mend(messages),
                       "tools": TOOLS, "max_tokens": reply_room(), "temperature": 0.7, "stream": True,
                       "stream_options": {"include_usage": True},
                       "chat_template_kwargs": {"enable_thinking": not fast}}).encode()
    req = urllib.request.Request(f"{HOST}/v1/chat/completions", body, {"Content-Type":"application/json"})
    sys.stdout.write("\033[?25l")  # hide cursor while generating
    wait = Waiting(label)
    global turn_tok, stream_error, tok_per_char
    stream_error = ""
    sent_chars = FIXED_CHARS + chars_in(messages) if estimate(messages) else 0
    plain_text = all(isinstance(m.get("content") or "", str) for m in messages)
    answer=[]; calls={}; phase=None; tn=0; at_start=True; off=random.randrange(len(WORDS)); t0=time.time()

    md = Markdown(prefix=f"{GOLD}●{R} ")

    try:
        try:
            resp = urllib.request.urlopen(req, timeout=1800)
        except urllib.error.HTTPError as e:          # run_turn decides what to do: make room, restart, or give up
            wait.stop(); stream_error = f"server error {e.code}: {e.read().decode('utf-8','ignore')[:300]}"; return "", []
        except Exception as e:
            wait.stop(); print(f"{DIM}[error: {e}]{R}"); return "", []

        for raw in resp:
            line = raw.decode("utf-8","ignore").strip()
            if not line.startswith("data:"): continue
            p = line[5:].strip()
            if p=="[DONE]": break
            try: event = json.loads(p)
            except Exception: continue
            if "error" in event:                       # the server gave up on this request
                err = event["error"]
                stream_error = err.get("message", "error") if isinstance(err, dict) else str(err)
                break
            used = (event.get("usage") or {}).get("prompt_tokens")
            if used and plain_text and sent_chars: tok_per_char = max(0.2, min(0.6, used / sent_chars))
            try: delta = event["choices"][0]["delta"]
            except Exception: continue

            if delta.get("tool_calls") or delta.get("content") or delta.get("reasoning_content"): turn_tok += 1
            for tc in delta.get("tool_calls") or []:
                if wait.stop_ev.is_set():                  # it said something first: bring the status line back while it writes the call
                    if phase == "answer":
                        md.flush_word(); sys.stdout.write(R + ("" if md.col0 else "\n"))
                    sys.stdout.flush()
                    wait = Waiting("Working"); wait.tok = tn
                wait.tok += 1
                slot = calls.setdefault(tc.get("index", 0), {"id": "", "type": "function",
                                                             "function": {"name": "", "arguments": ""}})
                if tc.get("id"): slot["id"] = tc["id"]
                f = tc.get("function") or {}
                if f.get("name") and not slot["function"]["name"]: slot["function"]["name"] = f["name"]
                if f.get("arguments"): slot["function"]["arguments"] += f["arguments"]
                wait.label = DOING.get(slot["function"]["name"], "Working")
                wait.preview = slot["function"]["arguments"][-200:]

            think = delta.get("reasoning_content")
            if think:
                tn += 1
                if show_think:
                    wait.stop()
                    if phase!="think":
                        print(header("Thinking")); phase="think"; at_start=True
                    for ch in think:
                        if at_start: sys.stdout.write(f"  {DIM}{ITAL}"); at_start=False
                        sys.stdout.write(ch)
                        if ch=="\n": sys.stdout.write(R); at_start=True
                    sys.stdout.flush()
                else:   # keep the loader running, just relabel it
                    word = WORDS[(off + int((time.time()-t0)/1.8)) % len(WORDS)]
                    wait.label = word; wait.tok = tn

            content = delta.get("content")
            if content:
                wait.stop()
                if phase=="think":
                    sys.stdout.write(f"{R}\n\n"); phase=None
                if phase!="answer":
                    phase="answer"; at_start=True
                md.feed(content); answer.append(content)
    finally:
        wait.stop(); md.close()
        if phase=="answer" and not md.col0: sys.stdout.write("\n")
        elif phase!="answer": sys.stdout.write(f"{R}\r\033[K")
        sys.stdout.write("\033[?25h")  # restore cursor
        sys.stdout.flush()
    return "".join(answer).strip(), [calls[i] for i in sorted(calls)]

def run_turn(history):
    """Agent loop: keep calling the model until it answers without asking for a tool.
    Anything typed and sent while it works is passed to it as a "by the way" note."""
    if not ensure_server(): return      # e.g. still reloading after an image
    typed.start()
    try:
        global turn_tok
        turn_tok = 0; began = time.time(); retried = made_room = False
        label = "Reading"
        for _ in range(MAX_STEPS):
            if fold(history): label = "Reading"
            text, calls = stream(history, label)
            if stream_error and not text and not calls:
                if not made_room and re.search(r"context|exceed|too (long|large|many)", stream_error, re.I):
                    made_room = True                 # it was fuller than estimated: fold harder and ask again
                    if fold(history, force=True): continue
                if retried:
                    print(f"{DIM}the model failed: {stream_error} Try again, or quit and relaunch.{R}"); return
                retried = True                   # usually the graphics memory got into a bad state: a fresh start clears it
                print(f"{DIM}the model hit an error ({stream_error.rstrip('.')}), restarting it{R}")
                stop_server()
                if not ensure_server(): return
                continue
            if calls:
                if text: print()
                history.append({"role": "assistant", "content": text, "tool_calls": calls})
                for i, call in enumerate(calls):
                    call["id"] = call["id"] or f"call_{len(history)}_{i}"
                    history.append({"role": "tool", "tool_call_id": call["id"], "content": run_tool(call) if whole(call) else CUT_OFF})
                label = "Reading results"
            else:
                history.append({"role": "assistant", "content": text})
            notes = typed.drain()
            if notes:
                print()
                for n in notes: print(f"{GOLD}❯{R} {DIM}btw{R} {n}")
                print()
                history.append({"role": "user", "content": "By the way: " + " ".join(notes)})
                label = "Reading"
            elif not calls:
                took = time.time() - began
                if sys.stdout.isatty() and took >= 1:
                    print(f"\n{DIM}≈ done in {fmt(took)} · {turn_tok} tok{R}")
                return
        print(f"{DIM}paused after {MAX_STEPS} tool steps · type continue to keep going{R}")
    finally:
        typed.stop()

# ---- voice ----
WHISPER = shutil.which("whisper-cli")
VOICE_MODEL = f"{APP_HOME}/models/bxzex-voice.bin"
VOICE_LANG = os.environ.get("BXZEX_VOICE_LANG", "en")

def recorder(wav):
    """Start recording the microphone to a wav file with whatever this system has. Returns (process, stop)."""
    if sys.platform == "darwin" and shutil.which("ffmpeg"):
        p = subprocess.Popen(["ffmpeg", "-loglevel", "error", "-y", "-f", "avfoundation", "-i", ":default",
                              "-ar", "16000", "-ac", "1", wav], stdin=subprocess.PIPE, stderr=subprocess.PIPE)
        def stop():
            try: p.communicate(b"q", timeout=5)          # 'q' lets ffmpeg finish the wav header
            except subprocess.TimeoutExpired: p.kill()
        return p, stop
    for cmd in (["parecord", "--rate=16000", "--channels=1", "--file-format=wav", wav],
                ["pw-record", "--rate", "16000", "--channels", "1", wav],
                ["arecord", "-q", "-f", "S16_LE", "-r", "16000", "-c", "1", wav],
                ["ffmpeg", "-loglevel", "error", "-y", "-f", "pulse", "-i", "default", "-ar", "16000", "-ac", "1", wav]):
        if shutil.which(cmd[0]):
            p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            time.sleep(0.4)
            if p.poll() is not None: continue            # it gave up straight away (no sound system for it): try the next
            def stop():
                p.send_signal(signal.SIGINT)             # these finish the file cleanly on an interrupt
                try: p.wait(timeout=5)
                except subprocess.TimeoutExpired: p.kill()
            return p, stop
    return None, None

def linux_whisper():
    tool = shutil.which("whisper-ctranslate2") or f"{HOME}/.local/bin/whisper-ctranslate2"
    return tool if os.path.exists(tool) else None

def transcribe(wav):
    """Speech to text, on this machine."""
    if WHISPER and os.path.exists(VOICE_MODEL):                                   # Mac engine
        return subprocess.run([WHISPER, "-m", VOICE_MODEL, "-f", wav, "-l", VOICE_LANG, "-nt", "-np"],
                              capture_output=True, text=True, timeout=180).stdout
    tool = linux_whisper()                                                        # Linux engine
    if not tool: return ""
    outdir = tempfile.mkdtemp()
    try:
        cmd = [tool, wav, "--model", "small", "--output_format", "txt", "--output_dir", outdir,
               "--device", "cpu", "--compute_type", "int8", "--verbose", "False"]
        if VOICE_LANG != "auto": cmd += ["--language", VOICE_LANG]
        subprocess.run(cmd, capture_output=True, text=True, timeout=600)
        return " ".join(open(os.path.join(outdir, f), errors="replace").read() for f in os.listdir(outdir) if f.endswith(".txt"))
    finally:
        shutil.rmtree(outdir, ignore_errors=True)

def listen():
    """Record the mic until Enter, transcribe it on this machine, return the text."""
    if not ((WHISPER and os.path.exists(VOICE_MODEL)) or linux_whisper()):
        print(f"{DIM}voice is not installed. Run the installer again to add it.{R}"); return ""
    wav = tempfile.NamedTemporaryFile(suffix=".wav", delete=False).name
    rec, stop = recorder(wav)
    if not rec:
        os.unlink(wav)
        print(f"{DIM}couldn't reach a microphone. Install the recording tool with: sudo apt install pulseaudio-utils"
              f"{' · then allow the microphone for apps in Windows settings' if WSL else ''}{R}"); return ""
    sys.stdout.write("\033[?25l")
    wait = Waiting("Listening, press enter when done")
    try:
        input()
        RAW.write("\033[1A")          # back onto the loader line the Enter moved us off
    except (EOFError, KeyboardInterrupt):
        wait.stop(); rec.kill(); os.unlink(wav); sys.stdout.write("\033[?25h"); print(f"{DIM}cancelled{R}"); return ""
    wait.stop()
    stop()
    wait = Waiting("Transcribing")
    try:
        out = transcribe(wav)
    except Exception:
        out = ""
    finally:
        wait.stop(); sys.stdout.write("\033[?25h"); sys.stdout.flush()
        if os.path.exists(wav): os.unlink(wav)
    text = re.sub(r"[\[(][^\])]*[\])]", " ", out)   # drop [BLANK_AUDIO], (music) and the like
    text = " ".join(text.split())
    if not text: print(f"{DIM}didn't catch anything. Check that the microphone is allowed and not muted{R}")
    return text

