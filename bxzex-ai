def mcp_acts(real, args):
    """Whether a call changes something, and so asks first. Running app tools that only fetch, list or search doesn't."""
    if "EXECUTE" in real.upper():
        slugs = re.findall(r'"tool_slug":\s*"([A-Za-z0-9_]+)"', json.dumps(args))
        return not slugs or not all({*s.upper().split("_")} & READ_VERBS and not {*s.upper().split("_")} & WRITE_VERBS for s in slugs)
    return not READ_ONLY_MCP.search(real)

def mcp_call(name, args):
    server, real = MCP[name]
    acts = mcp_acts(real, args)
    if acts:
        if PLAN: return plan_block()
        shown = json.dumps(args, indent=1)[:3000]
        if not confirm(f"{server}: {real}", shown): return "The user declined this action."
    try: res = mcp_rpc(server, "tools/call", {"name": real, "arguments": args})
    except Exception as e:
        if re.search(r"(?i)session|expired|not found|40[134]", str(e)):   # the server forgot us: connect again once
            mcp_sessions.pop(server, None)
            if server == "composio": renew_composio()
            connect_again(server)
            res = mcp_rpc(server, "tools/call", {"name": real, "arguments": args})
        else: raise
    parts = []
    for item in res.get("content") or []:
        if item.get("type") == "text": parts.append(item.get("text", ""))
        else: parts.append(f"[{item.get('type')}]")
    out = "\n".join(parts) or json.dumps(res)[:4000]
    for url in dict.fromkeys(re.findall(r"https://[^\s\"'<>)\\]+", out)):   # a sign-in link for an app: make it clickable here
        if re.search(r"(?i)connect|auth|oauth|link", url): print(f"  {GOLD}{link(url, 'open this link to connect the app')}{R} {DIM}· {url[:80]}{R}")
    return ("error: " if res.get("isError") else "") + clip(out, OUT_CHARS)

def connect_again(server):
    mcp_rpc(server, "initialize", {"protocolVersion": "2025-03-26", "capabilities": {}, "clientInfo": {"name": "bxzex-ai", "version": VERSION}})

