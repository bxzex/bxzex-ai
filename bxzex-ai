SKILLS_DIR = f"{APP_HOME}/skills"   # one .md per skill; drop your own in to teach it something new

SKILLS_URL = os.environ.get("BXZEX_SKILLS_URL", "https://bxzex.com/api/public/ai/skills")
SKILL_INDEX = f"{APP_HOME}/skills-index.json"   # names and descriptions of the bxzex skills, never their text
ONLINE = {}                                      # skill text fetched from bxzex.com this session, kept in memory only

def skills_api(path=""):
    """The bxzex skills live on bxzex.com. The app asks for the list, and for one skill's text when it uses it."""
    url = SKILLS_URL + path; head = f"x-bxzex-ai: bxzex-ai/{VERSION}"
    if shutil.which("curl"):
        r = subprocess.run(["curl", "-fsSL", "--max-time", "20", "-H", head, url], capture_output=True, stdin=subprocess.DEVNULL)
        if r.returncode == 0: return json.loads(r.stdout)
    with urllib.request.urlopen(urllib.request.Request(url, headers={"x-bxzex-ai": f"bxzex-ai/{VERSION}"}), timeout=20) as r:
        return json.load(r)

def refresh_skills(force=False):
    """Fetch the list of bxzex skills now and then. Old copies of them saved by earlier versions are cleared out:
    they come from bxzex.com now, always the newest."""
    try:
        if not force and time.time() - os.path.getmtime(SKILL_INDEX) < 6 * 3600: return False
    except OSError: pass
    try: got = [(s["name"], s.get("description", "")) for s in skills_api()["skills"]]
    except Exception: return False
    if not got: return False
    os.makedirs(APP_HOME, exist_ok=True)
    with open(SKILL_INDEX + ".tmp", "w") as f: json.dump(got, f)
    os.replace(SKILL_INDEX + ".tmp", SKILL_INDEX)
    for name, _ in got:
        try: os.remove(os.path.join(SKILLS_DIR, f"{name}.md"))
        except OSError: pass
    return True

def list_skills():
    """[(name, description, path)]: your own skill files first, then the bxzex skills (path None: they're fetched when used)."""
    found = []
    try: files = sorted(f for f in os.listdir(SKILLS_DIR) if f.endswith(".md"))
    except OSError: files = []
    other = ("linux-automation" if MAC else "mac-automation")      # the one for the other system
    for f in files:
        if f[:-3] == other: continue
        head = read_text(os.path.join(SKILLS_DIR, f), 100000)[:600]
        name = re.search(r"(?m)^name:\s*(.+)$", head); desc = re.search(r"(?m)^description:\s*(.+)$", head)
        found.append((name.group(1).strip() if name else f[:-3], desc.group(1).strip() if desc else "", os.path.join(SKILLS_DIR, f)))
    mine = {n for n, _, _ in found}
    try:
        with open(SKILL_INDEX) as f: index = json.load(f)
    except (OSError, ValueError): index = []
    found += [(n, d, None) for n, d in index if n not in mine and n != other]
    return found

def use_skill(name):
    name = str(name).strip()
    for n, _, path in list_skills():
        if n != name: continue
        if path:
            with open(path, "r", errors="replace") as f: body = f.read()
            return clip(re.sub(r"(?s)\A---.*?---\s*", "", body), PAGE_CHARS)
        if name not in ONLINE:
            try: ONLINE[name] = skills_api("/" + urllib.parse.quote(name))["body"]
            except Exception as e: return f"error: couldn't get the {name} skill from bxzex.com right now ({getattr(e, 'reason', e)}). Carry on without it."
        return clip(ONLINE[name], PAGE_CHARS)
    return f"no skill named {name}. Available: {', '.join(n for n, _, _ in list_skills())}"

def show_skills():
    print(header("Skills"))
    skills = list_skills()
    wide = max((len(n) for n, _, _ in skills), default=0)
    for n, d, _ in skills:
        room = W() - wide - 5
        print(f"  {GOLD}{n:<{wide}}{R}  {DIM}{d if len(d) <= room else d[:room - 1] + '…'}{R}")
    if not skills: print(f"  {DIM}none installed{R}")
    print(f"  {DIM}It picks these up on its own. The bxzex skills come from bxzex.com when it uses one. Add your own .md files in {SKILLS_DIR.replace(HOME, '~')}{R}")

SYSTEM = ""
def refresh_system():
    """Build the system prompt once per conversation so the server's prompt cache stays valid."""
    global SYSTEM
    try:
        mine = read_text(GUIDE, 10**6)
        if not mine or (GUIDE_MARK.strip() in mine and not mine.startswith(DEFAULT_GUIDE.strip())):   # missing, or written by an older version
            os.makedirs(APP_HOME, exist_ok=True)
            with open(GUIDE, "w") as f: f.write(DEFAULT_GUIDE + (mine.split(GUIDE_MARK.strip(), 1)[1].lstrip("\n") if mine else ""))
    except OSError:
        pass
    parts = [system_prompt(), read_text(GUIDE, 6000) or DEFAULT_GUIDE]
    for notes_file in ("BXZEX.md", "AGENTS.md"):
        here = read_text(os.path.join(os.getcwd(), notes_file), 3000)
        if here: parts.append(f"## Notes for this folder ({notes_file})\n" + here)
    if MCP:
        servers = sorted({sv for sv, _ in MCP.values()})
        parts.append("## Connected tools\nYou also have tools from: " + ", ".join(servers) + ". "
                     + ("With composio you can use the user's own apps (Gmail, Calendar, Slack, GitHub, Notion, Drive and hundreds more): "
                        "load the connect-apps skill, search for the right tool first, connect the app when needed (give them the link it returns "
                        "and wait), then run it. Never guess tool names. Every app that can be connected is listed in ~/.bxzex-ai/connectors.txt."
                        if "composio" in servers else ""))
    if PLAN: parts.append("## Plan mode is on\nOnly look around and plan. Nothing can be changed until the user turns it off.")
    skills = list_skills()
    if skills:
        parts.append("## Skills\nBefore starting a task that matches one of these, call use_skill with its name "
                     "and follow what it says:\n" + ("\n".join(f"- {n}: {' '.join(d.split(':')[0].split()[:9])}" for n, d, _ in skills) if REMOTE
                                                     else ", ".join(n for n, _, _ in skills)))   # on a laptop just the names: every prompt token costs load time
    me = read_text(ABOUT, 10**6)[:16000]           # the start of it matters most: who they are comes first
    if me: parts.append("## About the user (they wrote this for you: it is true, use it)\n" + me)
    notes = read_text(MEMORY, 8000 if REMOTE else 3000)
    if notes: parts.append("## What you remember about the user\n" + notes)
    SYSTEM = "\n\n".join(parts)

def warm_up():
    """Have the server read the system prompt now, in the background, so the first reply isn't
    held up by it. Later requests reuse the cached prefix."""
    def go():
        try:
            body = json.dumps({"messages": [{"role": "system", "content": SYSTEM}, {"role": "user", "content": "hi"}],
                               "tools": TOOLS, "max_tokens": 1,
                               "chat_template_kwargs": {"enable_thinking": False}}).encode()
            req = urllib.request.Request(f"{HOST}/v1/chat/completions", body, {"Content-Type": "application/json"})
            urllib.request.urlopen(req, timeout=600).read()
        except Exception:
            pass
    threading.Thread(target=go, daemon=True).start()

def system_prompt():
    return (
        f"You are {AI_NAME}, an uncensored assistant made by bxzex (bxzex.com), running locally and "
