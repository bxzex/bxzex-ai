UPDATE_URL = os.environ.get("BXZEX_UPDATE_URL", "https://raw.githubusercontent.com/bxzex/bxzex-ai/main")
END_MARK = "# ---- end of bxzex-ai ----"
update_note = ""      # shown in the status line once a newer version has been put in place
reload_ready = False  # a newer version is in place: the app reloads itself at the prompt and carries on

class Reload(Exception):
    """Raised at the prompt once an update is in place. Carries whatever was typed in the box."""
PARTS = 2 if MAC else 3   # which round of installer downloads this version expects (3: the repaired Linux voice engine)
if "parts" in load_config() and int(load_config().get("parts") or 0) < PARTS:
    update_note = "one more step to finish this update: type /update full"

def newer(a, b):
    """True if version a is higher than b."""
    num = lambda v: [int(x) for x in re.findall(r"\d+", v)][:3]
    return num(a) > num(b)

def fetch(path):
    return http_get(f"{UPDATE_URL}/{path}")

update_lock = threading.Lock()   # the check at startup and /update never download at the same time

def check_update(quiet=True):
    """Look for a newer version and put it in place, then the app reloads itself at the prompt.
    Only the app, the server launcher and the skills change here: the big model files are never touched."""
    if quiet:
        if not update_lock.acquire(blocking=False): return False
        try: return get_update(True, None)
        finally: update_lock.release()
    sys.stdout.write("\033[?25l")
    wait = Waiting("Checking for updates")
    try:
        with update_lock:                            # if the check at startup is mid-download, this waits for it
            if reload_ready:
                wait.stop(); print(f"{GOLD}●{R} {BOLD}Updated{R} {DIM}· reloading, your chat stays{R}"); return True
            return get_update(False, wait)
    finally:
        wait.stop(); sys.stdout.write("\033[?25h"); sys.stdout.flush()

def get_update(quiet, wait):
    global update_note
    def say(text):
        if wait: wait.stop()
        if not quiet: print(f"{DIM}{text}{R}")
    try:
        latest = fetch("VERSION").split()
        if not latest or not re.fullmatch(r"\d+(\.\d+){1,2}", latest[0]): say("couldn't read the latest version number, try /update again"); return False
        if not newer(latest[0], VERSION):
            say(f"you have the latest version, v{VERSION}"); return False
        if wait: wait.label = f"Downloading v{latest[0]}"
        here = os.path.dirname(os.path.realpath(__file__))
        from concurrent.futures import ThreadPoolExecutor
        with ThreadPoolExecutor(8) as pool:                    # every file at once: one by one took half a minute
            app, server, installer, apps = pool.map(fetch, ["bxzex-ai", "bxzex-server", "install.sh", "connectors.txt"])
            compile(app, "bxzex-ai", "exec")                   # never install something that doesn't even parse
            if f'VERSION = "{latest[0]}"' not in app or not app.rstrip().endswith(END_MARK):   # cut off, or the download servers still hold the old copy
                say(f"v{latest[0]} is on its way but hasn't reached the download servers yet. Try /update again in a few minutes"); return False
        if not server.startswith("#!"):
            say("part of the download came back broken, nothing was changed. Try /update again"); return False
        if apps.startswith("# Apps"):
            with open(f"{APP_HOME}/connectors.txt", "w") as f: f.write(apps)
        for name, text in (("bxzex-server", server), ("bxzex-ai", app)):
            tmp = os.path.join(here, f".{name}.new")
            with open(tmp, "w") as f: f.write(text)
            os.chmod(tmp, 0o755); os.replace(tmp, os.path.join(here, name))
        global reload_ready
        restart_phone()
        update_note = f"updated to v{latest[0]} · reloading"; reload_ready = True
        if len(latest) > 1 and latest[1].isdigit() and int(latest[1]) > int(load_config().get("parts", 0) or 0):
            update_note += " · new features to download: /update full"
        if wait: wait.stop()
        if not quiet: print(f"{GOLD}●{R} {BOLD}Updated to v{latest[0]}{R} {DIM}· reloading, your chat stays{R}")
        return True
    except Exception:
        say("couldn't reach the update server right now, try /update again in a minute")
        return False

def full_update():
    """Run the installer again: it skips what is already there and adds anything new."""
    box.unpin()
    script = tempfile.NamedTemporaryFile(suffix=".sh", delete=False).name
    try:
        with open(script, "w") as f: f.write(fetch("install.sh"))
        fd = sys.stdin.fileno(); keys = termios.tcgetattr(fd) if COOKED else None
        if keys: termios.tcsetattr(fd, termios.TCSADRAIN, COOKED)     # the installer asks questions: normal typing for it
        try: subprocess.run(["bash", script])
        finally:
            if keys: termios.tcsetattr(fd, termios.TCSADRAIN, keys)
    finally:
        os.unlink(script)
    print(f"{DIM}quit and open bxzex-ai again to use the new version{R}")

