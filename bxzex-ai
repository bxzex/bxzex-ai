        + (", or it is in About the user below. That section is from them: you know them, so use it when it helps." if os.path.exists(ABOUT) else "."))

# what the loader says while each tool works, so nothing ever looks frozen (images draw their own)
RUNNING = {"run_shell": "Running", "check_job": "Checking the job", "web_search": "Searching the web", "fetch_page": "Opening page", "read_file": "Reading",
           "list_files": "Looking through files", "search_files": "Searching files", "write_file": "Saving", "edit_file": "Saving",
           "use_skill": "Loading skill", "schedule_task": "Scheduling", "test_page": "Checking the page", "safari": "Working in Safari", "imessage": "Working in Messages"}
tool_wait = None; tool_label = ""
LAST_TOOLS = []     # (call shown, full output) for this reply, for ctrl-o

def show_last():
    if not LAST_TOOLS: print(f"{DIM}no tool output yet in this reply{R}"); return
    for title, out in LAST_TOOLS[-6:]:
        print(f"{TEAL}◆{R} {BOLD}{title}{R}")
        lines = out.splitlines()
        for l in lines[:300]: print(f"  {DIM}│{R} {l}")
        if len(lines) > 300: print(f"  {DIM}│ … {len(lines) - 300} more lines{R}")
    print()

def run_tool(call):
    fn = call["function"]; name = fn["name"]
    try:
        args = json.loads(fn["arguments"] or "{}")
    except Exception:
        return "error: arguments were not valid JSON"
    if not isinstance(args, dict): return "error: arguments must be a JSON object with the tool's named fields"
    shown = " ".join(str(v) for k, v in args.items() if k != "content").replace("\n", " ")
    print(f"{TEAL}◆{R} {BOLD}{name}{R}{DIM}({shown[:W()-len(name)-6]}){R}")
    if name not in TOOL_FUNCS and name not in MCP: return f"error: no tool named {name}"
    blocked = hooks_before(name, args)
    if blocked:
        LAST_TOOLS.append((f"{name}({shown[:W() - len(name) - 6]})", blocked)); print(f"  {DIM}└ blocked by your hook{R}\n"); return blocked
    global tool_wait, tool_label
    tool_label = RUNNING.get(name, "Working with " + MCP[name][0] if name in MCP else "")
    if tool_label: sys.stdout.write("\033[?25l"); tool_wait = Waiting(tool_label)
    try:
        out = mcp_call(name, args) if name in MCP else str(TOOL_FUNCS[name](**args))
    except Exception as e:
        out = f"error: {e}"
    finally:
        if tool_wait: tool_wait.stop(); tool_wait = None
        tool_label = ""; sys.stdout.write("\033[?25h"); sys.stdout.flush()
    out += hooks_after(name, args, out)
    lines = [l for l in out.strip().splitlines() if l.strip()]
    first = lines[0] if lines else "(empty)"
    LAST_TOOLS.append((f"{name}({shown[:W() - len(name) - 6]})", out))
    more = f" (+{len(lines)-1} lines · ctrl-o)" if len(lines) > 1 else ""
    print(f"  {DIM}└ {first[:W()-len(more)-6]}{more}{R}\n")
    return out

