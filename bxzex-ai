    return ""

def choose_device(arg=""):
    """/device shows where the model runs; /device cpu or /device gpu switches and reloads it."""
    if REMOTE:
        print(f"{GOLD}●{R} {BOLD}Running on the cloud GPU{R} {DIM}· set in {CONFIG.replace(HOME, '~')} (\"remote\"){R}"); return
    now = "cpu" if os.environ.get("BXZEX_DEVICE", load_config().get("device", "gpu")) == "cpu" else "gpu"
    want = {"cpu": "cpu", "processor": "cpu", "gpu": "gpu", "graphics": "gpu"}.get(arg.strip().lower())
    card = graphics()
    if not want:
        if arg.strip(): print(f"{DIM}/device cpu or /device gpu{R}"); return
        where = "the processor (CPU)" if now == "cpu" or not card else f"{card} (GPU)"
        print(f"{GOLD}●{R} {BOLD}Running on {where}{R}")
        if card: print(f"  {DIM}/device {'gpu' if now == 'cpu' else 'cpu'} switches to {card if now == 'cpu' else 'the processor, which is slower but leaves the graphics card free'}{R}")
        else: print(f"  {DIM}no supported graphics card was found when this was installed. If you add one, run /update full and it is picked up{R}")
        return
    if want == "gpu" and not card:
        print(f"{DIM}no supported graphics card was found when this was installed. If you add one, run /update full and it is picked up{R}"); return
    if os.environ.get("BXZEX_DEVICE"): print(f"{DIM}BXZEX_DEVICE is set for this window and wins over this setting{R}")
    save_config(device=want)
    if want == now: print(f"{DIM}already on the {'processor' if want == 'cpu' else 'graphics card'}{R}"); return
    print(f"  {GOLD}●{R} {'processor (CPU)' if want == 'cpu' else card + ' (GPU)'} {DIM}· saved · reloading the model{R}")
    wait = Waiting("Stopping the model")
    try: stop_server()
    finally: wait.stop()
    ensure_server()

