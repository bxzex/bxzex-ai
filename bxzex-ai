    return "file://" + urllib.parse.quote(path)
# measured on a 24GB M4 Air: fast is about a minute, hd about two and a half
SHAPES = {"fast": {"square": (640, 640), "portrait": (512, 768), "landscape": (768, 512)},
          "hd":   {"square": (768, 768), "portrait": (640, 960), "landscape": (960, 640)}}
STEPS = {"fast": 6, "hd": 8}

def png_pixels(path):
    """Read a plain 8-bit PNG with nothing but the standard library. Returns (width, height, bytes per pixel, rows)."""
    import struct, zlib
    with open(path, "rb") as f: d = f.read()
    if d[:8] != b"\x89PNG\r\n\x1a\n": raise ValueError("not a png")
    i = 8; raw = b""; w = h = bpp = 0
    while i < len(d):
        n, kind = struct.unpack(">I4s", d[i:i + 8]); body = d[i + 8:i + 8 + n]; i += 12 + n
        if kind == b"IHDR":
            w, h, depth, color, _, _, lace = struct.unpack(">IIBBBBB", body)
            if depth != 8 or lace or color not in (0, 2, 4, 6): raise ValueError("unsupported png")
            bpp = {0: 1, 2: 3, 4: 2, 6: 4}[color]
        elif kind == b"IDAT": raw += body
    raw = zlib.decompress(raw); stride = w * bpp; rows = []; prev = bytearray(stride)
    for y in range(h):
        kind = raw[y * (stride + 1)]; line = bytearray(raw[y * (stride + 1) + 1:(y + 1) * (stride + 1)])
        if kind == 1:
            for x in range(bpp, stride): line[x] = (line[x] + line[x - bpp]) & 255
        elif kind == 2:
            for x in range(stride): line[x] = (line[x] + prev[x]) & 255
        elif kind == 3:
            for x in range(stride): line[x] = (line[x] + ((line[x - bpp] if x >= bpp else 0) + prev[x]) // 2) & 255
        elif kind == 4:
            for x in range(stride):
                a = line[x - bpp] if x >= bpp else 0; b = prev[x]; c2 = prev[x - bpp] if x >= bpp else 0
                pa = abs(b - c2); pb = abs(a - c2); pc = abs(a + b - 2 * c2)
                line[x] = (line[x] + (a if pa <= pb and pa <= pc else b if pb <= pc else c2)) & 255
        rows.append(line); prev = line
    return w, h, bpp, rows

def preview_png(path, cols):
    """The same half-block picture, for systems without the Mac image tool."""
    try:
        iw, ih, bpp, rows = png_pixels(path)
        w = min(cols, W() - 4); h = max(2, round(w * ih / iw) // 2 * 2)
        def px(x, y):
            line = rows[min(ih - 1, int((y + 0.5) * ih / h))]; i = min(iw - 1, int((x + 0.5) * iw / w)) * bpp
            r, g, b = (line[i], line[i + 1], line[i + 2]) if bpp >= 3 else (line[i],) * 3
            return 16 + 36 * round(r / 51) + 6 * round(g / 51) + round(b / 51)
        return ["".join(f"\033[38;5;{px(x, y)};48;5;{px(x, y + 1)}m▀" for x in range(w)) + R for y in range(0, h - 1, 2)]
    except Exception:
        return []

def preview(path, cols=44):
    """A small picture of the image drawn with half-block characters, so it shows up right in the chat."""
    if not shutil.which("sips"): return preview_png(path, cols)
    tmp = tempfile.NamedTemporaryFile(suffix=".bmp", delete=False).name
    try:
        info = subprocess.run(["sips", "-g", "pixelWidth", "-g", "pixelHeight", path], capture_output=True, text=True).stdout
        m = re.findall(r"pixel(?:Width|Height): (\d+)", info)
        if len(m) != 2: return []
        w = min(cols, W() - 4); h = max(2, round(w * int(m[1]) / int(m[0])) // 2 * 2)
        if subprocess.run(["sips", "-s", "format", "bmp", "-z", str(h), str(w), path, "--out", tmp], capture_output=True).returncode: return []
        with open(tmp, "rb") as f: d = f.read()
        off = int.from_bytes(d[10:14], "little"); bw = int.from_bytes(d[18:22], "little", signed=True)
        bh = int.from_bytes(d[22:26], "little", signed=True); bpp = int.from_bytes(d[28:30], "little") // 8
        stride = (bw * bpp + 3) // 4 * 4
        def px(x, y):
            row = (abs(bh) - 1 - y) if bh > 0 else y            # most bitmaps are stored bottom row first
            i = off + row * stride + x * bpp
            b, g, r = d[i], d[i + 1], d[i + 2]
            return 16 + 36 * round(r / 51) + 6 * round(g / 51) + round(b / 51)
        return ["".join(f"\033[38;5;{px(x, y)};48;5;{px(x, y + 1)}m▀" for x in range(bw)) + R for y in range(0, abs(bh) - 1, 2)]
    except Exception:
        return []
    finally:
        if os.path.exists(tmp): os.unlink(tmp)

PAINTING = f"{APP_HOME}/painting.lock"   # exists while an image is being made, so nothing reloads the chat model under it

def painting():
    try: return time.time() - os.path.getmtime(PAINTING) < 1200
    except OSError: return False

def stop_server():
    """Free the chat model's memory. The image model needs it: both do not fit in 24GB together."""
    if REMOTE: return                         # the model is on the cloud card, nothing to free here
    port = HOST.rsplit(":", 1)[1]
    if shutil.which("lsof"):
        pids = [int(x) for x in subprocess.run(["lsof", "-ti", f"tcp:{port}", "-sTCP:LISTEN"], capture_output=True, text=True).stdout.split() if x.isdigit()]
    else:                                     # Linux without lsof: look through the process list ourselves
        pids = []
        for name in os.listdir("/proc") if os.path.isdir("/proc") else []:
            if not name.isdigit(): continue
            try:
                with open(f"/proc/{name}/cmdline", "rb") as f: args = f.read().split(b"\0")
            except OSError: continue
            if b"llama-server" in os.path.basename(args[0]) and port.encode() in args: pids.append(int(name))
    def alive():
        out = []
        for pid in pids:
            if server_proc and server_proc.pid == pid and server_proc.poll() is not None: continue   # ours, and finished
            try:
                with open(f"/proc/{pid}/stat") as f:
                    if f.read().rsplit(")", 1)[-1].split()[0] == "Z": continue                         # finished, only its record is left
            except (OSError, IndexError): pass
            try: os.kill(pid, 0); out.append(pid)
            except OSError: pass
        return out
    for pid in pids:
        try: os.kill(pid, 15)
        except OSError: pass
    for _ in range(60):                       # wait until the memory is really given back
        if not alive(): return
        time.sleep(0.25)
    for pid in alive():
        try: os.kill(pid, 9)
        except OSError: pass
    time.sleep(0.5)

PAINT = f"{APP_HOME}/models/bxzex-paint"     # the same image model packaged for the Linux engine

def paint_engine():
    """The image engine used on Linux, if it is installed."""
    for root, _, files in os.walk(f"{APP_HOME}/imgengine"):
        if "sd-cli" in files: return os.path.join(root, "sd-cli")
    return None

def generate_image(prompt, shape="square", quality="fast", wait_for_chat=True):
    quality = quality.strip().lower() if quality.strip().lower() in SHAPES else "fast"
    w, h = SHAPES[quality].get(shape.strip().lower(), SHAPES[quality]["square"])
    prompt = " ".join(prompt.split())
    mac_engine = os.path.isdir(IMAGE_MODEL) and os.path.exists(IMAGE_BIN)
    engine = None if mac_engine else paint_engine()
    if not mac_engine and not (engine and os.path.exists(f"{PAINT}/model.gguf")):
        return "Image generation is not installed. Run the installer again to add it."
    out = f"{pictures_dir()}/{time.strftime('%Y-%m-%d %H-%M-%S')}.png"
    try: loras = sorted(os.path.join(LORAS, f) for f in os.listdir(LORAS) if f.endswith(".safetensors"))
    except OSError: loras = []
    scale = os.environ.get("BXZEX_LORA_SCALE", "0.8")
    env = None
    if mac_engine:
        cmd = [IMAGE_BIN, "--model", IMAGE_MODEL, "--low-ram", "--prompt", prompt,
               "--width", str(w), "--height", str(h), "--steps", str(STEPS[quality]), "--output", out]
        if loras: cmd += ["--lora-paths", *loras, "--lora-scales", *[scale] * len(loras)]
    else:                                                                        # Linux engine
        styles = "".join(f" <lora:{os.path.basename(f)[:-len('.safetensors')]}:{scale}>" for f in loras)
        cmd = [engine, "--diffusion-model", f"{PAINT}/model.gguf", "--vae", f"{PAINT}/vae.safetensors",
               "--llm", f"{PAINT}/text.gguf", "-p", prompt + styles, "--cfg-scale", "1.0", "--diffusion-fa",
               "--steps", str(STEPS[quality]), "-W", str(w), "-H", str(h), "-s", "-1", "-o", out]
        if loras: cmd += ["--lora-model-dir", LORAS]
        env = dict(os.environ, LD_LIBRARY_PATH=f"{os.path.dirname(engine)}:{os.environ.get('LD_LIBRARY_PATH', '')}")
    sys.stdout.write("\033[?25l")
    wait = Waiting("Making room")
    err = ""
    try:
        while painting(): wait.label = "Waiting for another image to finish"; time.sleep(1)
        open(PAINTING, "w").close()
        stop_server()
        wait.label = "Painting"
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=env)
        while True:                                   # the generator reports its steps on stderr
            chunk = proc.stdout.read1(256).decode("utf-8", "ignore")
            if not chunk: break
            err = (err + chunk)[-2000:]
            step = [x for x in re.findall(r"(\d+)/(\d+)", chunk) if x[1] == str(STEPS[quality])]
            if step: wait.label = f"Painting, step {step[-1][0]} of {step[-1][1]}"
        proc.wait()
    except KeyboardInterrupt:
        proc.kill(); wait.stop()
        if os.path.exists(PAINTING): os.remove(PAINTING)
        ensure_server(block=False); raise
    finally:
        wait.stop(); sys.stdout.write("\033[?25h"); sys.stdout.flush()
        if os.path.exists(PAINTING): os.remove(PAINTING)
    ensure_server(block=wait_for_chat)                # bring the chat model back
    if proc.returncode != 0 or not os.path.exists(out):
        last = [l for l in err.splitlines() if l.strip()]
        return f"error: the image could not be made ({last[-1][:200] if last else 'no details'})"
    for row in preview(out): print("  " + row)
    print(f"  {GOLD}{link(file_link(out), out.replace(HOME, '~'))}{R} {DIM}· {'cmd' if MAC else 'ctrl'}-click to open{R}")
    return f"saved to {out.replace(HOME, '~')} ({w}x{h}" + (f", {len(loras)} style file(s) applied)" if loras else ")")

