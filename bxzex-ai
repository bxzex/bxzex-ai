CHATS = f"{APP_HOME}/chats"     # one .json per conversation, saved after every turn and every 30 seconds
chat_file = None

def plain(content):
    """Message text without embedded image data, so saved chats stay small."""
    if isinstance(content, str): return content
    return " ".join(p.get("text", "") if p.get("type") == "text" else "[image]" for p in content).strip()

last_saved = None

def chat_data():
    msgs = [dict(m, content=plain(m.get("content") or "")) for m in list(history)]
    title = next((m["content"] for m in msgs if m["role"] == "user"), "")[:80]
    return json.dumps({"title": title, "messages": msgs})

def save_chat():
    global chat_file, last_saved
    if not history: return
    try:
        os.makedirs(CHATS, exist_ok=True)
        if not chat_file: chat_file = f"{CHATS}/{time.strftime('%Y-%m-%d_%H-%M-%S')}.json"
        data = chat_data()
        if data == last_saved and os.path.exists(chat_file): return    # nothing new: never overwrite another window's newer save
        with open(chat_file + ".tmp", "w") as f: f.write(data)
        os.replace(chat_file + ".tmp", chat_file)                       # all or nothing, so a crash mid-save can't break the chat
        last_saved = data
    except OSError:
        pass

def autosave():
    """Saves the conversation every 30 seconds, so a closed window or a crash loses nothing."""
    while True:
        time.sleep(30); save_chat()

def list_chats():
    try: files = sorted((f for f in os.listdir(CHATS) if f.endswith(".json")), reverse=True)
    except OSError: return []
    out = []
    for f in files[:50]:
        try:
            with open(os.path.join(CHATS, f)) as fh: d = json.load(fh)
        except Exception:
            continue
        out.append((os.path.join(CHATS, f), f[:16].replace("_", " ").replace("-", ":", 3).replace(":", "-", 2), d.get("title", ""), d.get("messages", [])))
    return out

def menu(rows, at=0, hint="↑↓ to move · enter to pick · esc to cancel"):
    """A list you move through with the arrow keys and pick from with Enter. Returns the row's number, or None for Esc.
    rows are (label, detail). Numbers jump straight to a row."""
    if not (sys.stdin.isatty() and RAW.isatty()) or not rows: return None
    fd = sys.stdin.fileno(); saved = termios.tcgetattr(fd)
    fits = max(3, shutil.get_terminal_size((90, 30)).lines - Box.ROWS - 4)     # rows that fit above the input box
    shown = min(len(rows), fits) + 1
    def draw(first=False):
        w = W(); out = "" if first else f"\033[{shown}A"
        top = min(max(0, at - (shown - 1) // 2), len(rows) - (shown - 1))
        for i, (label, detail) in list(enumerate(rows))[top:top + shown - 1]:
            room = max(0, w - len(label) - 6)
            tail = f"  {DIM}{detail[:room]}{R}" if detail and room > 8 else ""
            out += f"\r\033[K  {GOLD}❯ {BOLD}{label}{R}{tail}\n" if i == at else f"\r\033[K    {label}{tail}\n"
        more = f" · {at + 1} of {len(rows)}" if len(rows) > shown - 1 else ""
        RAW.write(out + f"\r\033[K  {DIM}{(hint + more)[:w - 2]}{R}\n"); RAW.flush()
    try:
        tty.setcbreak(fd, termios.TCSANOW); RAW.write("\033[?25l"); draw(True)
        while True:
            buf = finish_escapes(fd, os.read(fd, 64).decode("utf-8", "ignore"))
            while buf:
                m = ESC_KEY.match(buf)
                key = m.group(0) if m else buf[0]; buf = buf[len(key):]
                if key in ("\x1b[A", "\x1bOA", "k"): at = (at - 1) % len(rows)
                elif key in ("\x1b[B", "\x1bOB", "j", "\t"): at = (at + 1) % len(rows)
                elif key in ("\r", "\n"): return at
                elif key in ("\x1b", "\x03", "\x04", "q"): return None
                elif key.isdigit() and 1 <= int(key) <= len(rows): at = int(key) - 1; draw(); return at
            draw()
    except KeyboardInterrupt:
        return None
    finally:
        RAW.write(f"\033[{shown}A\r\033[J\033[?25h"); RAW.flush()     # the list goes away; what was picked is printed after
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)

def chat_rows(chats):
    return [(when, f"{title}  · {len(msgs)} msgs") for _, when, title, msgs in chats]

def start_menu():
    """On opening: continue the last chat, start a new one, or pick an earlier one."""
    chats = list_chats()
    if not chats: return
    if not sys.stdin.isatty(): open_chat(0); return
    _, when, title, msgs = chats[0]
    print(f"{GOLD}●{R} {BOLD}Where do you want to start?{R}")
    rows = [("Continue from last save", f"{when} · {title}"), ("New chat", "start fresh, the old one stays in /history")]
    if len(chats) > 1: rows.append(("Earlier chats…", f"{len(chats) - 1} more"))
    pick = menu(rows, hint="↑↓ to move · enter to pick · esc for a new chat")
    RAW.write("\033[1A\r\033[K"); RAW.flush()                        # the question goes too
    if pick == 0: open_chat(0)
    elif pick == 2: open_chat()
    else: print(f"{GOLD}●{R} {BOLD}New chat{R} {DIM}· /history has the earlier ones{R}")

def open_chat(pick=None):
    """Continue an earlier conversation. pick=0 takes the most recent without asking."""
    global history, chat_file
    chats = [c for c in list_chats() if c[0] != chat_file]
    if not chats:
        if pick is None: print(f"{DIM}no earlier chats yet{R}")
        return
    if pick is None:
        print(header("History"))
        pick = menu(chat_rows(chats))
        if pick is None: print(f"  {DIM}cancelled{R}"); return
    path, when, title, msgs = chats[pick]
    global last_saved
    history = msgs; chat_file = path; last_saved = chat_data()      # just opened: nothing to save until it changes
    try: saved = time.strftime("%b %d at %-I:%M %p", time.localtime(os.path.getmtime(path)))
    except OSError: saved = when
    print(f"{GOLD}●{R} {BOLD}Continuing from last save{R} {DIM}{saved} · {len(msgs)} messages{R}")
    for m in [m for m in msgs if m["role"] in ("user", "assistant") and m.get("content")][-2:]:
        mark = f"{GOLD}❯{R}" if m["role"] == "user" else f"{GOLD}●{R}"
        text = " ".join(m["content"].split())
        print(f"{mark} {DIM}{text[:W() * 2 - 8]}{'…' if len(text) > W() * 2 - 8 else ''}{R}")
    if not REMOTE: print(f"{DIM}it has to re-read the conversation, so the next reply starts slower{R}")

