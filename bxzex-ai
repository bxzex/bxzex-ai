            with open(path, "r", errors="replace") as f: body = f.read()
            return clip(re.sub(r"(?s)\A---.*?---\s*", "", body), PAGE_CHARS)
    return f"no skill named {name}. Available: {', '.join(n for n, _, _ in list_skills())}"

