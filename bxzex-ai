def loaded_model():
    try:
        with urllib.request.urlopen(f"{HOST}/v1/models", timeout=600 if REMOTE else 3) as r:
            d = json.load(r)["data"]
        return d[0]["id"] if d else None
    except Exception:
        return None

server_proc = None

def ensure_server(block=True):
    """Start the model server if it isn't already running. A cold start reads ~15GB off disk.
    block=False starts it and returns straight away; the next call waits for it."""
    global server_proc, ctx_size
    ctx_size = 0                                   # a restarted model may hold a different amount
    try:
        if os.path.exists(PAINTING) and not painting(): os.remove(PAINTING)   # a leftover lock from a crash
    except OSError: pass
    if REMOTE: return wake_remote(block)
    if loaded_model(): return True
    if os.path.exists(f"{APP_HOME}/painting.lock") and painting():     # another window is making an image
        wait = Waiting("Waiting for an image to finish")
        try:
            while painting(): time.sleep(1)
        finally:
            wait.stop()
    if not (server_proc and server_proc.poll() is None):       # not already on its way up
        launcher = os.path.join(os.path.dirname(os.path.realpath(__file__)), "bxzex-server")
        if not os.path.exists(launcher):
            print(f"{DIM}server launcher missing: {launcher}{R}"); return False
        os.makedirs(APP_HOME, exist_ok=True)
        log = open(os.path.join(APP_HOME, "server.log"), "w")
        server_proc = subprocess.Popen([launcher], stdout=log, stderr=log, stdin=subprocess.DEVNULL, start_new_session=True)
    if not block: return True
    sys.stdout.write("\033[?25l")
    wait = Waiting("Loading model")
    try:
        while server_proc.poll() is None:
            if loaded_model(): return True
            time.sleep(0.5)
    except KeyboardInterrupt:
        pass
    finally:
        wait.stop(); sys.stdout.write("\033[?25h"); sys.stdout.flush()
    print(f"{DIM}the model server didn't start. See {APP_HOME.replace(HOME, '~')}/server.log{R}"); return False

def wake_remote(block=True):
    """The cloud card sleeps when idle; the first request wakes it, which takes up to a minute or two."""
    if not block:
        threading.Thread(target=loaded_model, daemon=True).start(); return True
    sys.stdout.write("\033[?25l")
    wait = Waiting("Waking the cloud GPU")
    try:
        if loaded_model(): return True
    except KeyboardInterrupt:
        pass
    finally:
        wait.stop(); sys.stdout.write("\033[?25h"); sys.stdout.flush()
    print(f"{DIM}the cloud GPU didn't answer. Check \"remote\" and \"remote_key\" in {CONFIG.replace(HOME, '~')}{R}"); return False

