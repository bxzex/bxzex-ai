class _RemoteKey(urllib.request.HTTPRedirectHandler):
    """Sends the key with requests to the remote model only, never to web pages the tools open.
    Also follows the 303 the cloud sends while a long request is still waiting for its card."""
    def http_request(self, req):
        if REMOTE_KEY and req.full_url.startswith(HOST): req.add_unredirected_header("Authorization", f"Bearer {REMOTE_KEY}")
        return req
    https_request = http_request
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        new = super().redirect_request(req, fp, code, msg, headers, newurl)
        if new is not None and code == 303 and req.data is not None and newurl.startswith(HOST):
            new = urllib.request.Request(newurl, req.data, dict(req.header_items()), method="POST")   # keep the request as it was
        return new
