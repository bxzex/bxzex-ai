def git_branch():
    """The git branch of this folder, looked up at most every few seconds (the status line redraws on every key)."""
    global _branch
    here = os.getcwd()
    if _branch[0] != here or time.time() - _branch[1] > 5:
        try:
            b = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"], capture_output=True, text=True, timeout=1, stdin=subprocess.DEVNULL)
            name = b.stdout.strip() if b.returncode == 0 else ""
        except Exception: name = ""
        _branch = (here, time.time(), f"⎇ {name}" if name and name != "HEAD" else "")
    return _branch[2]

def custom_commands():
