def checker_python():
    """A Python that has the page checker (Playwright), or "" if none does yet."""
    for py in (sys.executable, f"{BROWSER_HOME}/bin/python"):
        if os.path.exists(py) and subprocess.run([py, "-c", "import playwright.sync_api"], capture_output=True).returncode == 0: return py
    return ""

def install_checker():
    if not confirm("install the page checker", f"python3 -m venv {BROWSER_HOME.replace(HOME, '~')}\npip install playwright\n"
                   "playwright install chromium webkit\n\nThe browsers for checking sites as a phone, tablet and desktop: about 400 MB, once."):
        return ""
    global tool_wait
    for cmd in ([sys.executable, "-m", "venv", BROWSER_HOME], [f"{BROWSER_HOME}/bin/pip", "install", "-q", "playwright"],
                [f"{BROWSER_HOME}/bin/python", "-m", "playwright", "install", "chromium", "webkit"]):
        if tool_wait: tool_wait.label = "Installing the page checker"
        r = subprocess.run(cmd, capture_output=True, text=True, stdin=subprocess.DEVNULL)
        if r.returncode != 0: raise RuntimeError(f"couldn't install the page checker: {(r.stderr or r.stdout).strip()[-300:]}")
    if not MAC: subprocess.run([f"{BROWSER_HOME}/bin/python", "-m", "playwright", "install-deps"], capture_output=True)   # needs sudo; tried quietly
    return f"{BROWSER_HOME}/bin/python"

def test_page(url, devices="phone,tablet,desktop", steps="", see="true"):
    """Open a page as real devices would (Safari's engine for iPhone and iPad), measure what breaks and take screenshots."""
    url = str(url).strip()
    if os.path.exists(os.path.expanduser(url)):
        url = "file://" + os.path.abspath(os.path.expanduser(url)) + ("/index.html" if os.path.isdir(os.path.expanduser(url)) else "")
    elif not re.match(r"[a-z]+://", url): url = ("http://" if re.match(r"(localhost|127\.|0\.0\.0\.0)", url) else "https://") + url
    want = [d.strip().lower() for d in re.split(r"[,\s]+", str(devices)) if d.strip()] or ["phone", "tablet", "desktop"]
    unknown = [d for d in want if d not in DEVICES]
    if unknown: return f"error: unknown device {', '.join(unknown)}. Use any of: {', '.join(DEVICES)}"
    py = checker_python() or install_checker()
    if not py: return "The user declined installing the page checker."
    folder = os.path.join(pictures_dir(), "checks"); os.makedirs(folder, exist_ok=True)
    host = re.sub(r"[^a-z0-9]+", "-", urllib.parse.urlparse(url).netloc.lower() or "file").strip("-")
    shots = os.path.join(folder, f"{host}-{datetime.datetime.now():%Y%m%d-%H%M%S}")
    job = {"url": url, "devices": {d: DEVICES[d] for d in dict.fromkeys(want)}, "steps": [s for s in str(steps).lstrip("\0").splitlines() if s.strip()], "shots": shots}
    with tempfile.NamedTemporaryFile("w", suffix=".py", delete=False) as f: f.write(PAGE_CHECK); script = f.name
    try:
        r = subprocess.run([py, script, json.dumps(job)], capture_output=True, text=True, timeout=60 + 60 * len(job["devices"]), stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return "error: the page took too long to check"
    finally:
        os.unlink(script)
    try: found = json.loads(r.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError): return f"error: the page checker failed: {(r.stderr or r.stdout).strip()[-600:]}"
    if any("Executable doesn't exist" in g.get("error", "") for g in found) and not str(steps).startswith("\0"):
        if not confirm("download the browsers for checking pages", f"{py} -m playwright install chromium webkit\n\nAbout 400 MB, once."):
            return "The user declined downloading the browsers."
        r = subprocess.run([py, "-m", "playwright", "install", "chromium", "webkit"], capture_output=True, text=True, stdin=subprocess.DEVNULL)
        if r.returncode != 0: return f"error: couldn't download the browsers: {(r.stderr or r.stdout).strip()[-300:]}"
        return test_page(url, devices, "\0" + str(steps), see)
    report = []
    for g in found:
        head = f"## {g['device']} ({g['profile']}, {'Safari engine' if g['engine'] == 'webkit' else 'Chrome engine'})"
        if g.get("error"): report.append(f"{head}\ncouldn't open it: {g['error']}"); continue
        problems = []
        if g.get("status") and g["status"] >= 400: problems.append(f"the page answered {g['status']}")
        if g["page_width"] > g["width"] + 1: problems.append(f"sideways scroll: the page is {g['page_width']}px wide on a {g['width']}px screen. Too wide: " + "; ".join(g["wide"]))
        if not g["viewport_meta"]: problems.append("no <meta name=viewport>: phones will show it zoomed out")
        if g["small_taps"]: problems.append(f"{g['small_taps']} buttons or links under the 24px minimum to tap, like " + "; ".join(g["small_tap_examples"]))
        if g["tiny_text"]: problems.append(f"{g['tiny_text']} bits of text under 12px, like " + "; ".join(g["tiny_examples"]))
        if g.get("edge"): problems.append("touching the screen edge, with no side margin (use 16px or more): " + "; ".join(g["edge"]))
        if g["broken"]: problems.append("broken images: " + ", ".join(g["broken"]))
        if g["covers"]: problems.append("fixed or sticky parts cover over 30% of the screen: " + ", ".join(g["covers"]))
        if g["console_errors"]: problems.append("console errors: " + " | ".join(g["console_errors"]))
        if g["failed_requests"]: problems.append("failed requests: " + " | ".join(g["failed_requests"]))
        if g.get("step_errors"): problems.append("steps that failed: " + " | ".join(g["step_errors"]))
        report.append(f"{head}\n\"{g['title']}\" · {g['width']}x{g['height']} screen · page {g['page_height']}px tall · loaded in {g['load_seconds']}s\n"
                      + ("\n".join(f"- {p_}" for p_ in problems) if problems else "- no layout problems found")
                      + f"\nscreenshot: {g['shot']} · whole page: {g['full_shot']}")
        put_line(f"  {DIM}{link(file_link(g['full_shot']), g['device'] + ' screenshot')}{R}")
        if str(see).lower() != "false": PENDING_SHOTS.append((g["device"], g["shot"]))
    return f"Checked {url}\n\n" + "\n\n".join(report) + ("\n\nThe screenshots of the first screen follow, so look at them too: spacing, overlap, "
                                                          "cut-off text, things that look wrong, and every line of no-ai-slop's Never list (like a headline word in the accent color)." if PENDING_SHOTS else "")

# ---- your phone: talk to it from Telegram, get scheduled reports there, and OK its actions with a tap ----
TG_API = os.environ.get("BXZEX_TELEGRAM_API", "https://api.telegram.org")
PHONE = None            # set while it's answering a message from the phone: questions and OKs go there as buttons
PHONE_QUEUE = []        # messages that came in while it was waiting on a button
PHONE_LABEL = "com.bxzex.ai.phone"

def tg(method, token=None, timeout=30, **params):
    token = token or (load_config().get("phone") or {}).get("token", "")
    url = f"{TG_API}/bot{token}/{method}"; body = json.dumps(params)
    if shutil.which("curl"):
        r = subprocess.run(["curl", "-sS", "--max-time", str(timeout + 10), "-H", "Content-Type: application/json", "-d", "@-", url],
                           input=body, capture_output=True, text=True)
        got = json.loads(r.stdout or "{}")
    else:
        with urllib.request.urlopen(urllib.request.Request(url, body.encode(), {"Content-Type": "application/json"}), timeout=timeout + 10) as r:
            got = json.load(r)
    if not got.get("ok"): raise RuntimeError(got.get("description") or "Telegram didn't answer")
    return got["result"]

def phone_send(text, **extra):
    """Send to your phone, in pieces Telegram accepts. Returns the last message sent."""
    conf = load_config().get("phone") or {}
    if not conf.get("chat"): return None
    text = text.strip() or "(empty)"; last = None
    for i in range(0, len(text), 3900):
        last = tg("sendMessage", chat_id=conf["chat"], text=text[i:i + 3900], disable_web_page_preview=True,
                  **(extra if i + 3900 >= len(text) else {}))
    return last

def phone_choose(question, choices, detail=""):
    """Buttons on the phone. Waits up to 15 minutes for a tap and returns the choice's number, or None."""
    nonce = f"{random.randrange(10**8)}"
    sent = phone_send(f"{question}\n\n{detail[:1800]}" if detail else question,
                      reply_markup={"inline_keyboard": [[{"text": c[:40], "callback_data": f"{nonce}:{i}"}] for i, c in enumerate(choices)]})
    conf = load_config().get("phone") or {}; offset = conf.get("offset", 0); end = time.time() + 900
    while time.time() < end:
        try: ups = tg("getUpdates", offset=offset, timeout=25, allowed_updates=["message", "callback_query"])
        except Exception: time.sleep(3); continue
        for u in ups:
            offset = u["update_id"] + 1
            cb = u.get("callback_query")
            if cb and str(cb.get("data", "")).startswith(nonce + ":") and cb["message"]["chat"]["id"] == conf["chat"]:
                pick = int(cb["data"].split(":")[1])
                try:
                    tg("answerCallbackQuery", callback_query_id=cb["id"])
                    tg("editMessageReplyMarkup", chat_id=conf["chat"], message_id=sent["message_id"], reply_markup={"inline_keyboard": []})
                    phone_send(f"→ {choices[pick]}")
                except Exception: pass
                save_config(phone=dict(load_config().get("phone") or {}, offset=offset))
                return pick
            if u.get("message"): PHONE_QUEUE.append(u)
        save_config(phone=dict(load_config().get("phone") or {}, offset=offset))
    phone_send("No answer in 15 minutes, so I skipped it.")
    return None

def phone_photo(file_id):
