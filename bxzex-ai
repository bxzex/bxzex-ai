def reload_app(typed_text=""):
    """Start the new version in this same window, on the same chat, with the same settings. Nothing is lost."""
    save_chat(); box.unpin()
    if COOKED:
        try: termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, COOKED)
        except termios.error: pass
    sys.stdout.flush()
    stop_jobs()
    state = {"chat": chat_file or "", "fast": fast, "think": show_think, "allow": allow_all, "typed": typed_text, "plan": PLAN}
    try:
        os.execve(sys.executable, [sys.executable, os.path.abspath(__file__)], dict(os.environ, BXZEX_RELOAD=json.dumps(state)))
    except OSError:
        keys_mode(); print(f"{DIM}couldn't reload by itself: quit and open bxzex-ai again to use the new version{R}")

def close_open_calls():
    """After a stop or an error: keep the work done so far; only close calls that never got a result."""
    answered = {m.get("tool_call_id") for m in history if m["role"] == "tool"}
    for m in list(history):
        for call in m.get("tool_calls") or []:      # not "c": that name is the colour function every loader uses
            if call.get("id") not in answered:
                history.append({"role": "tool", "tool_call_id": call.get("id"), "content": "Stopped by the user before this ran."})

def rewind():
    """Go back to an earlier message: the chat is cut there and the message comes back into the box to change and send again."""
    global spoken
    picks = [(i, m) for i, m in enumerate(history) if m["role"] == "user" and isinstance(m.get("content"), (str, list))
             and not plain(m["content"]).startswith(("(", "By the way", SUMMARY_HEAD))][-20:][::-1]
    if not picks: print(f"{DIM}nothing to go back to yet{R}"); return
    print(header("Go back to"))
    at = menu([(" ".join(plain(m["content"]).split())[:W() - 10], "") for _, m in picks], hint="↑↓ to move · enter to go back to it · esc to cancel")
    if at is None: print(f"  {DIM}cancelled{R}"); return
    i, m = picks[at]
    mark = m.get("_undo", len(UNDO)); changed = len(UNDO) - mark
    put_back = False
    if changed > 0:
        how = menu([("Go back in the chat only", "files stay as they are now"),
                    ("Go back and put files back too", f"undoes {changed} file change{'s' if changed > 1 else ''} made after it")])
        if how is None: print(f"  {DIM}cancelled{R}"); return
        put_back = how == 1
    if put_back:
        while len(UNDO) > mark:
            path, old = UNDO.pop()
            try:
                if old is None: os.remove(path)
                else:
                    with open(path, "w") as f: f.write(old)
            except OSError: pass
    del history[i:]
    spoken = plain(m["content"])
    print(f"{GOLD}●{R} {BOLD}Went back{R} {DIM}· {'files put back · ' if put_back else ''}your message is in the box: change it and press Enter{R}")
    save_chat()

def turn(text):
    print()
    hush()
    LAST_TOOLS.clear()
    history.append(dict(user_message(text), _undo=len(UNDO)))
    try:
        run_turn(history)
        maybe_learn()                                # every few messages, what's new about the user is saved in the background
    except KeyboardInterrupt:
        close_open_calls(); print(f"\n{DIM}stopped · everything done so far is kept{R}")
    except Exception as e:                           # never lose the app or the chat over one bad step
        log_error(type(e), e, e.__traceback__); close_open_calls()
        print(f"\n{DIM}something went wrong ({e.__class__.__name__}: {str(e)[:120]}) · the chat is kept · details in {ERROR_LOG.replace(HOME, '~')}{R}")
    save_chat()

def own_command(cmd):
    """!command: run it yourself. The output shows here and the assistant sees it too."""
    print(f"{TEAL}◆{R} {BOLD}{cmd}{R}")
    p = subprocess.Popen(cmd, shell=True, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                         text=True, errors="replace", start_new_session=True)
    got = []
    try:
        for line in p.stdout: got.append(line); sys.stdout.write(f"  {line}"); sys.stdout.flush()
        p.wait()
    except KeyboardInterrupt:
        try: os.killpg(p.pid, 9)
        except OSError: pass
        got.append("[stopped]\n")
    out = "".join(got)
    print(f"  {DIM}└ exit code {p.returncode}{R}")
    history.append({"role": "user", "content": f"(I ran this myself: `{cmd}`)\nexit code {p.returncode}\n{clip(out, OUT_CHARS)}"})

