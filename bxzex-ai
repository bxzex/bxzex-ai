def flying(el, cols, speed=70):
    """The big DeLorean crossing the screen: nose-first to the left, then turned around and back."""
    span = cols + ART_W
    step = int(el * speed) % (2 * span)
    if step < span: art, x = DELOREAN, cols - step
    else:           art, x = DELOREAN_BACK, (step - span) - ART_W
