FLAME = [0.0] * 12
def flame(el, n=12):
    """A row of flickering flames: hot and bright at the tips, the theme color at the base."""
    bars = " ▁▂▃▄▅▆▇█"
    out = []
    for i in range(n):
        # a slow wave moving along the row, plus flicker, eased so it licks instead of jumping
        want = 0.55 + 0.3 * math.sin(el * 5 + i * 0.9) + 0.25 * math.sin(el * 9.5 - i * 1.7) + random.uniform(-0.25, 0.25)
        FLAME[i] += (max(0.05, min(1.0, want)) - FLAME[i]) * 0.5
        h = FLAME[i]
        tone = HI if h > 0.85 else T[4] if h > 0.65 else T[3] if h > 0.4 else T[2]
        out.append(f"{c(tone)}{bars[max(1, round(h * 8))]}")
    return "".join(out) + R

