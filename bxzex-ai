GUIDE_MARK = "Anything written below this line is from the user. Follow it.\n"

def read_text(path, limit):
    try:
        with open(os.path.expanduser(path), "r", errors="replace") as f: text = f.read().strip()
    except OSError:
        return ""
    return text[-limit:] if len(text) > limit else text

def remember(note):
    note = " ".join(note.split()).lstrip("- ").strip()
    if not note: return "nothing to save"
    if note.lower() in read_text(MEMORY, 10**6).lower(): return "already saved"
    os.makedirs(APP_HOME, exist_ok=True)
    with open(MEMORY, "a") as f: f.write(f"- {note}\n")
    return "saved"

# ---- learning about the user in the background ----
# Every few messages it reads back the recent ones and saves what is new and lasting about the user, so it knows them
# better over time without being told to remember. Only on a cloud card: on a laptop the extra pass would slow replies.
LEARN_EVERY = 3
learned = []          # notes saved since the last reply, shown dimly before the next one
learning = threading.Lock()
user_turns = 0

def learn(msgs):
    if not learning.acquire(blocking=False): return
    try:
        talk = []
        for m in msgs[-16:]:
            text = plain(m.get("content") or "") if m["role"] in ("user", "assistant") else ""
            if text and not text.startswith(SUMMARY_HEAD): talk.append(f"{m['role'].upper()}: {text[:1500]}")
        if not talk: return
        known = (read_text(ABOUT, 10**6)[:16000] + "\n" + read_text(MEMORY, 8000)).strip()
        ask = ("Here is what is already known about the user:\n" + (known or "(nothing yet)") + "\n\nHere is the latest part of a chat:\n"
               + "\n".join(talk) + "\n\nList NEW lasting facts about the user that this chat shows and that are not already known: "
               "who they are, their work, projects, goals, plans, people in their life, tools, likes and dislikes, how they want things done. "
               "Only facts about the user, stated or clearly shown by them, not guesses and not things about the topic. Skip temporary "
               "situations and one-off events (a deadline today, a mood, something that happened once): keep what will still be true next month. One short sentence "
               "each, on its own line starting with '- '. At most 4. If there is nothing new and lasting, reply with NONE.")
        body = json.dumps({"model": MODEL_ID or loaded_model(), "messages": [{"role": "user", "content": ask}], "max_tokens": 250,
                           "temperature": 0.2, "chat_template_kwargs": {"enable_thinking": False}}).encode()
        req = urllib.request.Request(f"{HOST}/v1/chat/completions", body, {"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=300) as r:
            out = json.load(r)["choices"][0]["message"].get("content") or ""
        for line in out.splitlines():
            line = line.strip()
            if line.startswith("- ") and 8 < len(line) < 240 and remember(line[2:]) == "saved": learned.append(line[2:].strip())
    except Exception:
        pass
    finally:
        learning.release()

learn_due = False

def maybe_learn():
    """Every few messages, mark that it's time to learn. It runs once they have been idle at the prompt for a while,
    because the cloud card answers one request at a time: a learning pass must never sit in front of their next reply."""
    global user_turns, learn_due
    user_turns += 1
    if REMOTE and user_turns % LEARN_EVERY == 0 and load_config().get("learn", True): learn_due = True

def learn_if_idle(idle_for):
    global learn_due
    if learn_due and idle_for > 20:
        learn_due = False
        threading.Thread(target=learn, args=(list(history),), daemon=True).start()

