def phone_loop():
    """Runs on its own (started by the system): answers what you send from your phone, one message at a time."""
    global PHONE, history
    conf = load_config().get("phone") or {}
    if not conf.get("chat"): print("the phone isn't set up: run /phone in the app"); return
    chat_path = f"{APP_HOME}/phone-chat.json"
    try:
        with open(chat_path) as f: history = json.load(f)
    except (OSError, ValueError): history = []
    if load_config().get("mcp"): connect_mcp()
    refresh_skills(); refresh_system()
    offset = conf.get("offset", 0)
    while True:
        if PHONE_QUEUE: ups = [PHONE_QUEUE.pop(0)]
        else:
            try: ups = tg("getUpdates", offset=offset, timeout=50, allowed_updates=["message", "callback_query"])
            except Exception as e:
                if "Unauthorized" in str(e): print("the bot key stopped working: run /phone again"); return
                time.sleep(5); continue
        for u in ups:
            offset = max(offset, u["update_id"] + 1)
            save_config(phone=dict(load_config().get("phone") or {}, offset=offset))
            msg = u.get("message") or {}
            if not msg or msg.get("chat", {}).get("id") != conf["chat"]: continue      # only you: anyone else is ignored
            text = (msg.get("text") or msg.get("caption") or "").strip()
            if msg.get("photo"):
                try: text = (text + " " + phone_photo(msg["photo"][-1]["file_id"])).strip()
                except Exception: pass
            if not text: continue
            if text in ("/start", "/help"):
                phone_send(f"{AI_NAME} on your computer. Write anything and it works on it there. /new starts a fresh chat."); continue
            if text == "/new":
                history = []; phone_send("New chat."); continue
            PHONE = conf["chat"]
            stop = threading.Event()
            def typing():
                while not stop.is_set():
                    try: tg("sendChatAction", chat_id=conf["chat"], action="typing", timeout=5)
                    except Exception: pass
                    stop.wait(4)
            threading.Thread(target=typing, daemon=True).start()
            start = len(history)
            try:
                history.append(user_message(text)); run_turn(history)
                reply = "\n\n".join(m["content"] for m in history[start:] if m["role"] == "assistant" and isinstance(m.get("content"), str) and m["content"].strip())
            except Exception as e:
                log_error(type(e), e, e.__traceback__); close_open_calls(); reply = f"Something went wrong: {e}"
            finally:
                stop.set(); PHONE = None
            PENDING_SHOTS.clear()
            try: phone_send(reply or "Done.")
            except Exception as e: log_error(type(e), e, e.__traceback__)
            try:
                with open(chat_path, "w") as f: json.dump(history[-200:], f)
            except OSError: pass

def phone_service(on=True):
    """Keep the phone bridge running in the background (launchd on a Mac, a user service on Linux)."""
    if os.environ.get("BXZEX_NO_TICKER"): return ""
    me = [sys.executable, os.path.abspath(__file__), "--phone"]
    env = {"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "HOME": HOME}
    if "BXZEX_HOME" in os.environ: env["BXZEX_HOME"] = APP_HOME
    try:
        if MAC:
            import plistlib
            plist = f"{HOME}/Library/LaunchAgents/{PHONE_LABEL}.plist"; where = f"gui/{os.getuid()}"
            subprocess.run(["launchctl", "bootout", f"{where}/{PHONE_LABEL}"], capture_output=True)
            if not on:
                if os.path.exists(plist): os.remove(plist)
                return ""
            os.makedirs(os.path.dirname(plist), exist_ok=True)
            with open(plist, "wb") as f:
                f.write(plistlib.dumps({"Label": PHONE_LABEL, "ProgramArguments": me, "RunAtLoad": True, "KeepAlive": True, "ThrottleInterval": 20,
                                        "EnvironmentVariables": env, "StandardOutPath": f"{APP_HOME}/phone.log", "StandardErrorPath": f"{APP_HOME}/phone.log"}))
            r = subprocess.run(["launchctl", "bootstrap", where, plist], capture_output=True, text=True)
            return "" if r.returncode == 0 else f"couldn't start it in the background: {r.stderr.strip()[:160]}"
        unit = f"{HOME}/.config/systemd/user/bxzex-phone.service"
        if not shutil.which("systemctl"): return "this computer has no systemd: start it yourself with  bxzex-ai --phone &"
        if not on:
            subprocess.run(["systemctl", "--user", "disable", "--now", "bxzex-phone"], capture_output=True)
            if os.path.exists(unit): os.remove(unit)
            return ""
        os.makedirs(os.path.dirname(unit), exist_ok=True)
        with open(unit, "w") as f:
            f.write("[Unit]\nDescription=bxzex-ai phone bridge\n\n[Service]\nExecStart=" + " ".join(shlex.quote(x) for x in me)
                    + "\nRestart=always\nRestartSec=20\n" + "".join(f"Environment={k}={v}\n" for k, v in env.items()) + "\n[Install]\nWantedBy=default.target\n")
        subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
        r = subprocess.run(["systemctl", "--user", "enable", "--now", "bxzex-phone"], capture_output=True, text=True)
        return "" if r.returncode == 0 else f"couldn't start it: {r.stderr.strip()[:160]}"
    except Exception as e:
        log_error(type(e), e, e.__traceback__); return f"couldn't start it: {e}"

def restart_phone():
