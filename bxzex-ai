def list_skills():
    """[(name, description, path)] from the frontmatter of each skill file."""
    found = []
    try: files = sorted(f for f in os.listdir(SKILLS_DIR) if f.endswith(".md"))
    except OSError: return found
    for f in files:
        head = read_text(os.path.join(SKILLS_DIR, f), 100000)[:600]
        name = re.search(r"(?m)^name:\s*(.+)$", head); desc = re.search(r"(?m)^description:\s*(.+)$", head)
        found.append((name.group(1).strip() if name else f[:-3], desc.group(1).strip() if desc else "", os.path.join(SKILLS_DIR, f)))
    return found

def use_skill(name):
    for n, _, path in list_skills():
        if n == name.strip():
            with open(path, "r", errors="replace") as f: body = f.read()
            return clip(re.sub(r"(?s)\A---.*?---\s*", "", body), PAGE_CHARS)
    return f"no skill named {name}. Available: {', '.join(n for n, _, _ in list_skills())}"

