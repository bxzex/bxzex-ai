import atexit, codecs, signal
resized = False
def _on_resize(*_):
    global resized
    resized = True
signal.signal(signal.SIGWINCH, _on_resize)

COMMANDS = [("/v", "speak instead of typing"), ("/color", "pick a color theme"), ("/skills", "list skills"),
            ("/memory", "what it remembers · /memory clear"), ("/image", "make a picture · /image hd portrait a red fox"), ("/btw", "add a note, no reply"),
            ("/history", "past chats, pick one to continue"), ("/resume", "continue the last chat"),
            ("/fast", "toggle answering without thinking first"), ("/think", "show or hide its thinking"),
            ("/device", "run on the graphics card or the processor · /device cpu"),
            ("/update", "get the newest version · /update full adds new downloads"), ("/reset", "start a new conversation"), ("/help", "this list"), ("exit", "quit")]
past = []   # earlier inputs, for the up arrow
LITE = load_config().get("size") == "lite"     # the lighter build of the model, for computers with less memory

def status_text(buf, working=False):
    if buf.startswith("/"):
        hits = [f"{n} {d}" for n, d in COMMANDS if n.startswith(buf.split()[0])]
        if hits: return "  " + "   ".join(hits)
    if working: return "  working · type and press Enter to add a note · ctrl-c to stop"
    if update_note: return f"  {update_note}"
    lite = " · lite" if LITE else ""
    return f"  bxzex-ai v{VERSION}{lite} · {THEME} · fast {'on' if fast else 'off'} · {os.getcwd().replace(HOME, '~')} · /help"

class Box:
    """Keeps the input box on the last four rows. Everything else scrolls in the area above it,
    so the box stays put while a reply streams."""
    ROWS = 4
    def __init__(self): self.on = False; self.h = 0; self.size = None
    def pin(self):
        if self.on or not (RAW.isatty() and sys.stdin.isatty()): return
        size = shutil.get_terminal_size((90, 30)); self.h = size.lines
        if self.h < 12: return
        # make room, then limit scrolling to the rows above the box (setting the region moves the cursor, so save it)
        RAW.write("\n" * self.ROWS + f"\033[{self.ROWS}A\0337\033[1;{self.h - self.ROWS}r\0338")
        self.on = True; self.size = (size.columns, size.lines); self.draw()
    def fit(self):
        """If the window changed size, wipe the screen and print the conversation again for the new size.
        Guessing where things moved to is not reliable, redrawing is."""
        size = shutil.get_terminal_size((90, 30))
        if (size.columns, size.lines) == self.size or size.lines < 12: return False
        self.size = (size.columns, size.lines); self.h = size.lines
        lock = getattr(sys.stdout, "lock", None)
        if lock: lock.acquire()
        try:
            past_output = sys.stdout.replay() if hasattr(sys.stdout, "replay") else ""
            RAW.write(f"\033[r\033[H\033[2J\033[3J\033[1;{self.h - self.ROWS}r\033[H{past_output}\0337"); RAW.flush()
        finally:
            if lock: lock.release()
        return True
    def frame(self, text, pos, working):
        w = W(); top = self.h - self.ROWS + 1; room = max(4, w - 3)
        start = max(0, pos - room)
        st = status_text(text, working)[:w]
        rule = f"{DIM}{'─' * w}{R}"
        s = (f"\033[{top};1H\033[J{rule}\033[{top + 1};1H{GOLD}❯{R} {text[start:start + room]}"
             f"\033[{top + 2};1H{rule}\033[{top + 3};1H{DIM}{st}{R}")
        return s, 3 + pos - start
    def draw(self, text="", pos=0, working=True):
        """Redraw while output is streaming: the cursor goes back to where the output was."""
        if not self.on: return
        self.fit()
        s, _ = self.frame(text, pos, working)
        RAW.write("\0337" + s + "\0338"); RAW.flush()
    def focus(self, text, pos):
        """Redraw at the prompt: the cursor stays in the box."""
        self.fit()
        s, col = self.frame(text, pos, False)
        RAW.write(f"{s}\033[{self.h - self.ROWS + 2};{col}H"); RAW.flush()
    def unpin(self):
        if not self.on: return
        self.on = False
        RAW.write(f"\0337\033[r\033[{self.h - self.ROWS + 1};1H\033[J\0338\033[?25h"); RAW.flush()

box = Box()
atexit.register(box.unpin)

def ask(prefill=""):
    """Read a message in the pinned box. Typing, arrows, history and paste are handled here,
    and the box follows the window when it is resized."""
    global resized
    if not sys.stdin.isatty():
        line = sys.stdin.readline()
        if not line: raise EOFError
        return line.strip()
    box.pin()
    if not box.on:                       # window too small for the box: plain prompt
        return input(f"\n{GOLD}❯{R} ").strip()
    box.fit()                            # the window may have been resized while it was busy
    fd = sys.stdin.fileno(); saved = termios.tcgetattr(fd)
    buf = list(prefill); pos = len(buf); at = len(past); draft = ""; pasting = False
    dec = codecs.getincrementaldecoder("utf-8")("ignore")
    print()
    tty.setcbreak(fd)
    RAW.write("\0337\033[?2004h\033[?25h")   # remember where the conversation left off; bracketed paste on

    def leave():
        RAW.write("\033[?2004l\0338"); RAW.flush()      # back to where the conversation left off
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        box.draw("", 0, working=True)

    try:
        box.focus("", 0) if not buf else box.focus("".join(buf), pos)
        while True:
            try:
                ready, _, _ = select.select([fd], [], [], 0.15)
            except InterruptedError:
                ready = []
            except KeyboardInterrupt:
                if buf: buf = []; pos = 0; box.focus("", 0); continue    # first ctrl-c clears the line
                raise
            if resized: resized = False; box.focus("".join(buf), pos)
            if not ready: continue
            data = dec.decode(os.read(fd, 4096)); i = 0; done = False
            while i < len(data):
                ch = data[i]
                if ch == "\x1b":
                    rest = data[i:]
                    if rest.startswith("\x1b[200~"): pasting = True; i += 6; continue
                    if rest.startswith("\x1b[201~"): pasting = False; i += 6; continue
                    m = re.match(r"\x1b\[[0-9;]*[A-Za-z~]|\x1bO[A-Za-z]", rest)
                    if not m:                          # a lone Esc clears the line
                        if len(rest) == 1 or rest[1] not in "[O": buf = []; pos = 0
                        i += 1; continue
                    key = m.group(0); i += len(key)
                    if key in ("\x1b[D", "\x1bOD"): pos = max(0, pos - 1)
                    elif key in ("\x1b[C", "\x1bOC"): pos = min(len(buf), pos + 1)
                    elif key in ("\x1b[H", "\x1bOH", "\x1b[1~"): pos = 0
                    elif key in ("\x1b[F", "\x1bOF", "\x1b[4~"): pos = len(buf)
                    elif key == "\x1b[3~": del buf[pos:pos + 1]
                    elif key in ("\x1b[A", "\x1bOA") and at > 0:
                        if at == len(past): draft = "".join(buf)
                        at -= 1; buf = list(past[at]); pos = len(buf)
                    elif key in ("\x1b[B", "\x1bOB") and at < len(past):
                        at += 1; buf = list(past[at] if at < len(past) else draft); pos = len(buf)
                    continue
                i += 1
                if ch in "\r\n":
                    if pasting: buf.insert(pos, " "); pos += 1
                    else: done = True; break
                elif ch in "\x7f\b":
                    if pos: del buf[pos - 1]; pos -= 1
                elif ch == "\x04":
                    if not buf: raise EOFError
                elif ch == "\x01": pos = 0
                elif ch == "\x05": pos = len(buf)
                elif ch == "\x15": del buf[:pos]; pos = 0
                elif ch == "\x0b": del buf[pos:]
                elif ch == "\x17":
                    j = pos
                    while j and buf[j - 1] == " ": j -= 1
                    while j and buf[j - 1] != " ": j -= 1
                    del buf[j:pos]; pos = j
                elif ch == "\t": buf.insert(pos, " "); pos += 1
                elif ch >= " ": buf.insert(pos, ch); pos += 1
            if done: break
            box.focus("".join(buf), pos)
    except BaseException:
        leave(); raise
    leave()
    text = "".join(buf).strip()
    if text:
        if not past or past[-1] != text: past.append(text)
        print(f"{GOLD}❯{R} {BOLD}{text}{R}")
    return text

