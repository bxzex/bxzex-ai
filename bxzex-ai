def clip(s, n):
    return s if len(s) <= n else s[:n] + f"\n[...cut, {len(s)-n} more chars]"

def page_text(raw):
    raw = re.sub(r"(?is)<(script|style|noscript|svg|head|nav|footer|form)\b.*?</\1>", " ", raw)
    raw = re.sub(r"(?i)<(br|/p|/div|/li|/h[1-6]|/tr)\b[^>]*>", "\n", raw)
    raw = html.unescape(re.sub(r"(?s)<[^>]+>", " ", raw))
    raw = re.sub(r"[ \t\r\f\v]+", " ", raw)
    return re.sub(r"\n\s*\n+", "\n", raw).strip()

def http_get(url):
    # curl, not urllib: this Python has no CA bundle installed, curl uses the system one
    p = subprocess.run(["curl", "-sL", "--compressed", "--max-time", "25", "--max-filesize", "3000000",
                        "-A", UA["User-Agent"], url], capture_output=True)
    if p.stdout: return p.stdout.decode("utf-8", "ignore")
    try:                                             # second try with Python's own downloader
        with urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=25) as r:
            return r.read(3_000_000).decode("utf-8", "ignore")
    except Exception:
        raise RuntimeError(f"could not load {url}")

def web_search(query):
    page = http_get("https://html.duckduckgo.com/html/?q=" + urllib.parse.quote_plus(query))
    hits = re.findall(r'(?s)class="result__a"[^>]*href="([^"]+)"[^>]*>(.*?)</a>.*?class="result__snippet"[^>]*>(.*?)</a>', page)
    out = []
    for href, title, snip in hits[:6]:
        href = html.unescape(href)
        url = urllib.parse.parse_qs(urllib.parse.urlparse(href).query).get("uddg", [href])[0]
        out.append(f"{page_text(title)}\n{url}\n{page_text(snip)}")
    return "\n\n".join(out) or "no results"

def fetch_page(url):
    if not re.match(r"https?://", url): url = "https://" + url
    return clip(page_text(http_get(url)), PAGE_CHARS)

def read_choice(spots):
    """Read one keypress, or a mouse click on one of the buttons on the current line.
    spots maps a key to the (first, last) columns of its button."""
    if not sys.stdin.isatty(): return ""
    fd = sys.stdin.fileno(); saved = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        RAW.write("\033[6n"); RAW.flush()                         # where the buttons are: the terminal answers ESC[row;colR
        row, buf = 0, ""
        while select.select([fd], [], [], 0.3)[0]:
            buf += os.read(fd, 32).decode("utf-8", "ignore")
            m = re.search(r"\x1b\[(\d+);\d+R", buf)
            if m: row = int(m.group(1)); buf = buf[:m.start()] + buf[m.end():]; break
        RAW.write("\033[?1000h\033[?1006h"); RAW.flush()           # clicks arrive as ESC[<button;col;rowM
        while True:
            if not buf: buf = os.read(fd, 64).decode("utf-8", "ignore")
            if buf[0] in ("\x03", "\x04"): raise KeyboardInterrupt
            m = re.match(r"\x1b\[<(\d+);(\d+);(\d+)([Mm])", buf)
            if m:
                buf = buf[m.end():]
                b, x, y, press = int(m.group(1)), int(m.group(2)), int(m.group(3)), m.group(4) == "M"
                if press and b == 0 and (not row or y == row):
                    for key, (a, z) in spots.items():
                        if a <= x <= z: return key
                continue
            if buf[0] == "\x1b":                                  # another key's escape sequence: ignore it
                m = re.match(r"\x1b\[[0-9;]*[A-Za-z~]|\x1bO[A-Za-z]|\x1b", buf); buf = buf[m.end():]; continue
            return buf[0].lower()
    finally:
        RAW.write("\033[?1006l\033[?1000l"); RAW.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)

def read_key():
    """Read one keypress. Arrow keys and other escape sequences come back as a single token
    instead of echoing their raw codes. Letters come back lowercased."""
    if not sys.stdin.isatty(): return ""
    fd = sys.stdin.fileno(); saved = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        ch = os.read(fd, 1).decode("utf-8", "ignore")
        if ch == "\x1b":                               # swallow the rest of an escape sequence (arrows, etc.)
            while select.select([fd], [], [], 0.02)[0]: os.read(fd, 1)
            return "\x1b"
        if ch in ("\x03", "\x04"): raise KeyboardInterrupt
        return ch.lower()
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)

# Things that can destroy work or change the system. These ask every time, even after "always this session".
RISKY = re.compile(r"""(?ix)
      (^|[;&|`(\s]) (sudo|doas|rm|rmdir|shred|dd|mkfs\S*|fdisk|parted|diskutil|shutdown|reboot|halt|poweroff
                     |killall|pkill|kill|chown|chmod|launchctl|systemctl|crontab|passwd|truncate) (\s|$)
    | \bgit\s+(push\b.*(--force|\s-f\b)|reset\s+--hard|clean\b)
    | \b(curl|wget)\b[^|;]*\|\s*(sudo\s+)?(ba|z|da)?sh\b
    | \bfind\b.*\s-delete\b | >\s*/dev/(sd|disk|nvme|rdisk) | :\(\)\s*\{ """)
SENSITIVE = re.compile(r"/(\.ssh|\.gnupg|\.aws|\.config|Library|\.zshrc|\.zprofile|\.bashrc|\.bash_profile|\.profile|\.gitconfig|\.netrc)(/|$)"
                       r"|^/(etc|usr|bin|sbin|System|boot|var|mnt/[a-z]/Windows)/")

def confirm(what, detail, always_ask=False):
    global allow_all
    if allow_all and not always_ask: return True
    if not sys.stdin.isatty(): return False
    busy = typed.th is not None
    typed.stop()                      # hand the keyboard back for the question
    sys.stdout.write("\033[?25h")
    print(f"{GOLD}?{R} {BOLD}Allow: {what}{R}")
    for line in detail.splitlines()[:12]: print(f"  {DIM}│ {line[:W()-6]}{R}")
    buttons = [("y", " y  yes "), ("n", " n  no ")] + ([] if always_ask else [("a", " a  always allow ")])
    line, col, spots = f"  {GOLD}❯{R} ", 5, {}
    for key, label in buttons:
        line += f"\033[7m{label}{R}  "; spots[key] = (col, col + len(label) - 1); col += len(label) + 2
    if always_ask: line += f"{DIM}this kind always asks{R}  "
    sys.stdout.write(line + f"{DIM}click or press a key{R}  "); sys.stdout.flush()
    try:
        a = read_choice(spots)
    except (EOFError, KeyboardInterrupt):
        a = "n"
    finally:
        if busy: typed.start()
    print(a if a in "yna" else "")
    if a == "a" and not always_ask: allow_all = True; return True
    return a == "y"

def run_shell(command):
    if not confirm("run command", command, always_ask=bool(RISKY.search(command))): return "The user declined to run this command."
    try:
        p = subprocess.run(command, shell=True, capture_output=True, text=True, timeout=120)
    except subprocess.TimeoutExpired:
        return "command timed out after 120s"
    return clip(f"exit code {p.returncode}\n{p.stdout}{p.stderr}".strip(), OUT_CHARS)

def read_file(path):
    with open(os.path.expanduser(path), "r", errors="replace") as f:
        return clip(f.read(), PAGE_CHARS)

def write_file(path, content):
    path = os.path.expanduser(path)
    if not confirm(f"write {path}", content, always_ask=bool(SENSITIVE.search(os.path.abspath(path)))): return "The user declined to write this file."
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    with open(path, "w") as f: f.write(content)
    return f"wrote {len(content)} chars to {path}"

