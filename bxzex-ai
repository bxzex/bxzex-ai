def export_chat(arg=""):
    msgs = [m for m in history if m.get("role") in ("user", "assistant")]
    if not msgs: print(f"{DIM}nothing to export yet{R}"); return
    first = next((plain(m["content"]) for m in msgs if m["role"] == "user"), "chat")
    title = " ".join(first.split()[:10])
    path = os.path.expanduser(arg.strip()) if arg.strip() else os.path.join(os.getcwd(), f"bxzex-chat-{datetime.datetime.now():%Y-%m-%d-%H%M}.md")
    if os.path.isdir(path): path = os.path.join(path, f"bxzex-chat-{datetime.datetime.now():%Y-%m-%d-%H%M}.md")
    out = [f"# {title}", f"{AI_NAME} · {datetime.datetime.now():%B %d, %Y at %H:%M}", ""]
    for m in msgs:
        text = plain(m.get("content") or "").strip()
        if m["role"] == "user":
            if text.startswith(("(Screenshots from", "(The result of my scheduled")): continue
            out += [f"**You:** {text}", ""]
        else:
            for call in m.get("tool_calls") or []:
                try: args = json.loads(call["function"].get("arguments") or "{}")
                except ValueError: args = {}
                shown = " ".join(str(v) for k, v in args.items() if k != "content").replace("\n", " ")[:160]
                out.append(f"> {call['function']['name']}: {shown}")
            if m.get("tool_calls"): out.append("")
            if text: out += [f"**{AI_NAME}:** {text}", ""]
    try:
        with open(path, "w") as f: f.write("\n".join(out) + "\n")
    except OSError as e:
        print(f"{DIM}couldn't save it: {e}{R}"); return
    print(f"{GOLD}●{R} {BOLD}Saved{R} {DIM}· {link(file_link(path), path.replace(HOME, '~'))}{R}")

# ---- Safari and Messages on a Mac ----
def osa(script, *args, timeout=30):
    r = subprocess.run(["osascript", *sum((["-e", l] for l in script.strip().splitlines()), []), *args],
                       capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
    if r.returncode != 0: raise RuntimeError(r.stderr.strip()[-400:] or "AppleScript failed")
    return r.stdout.rstrip("\n")

SAFARI_TAB = '''on tabRef(w, t)
  tell application "Safari"
    if w is 0 then return current tab of front window
    return tab t of window w
  end tell
end tabRef'''

SAFARI_OPENED = set()     # pages it opened itself this session: JavaScript in any other tab always asks

def safari(action, url="", script="", tab=""):
    """Safari: list tabs, open a page, read a tab's text, or run JavaScript in a tab."""
    if not MAC: return "error: Safari control only works on a Mac"
    action = str(action).strip().lower()
    w, t = (int(x) for x in str(tab).split(".")) if re.fullmatch(r"\d+\.\d+", str(tab).strip()) else (0, 0)
    try:
        if action == "tabs":
            return osa('''tell application "Safari"
  set out to ""
  repeat with w from 1 to count of windows
    repeat with t from 1 to count of tabs of window w
      set out to out & w & "." & t & "  " & (name of tab t of window w) & "  " & (URL of tab t of window w) & linefeed
    end repeat
  end repeat
  return out
end tell''') or "Safari has no open tabs"
        if action == "open":
            if not str(url).strip(): return "error: give the url to open"
            osa('''on run argv
  tell application "Safari"
    if (count of windows) is 0 then make new document
    tell front window to set current tab to (make new tab with properties {URL:item 1 of argv})
  end tell
end run''', str(url).strip())
            SAFARI_OPENED.add(str(url).strip())
            return f"opened {url} in a new Safari tab"
        if action in ("read", "run"):
            js = "document.title + '\\n' + location.href + '\\n\\n' + document.body.innerText" if action == "read" else str(script)
            if action == "run":
                if not js.strip(): return "error: give the JavaScript to run"
                if PLAN: return plan_block()
                here = osa(SAFARI_TAB + '''
on run argv
  set r to tabRef((item 1 of argv) as integer, (item 2 of argv) as integer)
  tell application "Safari" to return URL of r
end run''', str(w), str(t))
                mine = here in SAFARI_OPENED                  # a tab it opened; any other tab is the user's, maybe signed in
                if not confirm(f"run JavaScript in Safari · {here[:60]}", js, always_ask=not mine): return "The user declined."
            out = osa(SAFARI_TAB + '''
on run argv
  set r to tabRef((item 2 of argv) as integer, (item 3 of argv) as integer)
  tell application "Safari" to return (do JavaScript (item 1 of argv) in r) as text
end run''', js, str(w), str(t), timeout=60)
            return clip(out or "(no result)", PAGE_CHARS)
        return "error: action is tabs, open, read or run"
    except subprocess.TimeoutExpired:
        return "error: Safari took too long to answer"
    except RuntimeError as e:
        if re.search(r"(?i)javascript.*apple ?events|allow javascript", str(e)):
            return ("error: Safari blocks this until it's allowed once. Tell the user: Safari > Settings > Advanced > tick \"Show features for "
                    "web developers\", then the Develop menu > \"Allow JavaScript from Apple Events\".")
        if re.search(r"-1743|not authori[sz]ed|not allowed", str(e)):
            return "error: this terminal isn't allowed to control Safari. Tell the user: System Settings > Privacy & Security > Automation > their terminal app > turn on Safari."
        return f"error: {e}"

MESSAGES_DB = f"{HOME}/Library/Messages/chat.db"

def message_text(text, blob):
    """Newer Messages keeps the words in a binary field: pull the readable text out of it."""
    if text: return text
    if not blob: return ""
    try:
        part = blob.split(b"NSString", 1)[1][5:]
        n, part = (part[0], part[1:]) if part[0] < 0x80 else (int.from_bytes(part[1:3], "little"), part[3:])
        return part[:n].decode("utf-8", "replace")
    except Exception:
        return ""

def imessage(action, to="", text="", limit="10", who=""):
    """Messages: send an iMessage or text, read recent messages, or find someone's number in Contacts."""
    if not MAC: return "error: Messages only works on a Mac"
    action = str(action).strip().lower()
    try:
        if action == "send":
            to, text = str(to).strip(), str(text).strip()
            if not to or not text: return "error: give who to send to (a phone number or email) and the text"
            if PLAN: return plan_block()
            if not confirm(f"send a message to {to}", text, always_ask=True): return "The user declined. Nothing was sent."
            osa('''on run argv
  tell application "Messages"
    try
      set s to 1st account whose service type = iMessage
      send (item 2 of argv) to participant (item 1 of argv) of s
    on error
      set s to 1st account whose service type = SMS
      send (item 2 of argv) to participant (item 1 of argv) of s
    end try
  end tell
end run''', to, text)
            return f"sent to {to}"
        if action == "find":
            name = str(who or to).strip()
            if not name: return "error: give the name to look up"
            return osa('''on run argv
  set out to ""
  tell application "Contacts"
    repeat with p in (people whose name contains (item 1 of argv))
      set out to out & (name of p) & ":"
      repeat with ph in phones of p
        set out to out & " " & (value of ph)
      end repeat
      repeat with em in emails of p
        set out to out & " " & (value of em)
      end repeat
      set out to out & linefeed
    end repeat
  end tell
  return out
end run''', name) or f"nobody named {name} in Contacts"
        if action == "read":
            import sqlite3
            try:
                db = sqlite3.connect(f"file:{MESSAGES_DB}?mode=ro", uri=True)
                rows = db.execute("""select datetime(m.date / 1000000000 + 978307200, 'unixepoch', 'localtime'), m.is_from_me, h.id, m.text, m.attributedBody
                    from message m left join handle h on m.handle_id = h.ROWID
                    where (? = '' or h.id like ?) order by m.date desc limit ?""",
                    (str(who or to).strip(), f"%{str(who or to).strip()}%", max(1, min(int(str(limit) or 10), 50)))).fetchall()
            except (sqlite3.Error, ValueError) as e:
                return ("error: can't read Messages yet. Tell the user: System Settings > Privacy & Security > Full Disk Access > turn on their "
                        f"terminal app, then quit and reopen it. ({e})")
            return "\n".join(f"{when}  {('me → ' + (h or '?')) if mine else (h or '?')}: {message_text(t, b)}"
                             for when, mine, h, t, b in reversed(rows)) or "no messages"
        return "error: action is send, read or find"
    except subprocess.TimeoutExpired:
        return "error: Messages took too long to answer"
    except RuntimeError as e:
        if re.search(r"-1743|not authori[sz]ed|not allowed", str(e)):
            return "error: this terminal isn't allowed to control Messages or Contacts. Tell the user: System Settings > Privacy & Security > Automation > their terminal app > turn on Messages and Contacts."
        return f"error: {e}"

