SYSTEM = ""
def refresh_system():
    """Build the system prompt once per conversation so the server's prompt cache stays valid."""
    global SYSTEM
    if not os.path.exists(GUIDE):
        try:
            os.makedirs(APP_HOME, exist_ok=True)
            with open(GUIDE, "w") as f: f.write(DEFAULT_GUIDE)
        except OSError:
            pass
    parts = [system_prompt(), read_text(GUIDE, 6000) or DEFAULT_GUIDE]
    here = read_text(os.path.join(os.getcwd(), "BXZEX.md"), 3000)
    if here: parts.append("## Notes for this folder\n" + here)
    skills = list_skills()
    if skills:
        parts.append("## Skills\nBefore starting a task that matches one of these, call use_skill with its name "
                     "and follow what it says:\n" + "\n".join(f"- {n}: {' '.join(d.split(':')[0].split()[:9])}" for n, d, _ in skills))   # short hints: every prompt token costs load time
    notes = read_text(MEMORY, 3000)
    if notes: parts.append("## What you remember about the user\n" + notes)
    SYSTEM = "\n\n".join(parts)

def warm_up():
    """Have the server read the system prompt now, in the background, so the first reply isn't
    held up by it. Later requests reuse the cached prefix."""
    def go():
        try:
            body = json.dumps({"messages": [{"role": "system", "content": SYSTEM}, {"role": "user", "content": "hi"}],
                               "tools": TOOLS, "max_tokens": 1,
                               "chat_template_kwargs": {"enable_thinking": False}}).encode()
            req = urllib.request.Request(f"{HOST}/v1/chat/completions", body, {"Content-Type": "application/json"})
            urllib.request.urlopen(req, timeout=600).read()
        except Exception:
            pass
    threading.Thread(target=go, daemon=True).start()

