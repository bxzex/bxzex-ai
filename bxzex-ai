UPDATE_URL = os.environ.get("BXZEX_UPDATE_URL", "https://raw.githubusercontent.com/bxzex/bxzex-ai/main")
END_MARK = "# ---- end of bxzex-ai ----"
update_note = ""      # shown in the status line once a newer version has been put in place
PARTS = 2 if MAC else 3   # which round of installer downloads this version expects (3: the repaired Linux voice engine)
if "parts" in load_config() and int(load_config().get("parts") or 0) < PARTS:
    update_note = "one more step to finish this update: type /update full"

def newer(a, b):
    """True if version a is higher than b."""
    num = lambda v: [int(x) for x in re.findall(r"\d+", v)][:3]
    return num(a) > num(b)

def fetch(path):
    return http_get(f"{UPDATE_URL}/{path}")

def check_update(quiet=True):
    """Look for a newer version and put it in place. The running session keeps the old one until restart.
    Only the app, the server launcher and the skills change here: the big model files are never touched."""
    global update_note
    try:
        latest = fetch("VERSION").split()
        if not latest or not re.fullmatch(r"\d+(\.\d+){1,2}", latest[0]): return False
        if not newer(latest[0], VERSION):
            if not quiet: print(f"{DIM}you have the latest version, v{VERSION}{R}")
            return False
        here = os.path.dirname(os.path.realpath(__file__))
        app = fetch("bxzex-ai")
        compile(app, "bxzex-ai", "exec")                       # never install something that doesn't even parse
        if f'VERSION = "{latest[0]}"' not in app or not app.rstrip().endswith(END_MARK):   # cut off, or the download servers still hold the old copy
            if not quiet: print(f"{DIM}v{latest[0]} is on its way but hasn't reached the download servers yet. Try /update again in a few minutes{R}")
            return False
        server = fetch("bxzex-server")
        names = re.search(r'SKILLS="([^"]*)"', fetch("install.sh"))
        skills = {n: fetch(f"skills/{n}.md") for n in (names.group(1).split() if names else [])}
        if not server.startswith("#!") or any(not v.startswith("---") for v in skills.values()): return False
        os.makedirs(SKILLS_DIR, exist_ok=True)
        for n, text in skills.items():
            with open(os.path.join(SKILLS_DIR, f"{n}.md"), "w") as f: f.write(text)
        for name, text in (("bxzex-server", server), ("bxzex-ai", app)):
            tmp = os.path.join(here, f".{name}.new")
            with open(tmp, "w") as f: f.write(text)
            os.chmod(tmp, 0o755); os.replace(tmp, os.path.join(here, name))
        update_note = f"updated to v{latest[0]} · quit and reopen to use it"
        if len(latest) > 1 and latest[1].isdigit() and int(latest[1]) > int(load_config().get("parts", 0) or 0):
            update_note += " · new features to download: /update full"
        if not quiet: print(f"{GOLD}●{R} {BOLD}Updated to v{latest[0]}{R} {DIM}· quit and open bxzex-ai again to use it{R}")
        return True
    except Exception:
        if not quiet: print(f"{DIM}couldn't check for updates right now{R}")
        return False

def full_update():
    """Run the installer again: it skips what is already there and adds anything new."""
    box.unpin()
    script = tempfile.NamedTemporaryFile(suffix=".sh", delete=False).name
    try:
        with open(script, "w") as f: f.write(fetch("install.sh"))
        subprocess.run(["bash", script])
    finally:
        os.unlink(script)
    print(f"{DIM}quit and open bxzex-ai again to use the new version{R}")

# ---- chat history ----
CHATS = f"{APP_HOME}/chats"     # one .json per conversation, saved after every turn and every 30 seconds
chat_file = None

def plain(content):
    """Message text without embedded image data, so saved chats stay small."""
    if isinstance(content, str): return content
    return " ".join(p.get("text", "") if p.get("type") == "text" else "[image]" for p in content).strip()

def save_chat():
    global chat_file
    if not history: return
    try:
        os.makedirs(CHATS, exist_ok=True)
        if not chat_file: chat_file = f"{CHATS}/{time.strftime('%Y-%m-%d_%H-%M-%S')}.json"
        msgs = [dict(m, content=plain(m.get("content") or "")) for m in history]
        title = next((m["content"] for m in msgs if m["role"] == "user"), "")[:80]
        with open(chat_file, "w") as f: json.dump({"title": title, "messages": msgs}, f)
    except OSError:
        pass

def autosave():
    """Saves the conversation every 30 seconds, so a closed window or a crash loses nothing."""
    while True:
        time.sleep(30); save_chat()

def list_chats():
    try: files = sorted((f for f in os.listdir(CHATS) if f.endswith(".json")), reverse=True)
    except OSError: return []
    out = []
    for f in files[:20]:
        try:
            with open(os.path.join(CHATS, f)) as fh: d = json.load(fh)
        except Exception:
            continue
        out.append((os.path.join(CHATS, f), f[:16].replace("_", " ").replace("-", ":", 3).replace(":", "-", 2), d.get("title", ""), d.get("messages", [])))
    return out

def open_chat(pick=None):
    """Continue an earlier conversation. pick=0 takes the most recent without asking."""
    global history, chat_file
    chats = [c for c in list_chats() if c[0] != chat_file]
    if not chats:
        if pick is None: print(f"{DIM}no earlier chats yet{R}")
        return
    if pick is None:
        print(header("History"))
        for i, (_, when, title, msgs) in enumerate(chats, 1):
            print(f"  {GOLD}{i:>2}{R}  {DIM}{when}{R}  {title[:W() - 34]}  {DIM}{len(msgs)} msgs{R}")
        try: a = input(f"\n  {GOLD}❯{R} number to continue, Enter to cancel ").strip()
        except (EOFError, KeyboardInterrupt): print(); return
        if not (a.isdigit() and 1 <= int(a) <= len(chats)): return
        pick = int(a) - 1
    path, when, title, msgs = chats[pick]
    history = msgs; chat_file = path
    try: saved = time.strftime("%b %d at %-I:%M %p", time.localtime(os.path.getmtime(path)))
    except OSError: saved = when
    print(f"{GOLD}●{R} {BOLD}Continuing from last save{R} {DIM}{saved} · {len(msgs)} messages{R}")
    for m in [m for m in msgs if m["role"] in ("user", "assistant") and m.get("content")][-2:]:
        mark = f"{GOLD}❯{R}" if m["role"] == "user" else f"{GOLD}●{R}"
        text = " ".join(m["content"].split())
        print(f"{mark} {DIM}{text[:W() * 2 - 8]}{'…' if len(text) > W() * 2 - 8 else ''}{R}")
    print(f"{DIM}it has to re-read the conversation, so the next reply starts slower{R}")

