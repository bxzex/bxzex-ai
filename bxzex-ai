def logo_rows():
    """The logo keeps its white and grey; its blue becomes the theme color."""
    fg = {15: 231, 7: 248, 8: 240, 1: T[2]}
    bg = {1: T[2], 7: 248}
    out = []
    for chars, attrs in LOGO:
        row = []; last = None
        for i, ch in enumerate(chars):
            a = int(attrs[2*i:2*i+2], 16)
            code = f"\033[0;38;5;{fg.get(a & 15, 231)}" + (f";48;5;{bg[a >> 4]}m" if (a >> 4) in bg else "m")
            if code != last: row.append(code); last = code
            row.append(ch)
        out.append("".join(row) + R)
    return out

