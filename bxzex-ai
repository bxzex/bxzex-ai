def read_text(path, limit):
    try:
        with open(os.path.expanduser(path), "r", errors="replace") as f: text = f.read().strip()
    except OSError:
        return ""
    return text[-limit:] if len(text) > limit else text

def remember(note):
    os.makedirs(APP_HOME, exist_ok=True)
    with open(MEMORY, "a") as f: f.write(f"- {' '.join(note.split())}\n")
    return "saved"

