class Box:
    """Keeps the input box on the last four rows. Everything else scrolls in the area above it,
    so the box stays put while a reply streams."""
    ROWS = 4
    def __init__(self): self.on = False; self.h = 0; self.size = None
    def pin(self):
        if self.on or not (RAW.isatty() and sys.stdin.isatty()): return
        size = shutil.get_terminal_size((90, 30)); self.h = size.lines
        if self.h < 12: return
        # make room, then limit scrolling to the rows above the box (setting the region moves the cursor, so save it)
        RAW.write("\n" * self.ROWS + f"\033[{self.ROWS}A\0337\033[1;{self.h - self.ROWS}r\0338")
        self.on = True; self.size = (size.columns, size.lines); self.draw()
    def fit(self):
        """If the window changed size, wipe the screen and print the conversation again for the new size.
        Guessing where things moved to is not reliable, redrawing is."""
        size = shutil.get_terminal_size((90, 30))
        if (size.columns, size.lines) == self.size or size.lines < 12: return False
        self.size = (size.columns, size.lines); self.h = size.lines
        lock = getattr(sys.stdout, "lock", None)
        if lock: lock.acquire()
        try:
            past_output = sys.stdout.replay() if hasattr(sys.stdout, "replay") else ""
            RAW.write(f"\033[r\033[H\033[2J\033[3J\033[1;{self.h - self.ROWS}r\033[H{past_output}\0337"); RAW.flush()
        finally:
            if lock: lock.release()
        return True
    def frame(self, text, pos, working):
        w = W(); top = self.h - self.ROWS + 1; room = max(4, w - 3)
        start = max(0, pos - room)
        st = status_text(text, working)[:w]
        rule = f"{DIM}{'─' * w}{R}"
        s = (f"\033[{top};1H\033[J{rule}\033[{top + 1};1H{GOLD}❯{R} {text[start:start + room].replace(chr(10), f'{DIM}↵{R}')}"
             f"\033[{top + 2};1H{rule}\033[{top + 3};1H{DIM}{st}{R}")
        return s, 3 + pos - start
    def draw(self, text="", pos=0, working=True):
        """Redraw while output is streaming: the cursor goes back to where the output was."""
        if not self.on: return
        self.fit()
        s, _ = self.frame(text, pos, working)
        RAW.write("\0337" + s + "\0338"); RAW.flush()
    def focus(self, text, pos):
        """Redraw at the prompt: the cursor stays in the box."""
        self.fit()
        s, col = self.frame(text, pos, False)
        RAW.write(f"{s}\033[{self.h - self.ROWS + 2};{col}H"); RAW.flush()
    def unpin(self):
        if not self.on: return
        self.on = False
        RAW.write(f"\0337\033[r\033[{self.h - self.ROWS + 1};1H\033[J\0338\033[?25h"); RAW.flush()

box = Box()
atexit.register(box.unpin)

def ask(prefill=""):
    """Read a message in the pinned box. Typing, arrows, history and paste are handled here,
    and the box follows the window when it is resized."""
    global resized
    if not sys.stdin.isatty():
        line = sys.stdin.readline()
        if not line: raise EOFError
        return line.strip()
    box.pin()
    if not box.on:                       # window too small for the box: plain prompt
        return line_input(f"\n{GOLD}❯{R} ").strip()
    box.fit()                            # the window may have been resized while it was busy
    fd = sys.stdin.fileno(); saved = termios.tcgetattr(fd)
    global FIND_NOTE
    buf = list(prefill); pos = len(buf); at = len(past); draft = ""; pasting = False
    find = None; found = -1; before_find = []
    last_esc = 0.0; last_key = time.time()
    dec = codecs.getincrementaldecoder("utf-8")("ignore")
    print()
    tty.setcbreak(fd, termios.TCSANOW)
    RAW.write("\0337\033[?2004h\033[?25h")   # remember where the conversation left off; bracketed paste on

    def leave():
        global FIND_NOTE
        FIND_NOTE = ""
        RAW.write("\033[?2004l\0338"); RAW.flush()      # back to where the conversation left off
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        box.draw("", 0, working=True)

    try:
        box.focus("", 0) if not buf else box.focus("".join(buf), pos)
        while True:
            try:
                if reload_ready: raise Reload("".join(buf))
                if not buf: learn_if_idle(time.time() - last_key)
                ready, _, _ = select.select([fd], [], [], 0.15)
            except InterruptedError:
                ready = []
            except KeyboardInterrupt:
                if find is not None: find = None; FIND_NOTE = ""; buf = before_find; pos = len(buf); box.focus("".join(buf), pos); continue
                if buf: buf = []; pos = 0; box.focus("", 0); continue    # first ctrl-c clears the line
                raise
            if resized: resized = False; box.focus("".join(buf), pos)
            if not ready: continue
            if not buf: wake_soon()                       # they started typing: get a sleeping cloud card going now
            last_key = time.time()
            data = dec.decode(os.read(fd, 4096))
            if ESC_PART.search(data): data = finish_escapes(fd, data)     # a key code cut in two must not read as Esc, which clears the line
            i = 0; done = False
            while i < len(data):
                ch = data[i]
                if find is not None:                    # searching: letters narrow it, ctrl-r goes further back, enter takes it
                    if ch == "\x12":
                        j = find_past(find, found - 1) if found > 0 else -1
                        if j >= 0: found = j
                        i += 1
                    elif ch in "\x7f\b": find = find[:-1]; found = find_past(find, len(past) - 1) if find else -1; i += 1
                    elif ch == "\x1b" and not ESC_KEY.match(data[i:]) or ch == "\x07":
                        find = None; buf = before_find; pos = len(buf); i += 1; FIND_NOTE = ""; continue
                    elif ch in "\r\n": find = None; FIND_NOTE = ""; pos = len(buf); i += 1; continue
                    elif ch >= " ": find += ch; found = find_past(find, len(past) - 1); i += 1
                    else: find = None; FIND_NOTE = ""; pos = len(buf); continue     # any other key: keep the match and carry on editing
                    buf = list(past[found]) if found >= 0 and find else []; pos = len(buf)
                    FIND_NOTE = (f"  search past messages: {find}▏" + (" · no match" if find and found < 0 else "")
                                 + " · ctrl-r older · enter to use · esc to cancel")
                    continue
                if ch == "\x12":                                              # ctrl-r: search what you sent before
                    find = ""; found = -1; before_find = buf[:]; buf = []; pos = 0; i += 1
                    FIND_NOTE = "  search past messages: ▏ · type to search · ctrl-r older · enter to use · esc to cancel"
                    continue
                if ch == "\x1b":
                    rest = data[i:]
                    if rest.startswith("\x1b[200~"): pasting = True; i += 6; continue
                    if rest.startswith("\x1b[201~"): pasting = False; i += 6; continue
                    m = ESC_KEY.match(rest)
                    if not m:                          # a lone Esc clears the line; twice on an empty line goes back (rewind)
                        if len(rest) == 1:
                            if not buf and time.time() - last_esc < 0.8: buf = list("/rewind"); done = True; break
                            buf = []; pos = 0; last_esc = time.time()
                        i += 1; continue
                    key = m.group(0); i += len(key)
                    if key in ("\x1bb", "\x1b[1;3D", "\x1b[1;5D", "\x1b[1;9D"):      # a word left
                        while pos and buf[pos - 1] == " ": pos -= 1
                        while pos and buf[pos - 1] != " ": pos -= 1
                    elif key in ("\x1bf", "\x1b[1;3C", "\x1b[1;5C", "\x1b[1;9C"):    # a word right
                        while pos < len(buf) and buf[pos] == " ": pos += 1
                        while pos < len(buf) and buf[pos] != " ": pos += 1
                    elif key == "\x1b\x7f":                                            # option-delete: the word before
                        j = pos
                        while j and buf[j - 1] == " ": j -= 1
                        while j and buf[j - 1] != " ": j -= 1
                        del buf[j:pos]; pos = j
                    elif key in ("\x1b[D", "\x1bOD"): pos = max(0, pos - 1)
                    elif key in ("\x1b[C", "\x1bOC"): pos = min(len(buf), pos + 1)
                    elif key in ("\x1b[H", "\x1bOH", "\x1b[1~"): pos = 0
                    elif key in ("\x1b[F", "\x1bOF", "\x1b[4~"): pos = len(buf)
                    elif key == "\x1b[3~": del buf[pos:pos + 1]
                    elif key == "\x1b[Z": toggle_plan(quiet=True)          # shift-tab: plan mode on or off
                    elif key in ("\x1b[A", "\x1bOA") and at > 0:
                        if at == len(past): draft = "".join(buf)
                        at -= 1; buf = list(past[at]); pos = len(buf)
                    elif key in ("\x1b[B", "\x1bOB") and at < len(past):
                        at += 1; buf = list(past[at] if at < len(past) else draft); pos = len(buf)
                    continue
                i += 1
                if ch in "\r\n":
                    if pasting:
                        if ch == "\r" and data[i:i + 1] == "\n": i += 1    # one break for \r\n
                        buf.insert(pos, "\n"); pos += 1
                    else: done = True; break
                elif ch in "\x7f\b":
                    if pos: del buf[pos - 1]; pos -= 1
                elif ch == "\x04":
                    if not buf: raise EOFError
                elif ch == "\x0f": buf = list("/last"); done = True; break       # ctrl-o: the full output of the last tools
                elif ch == "\x16":                                             # ctrl-v: paste a screenshot from the clipboard
                    shot = clipboard_image()
                    if shot:
                        add = (shlex.quote(shot) if " " in shot else shot) + " "
                        buf[pos:pos] = list(add); pos += len(add)
                elif ch == "\x01": pos = 0
                elif ch == "\x05": pos = len(buf)
                elif ch == "\x15": del buf[:pos]; pos = 0
                elif ch == "\x0b": del buf[pos:]
                elif ch == "\x17":
                    j = pos
                    while j and buf[j - 1] == " ": j -= 1
                    while j and buf[j - 1] != " ": j -= 1
                    del buf[j:pos]; pos = j
                elif ch == "\t":
                    word = "".join(buf)
                    hits = [n for n in [n for n, _ in COMMANDS] + list(custom_commands()) if n.startswith("/") and n.startswith(word)] if word.startswith("/") and " " not in word else []
                    if hits:
                        common = os.path.commonprefix(hits)
                        buf = list(common + (" " if len(hits) == 1 else "")); pos = len(buf)
                    else: buf.insert(pos, "\t" if pasting else " "); pos += 1
                elif ch >= " ": buf.insert(pos, ch); pos += 1
            if done: break
            box.focus("".join(buf), pos)
    except BaseException:
        leave(); raise
    leave()
    text = "".join(buf).strip()
    if text:
        if (not past or past[-1] != text) and text not in ("exit", "quit"):
            past.append(text)
            try:
                with open(PAST_FILE, "a") as f: f.write(json.dumps(text) + "\n")
            except OSError: pass
        print(f"{GOLD}❯{R} {BOLD}" + text.replace("\n", f"{R}\n  {BOLD}") + R)
    return text

