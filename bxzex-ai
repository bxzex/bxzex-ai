def clipboard_image():
    """Save the picture on the clipboard (a screenshot) to a file and return its path, or "" when there isn't one."""
    os.makedirs(f"{APP_HOME}/pasted", exist_ok=True)
    out = f"{APP_HOME}/pasted/{time.strftime('%Y-%m-%d_%H-%M-%S')}.png"
    try:
        if MAC:
            script = (f'set f to (open for access POSIX file "{out}" with write permission)\n'
                      'try\nwrite (the clipboard as «class PNGf») to f\nend try\nclose access f')
            subprocess.run(["osascript", "-e", script], capture_output=True, timeout=5)
        elif shutil.which("wl-paste"):
            with open(out, "wb") as f: subprocess.run(["wl-paste", "--type", "image/png"], stdout=f, stderr=subprocess.DEVNULL, timeout=5)
        elif shutil.which("xclip"):
            with open(out, "wb") as f: subprocess.run(["xclip", "-selection", "clipboard", "-t", "image/png", "-o"], stdout=f, stderr=subprocess.DEVNULL, timeout=5)
        if os.path.exists(out) and os.path.getsize(out) > 100: return out
    except Exception: pass
    try: os.remove(out)
    except OSError: pass
    return ""

