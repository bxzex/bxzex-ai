def car(el, n=24, speed=12):
    """One-line DeLorean driving back and forth on a road, leaving a trail."""
    period = 2 * (n - 1)
    step = int(el * speed) % period
    right = step < n
    p = step if right else period - step
    cells = ["─"] * n
    col = {}
    def put(i, ch, color):
        if 0 <= i < n: cells[i] = ch; col[i] = color
    if right:
        put(p-3, "∴", T[2]); put(p-2, "≈", T[3]); put(p-1, "▟", T[4])
        put(p,   "█", T[4]); put(p+1, "►", HI)
    else:
        put(p-1, "◄", HI); put(p, "█", T[4]); put(p+1, "▙", T[4])
        put(p+2, "≈", T[3]); put(p+3, "∴", T[2])
    return "".join(f"{c(col.get(i, T[1]))}{ch}" for i, ch in enumerate(cells)) + R

